// V2-04 harness: ABI entry for PanopticVegaLensLib's readouts.
//
// signature:: dqvFunded(uint256,uint256,uint256) -> uint256
//   cast sig "dqvFunded(uint256,uint256,uint256)" -> 0x56ac49ba
// signature:: impliedMaturity(uint256,uint256) -> uint256
//   cast sig "impliedMaturity(uint256,uint256)" -> 0x85f60fb6
// signature:: impliedMaturityMult(uint256,uint256,uint256,uint256) -> uint256
//   cast sig "impliedMaturityMult(uint256,uint256,uint256,uint256)" -> 0x0a49058f

import std::constructor::return_runtime;
import lib::exposure::PanopticVegaLensLib::*;
import v3::util::{return_u256, revert_empty};

const SELECTOR_DQV_FUNDED             = 0x56ac49ba;
const SELECTOR_IMPLIED_MATURITY       = 0x85f60fb6;
const SELECTOR_IMPLIED_MATURITY_MULT  = 0x0a49058f;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    if selector == SELECTOR_DQV_FUNDED {
        return_u256(dqv_funded(@evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68)));
    }
    if selector == SELECTOR_IMPLIED_MATURITY {
        return_u256(implied_maturity(@evm_calldataload(4), @evm_calldataload(36)));
    }
    if selector == SELECTOR_IMPLIED_MATURITY_MULT {
        return_u256(implied_maturity_mult(
            @evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68), @evm_calldataload(100)
        ));
    }

    revert_empty();
}
