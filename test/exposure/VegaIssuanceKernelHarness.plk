// VegaIssuanceKernelHarness: makes the PURE issuance lib reachable over the ABI, so Phase 13
// can diff it against IssuanceRefMock.sol BEFORE any module/storage exists. Plank does NOT
// type-check code unreachable from run{}, so without this entrypoint the lib is unprovable.
// Whole-word calldata read AS LOADED (the values are u256 Q-fixed-point, no sign games).
//
// signature:: haircutRiskPrice(uint256,uint256) -> uint256   (returns p_risk = RiskPriceX96.val)
//   Verified with: cast sig "haircutRiskPrice(uint256,uint256)" -> 0x00213e88
// signature:: issueShares(uint256,uint256) -> uint256         (returns shares)
//   Verified with: cast sig "issueShares(uint256,uint256)" -> 0x636ae14a

import std::constructor::return_runtime;
import lib::exposure::VegaIssuanceLib::*;
import types::exposure::VegaExposure::{RiskPriceX96, Haircut};
import v3::util::{return_u256};

const SELECTOR_HAIRCUT_RISK_PRICE = 0x00213e88;
const SELECTOR_ISSUE_SHARES       = 0x636ae14a;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    if selector == SELECTOR_HAIRCUT_RISK_PRICE {
        // calldata: (oracleX96 @4, hX96 @36)
        let oracleX96 = @evm_calldataload(4);
        let h = Haircut { val: @evm_calldataload(36) };
        let p = haircut_risk_price(oracleX96, h);
        return_u256(p.val);
    }
    if selector == SELECTOR_ISSUE_SHARES {
        // calldata: (deposit @4, pRiskX96 @36)
        let deposit = @evm_calldataload(4);
        let pRisk = RiskPriceX96 { val: @evm_calldataload(36) };
        let shares = issue_shares(deposit, pRisk);
        return_u256(shares);
    }
    @evm_stop();
}
