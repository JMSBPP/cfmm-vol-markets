import std::constructor::return_runtime;
import std::option::is_some;
import types::WeinerGenerator::{WeinerCmd, io, run_weiner, val, DeltaW};

/// Public harness for WeinerGeneratorRunWeiner.btt (#145).
/// cast sig "runWeiner(uint256)" -> 0x8a969a0d
const SEL_RUN_WEINER = 0x8a969a0d;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    if selector == SEL_RUN_WEINER {
        let j = @evm_calldataload(4);
        let o = run_weiner(2, io(WeinerCmd { j: j }));
        let out = @malloc_uninit(64);
        @mstore32(out, @bool_to_u256(is_some(DeltaW(2), o)));
        if o.is_some {
            @mstore32(out +% 32, val(2, o.inner));
        } else {
            @mstore32(out +% 32, 0);
        }
        @evm_return(out, 64);
    }
    @evm_stop();
}
