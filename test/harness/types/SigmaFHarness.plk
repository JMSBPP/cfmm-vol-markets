import std::constructor::return_runtime;
import cfmm_types::Ray::{intro as ray_intro, rayVal};
import types::SigmaF::intro;

/// types.toml: SigmaF · BTT: .spec/REALIZED_VOLATILITY.spec/types/SigmaF/SigmaFIntro.btt
/// intro(uint256) — Ray word in; rayVal(SigmaF.r) out. #151 define/intro
const SEL_INTRO = 0xd2a9aa11;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    if selector == SEL_INTRO {
        let r = ray_intro(@evm_calldataload(4));
        let sf = intro(r);
        let out = @malloc_uninit(32);
        @mstore32(out, rayVal(sf.r));
        @evm_return(out, 32);
    }
    @evm_stop();
}
