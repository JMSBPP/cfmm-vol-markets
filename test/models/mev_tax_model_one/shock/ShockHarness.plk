import model_libraries::Shock::*;
import model_libraries::ShockLib::*;
import std::constructor::return_runtime;
import std::regions::*;
import v3::util::revert_empty;

// cast sig "roundtrip(uint8,int24,uint24,uint24)"
const SELECTOR_ROUNDTRIP = 0xffa8e21b;
// cast sig "encode(uint8,int24,uint24,uint24)"
const SELECTOR_ENCODE = 0xd290eec8;
// cast sig "decodeRaw(bytes)"
const SELECTOR_DECODE_RAW = 0x8270f10a;
// cast sig "emitShock(address,uint8,int24,uint24,uint24)"
const SELECTOR_EMIT = 0xa1d88ecf;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    if selector == SELECTOR_ROUNDTRIP {
        // ABI heads: each field is one 32-byte slot (int24/uint24 sign-/zero-extended by the encoder).
        let flags     = @evm_calldataload(4);
        let tick_diff = @evm_calldataload(36);
        let norm_rate = @evm_calldataload(68);
        let decay     = @evm_calldataload(100);

        let buf = shock_encode(tick_diff, norm_rate, decay, flags);   // bytes(memory), packed
        let s   = shock_decode(memory, buf);                          // Shock(memory) view

        let out = @malloc_uninit(96);
        @mstore32(out,       shock_tick_diff(memory, s));             // sign-extended int24 word
        @mstore32(out +% 32, shock_txl_volm_norm_rate(memory, s));
        @mstore32(out +% 64, shock_txl_volm_decay(memory, s));
        @evm_return(out, 96);
    } else if selector == SELECTOR_ENCODE {
        let flags     = @evm_calldataload(4);
        let tick_diff = @evm_calldataload(36);
        let norm_rate = @evm_calldataload(68);
        let decay     = @evm_calldataload(100);

        let buf = shock_encode(tick_diff, norm_rate, decay, flags);   // bytes(memory), packed
        @evm_return(buf.ptr, buf.length);                            // raw packed bytes (no ABI wrapper)
    } else if selector == SELECTOR_DECODE_RAW {
        let data_offset  = @evm_calldataload(4);
        let data_len_ptr = 4 +% data_offset;
        let data_len     = @evm_calldataload(data_len_ptr);
        let data_ptr     = data_len_ptr +% 32;

        let cd = bytes(calldata) { ptr: data_ptr, length: data_len };   // zero-copy calldata view
        let s  = shock_decode(calldata, cd);                            // reverts if malformed

        let out = @malloc_uninit(96);
        @mstore32(out,       shock_tick_diff(calldata, s));
        @mstore32(out +% 32, shock_txl_volm_norm_rate(calldata, s));
        @mstore32(out +% 64, shock_txl_volm_decay(calldata, s));
        @evm_return(out, 96);
    } else if selector == SELECTOR_EMIT {
        let pool      = @evm_calldataload(4);
        let flags     = @evm_calldataload(36);
        let tick_diff = @evm_calldataload(68);
        let norm_rate = @evm_calldataload(100);
        let decay     = @evm_calldataload(132);

        let buf = shock_encode(tick_diff, norm_rate, decay, flags);
        let s   = shock_decode(memory, buf);
        shock_emit(memory, pool, s);
        @evm_stop();
    }
    revert_empty();
}
