// TEST-ONLY Plank helper lib. Its whole job is to emit the univ4 Swap event so the reactive
// MarketStateSocket has a price-update to react to -- it "moves the price" with NO real swap and
// NO liquidity. PriceSetterHook.write_price imports this in tests. NOT for production.

const SWAP_TOPIC0 = 0x40e9cecb9f5f1f1c5b9c97dec2917b7ee92e57ba5563708daca94dd84ad7112f;

// Emit Swap(bytes32 indexed id, address indexed sender, int128 amount0, int128 amount1,
//           uint160 sqrtPriceX96, uint128 liquidity, int24 tick, uint24 fee).
// Indexed: id (topic1), sender (topic2). Non-indexed data (6 words): the socket reads
// sqrtPriceX96 at data offset 64 and tick at data offset 128.
const emit_price_update_swap = fn(pool_id: u256, sqrt_price: u256, tick: u256) void {
    let d = @malloc_uninit(192);
    @mstore32(d,        1);                      // amount0 (nonzero; unused by the socket)
    @mstore32(d +% 32,  0);                      // amount1
    @mstore32(d +% 64,  sqrt_price);             // sqrtPriceX96
    @mstore32(d +% 96,  1000000000000000000);    // liquidity (1e18)
    @mstore32(d +% 128, tick);                   // tick
    @mstore32(d +% 160, 3000);                   // fee
    @evm_log3(d, 192, SWAP_TOPIC0, pool_id, @evm_caller());
};
