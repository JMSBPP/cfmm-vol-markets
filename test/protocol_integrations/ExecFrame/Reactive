contract SocketCfgHelper is PlankTestBase {
    struct SocketCfg {
	uint256 originChainId;
	uint256 poolManagerWord;
	uint256 swapTopic; // to be renamed
	bytes32 marketId;
	uint256 sys; // to be remamed
        uint256 windowLen;
	uint256 service;
    }

    function socketCode(SocketCfg memory socketCfg) internal returns (bytes memory res){
	res = abi.encodePacked(compilePlank("src/ExecFrame/ExecFrame.plk"), socketCfg.originChainId, socketCfg.poolManagerWord, socketCfg.swapTopic, socketCfg.marketId, socketCfg.sys, socketCfg.windowLen, socketCfg.service);
	console2.logBytes(res);
    }	

 function defaultSocketCfgFromCtx (Context memory ctx) internal returns(SocketCfg memory socketCfg) {
	socketCfg = SocketCfg(DEFAULT_ORIGIN_CHAIN_ID, uint256(uint160(ctx.poolManager)), SWAP_TOPIC,PoolId.unwrap(PoolIdLibrary.toId(ctx.marketKey)),uint256(uint160(ctx.controlContext.sys)),ctx.args.windowLen, uint256(uint160(SYSTEM)));
    }

    function chainIdParametrizedSocketCfgFromAllCtx(Context memory ctx, uint256 _chainId) internal returns(SocketCfg memory socketCfg) {
	socketCfg = SocketCfg(_chainId, uint256(uint160(ctx.poolManager)), SWAP_TOPIC,PoolId.unwrap(PoolIdLibrary.toId(ctx.marketKey)),uint256(uint160(ctx.controlContext.sys)),ctx.args.windowLen, uint256(uint160(SYSTEM)));
    }

    function serviceContractParametrizedSocketCfgFromCtx(Context memory ctx, address service) internal returns(SocketCfg memory socketCfg) {
	socketCfg = SocketCfg(DEFAULT_ORIGIN_CHAIN_ID, uint256(uint160(ctx.poolManager)), SWAP_TOPIC,PoolId.unwrap(PoolIdLibrary.toId(ctx.marketKey)),uint256(uint160(ctx.controlContext.sys)),ctx.args.windowLen, uint256(uint160(service)));

    }

}


function lastWordOnRuntimeBytecode (address src) returns(uint256) {
    assembly {
	let freePtr := mload(0x40)
	extcodecopy(src,freePtr, sub(extcodesize(src),32), 32)
	return(freePtr,32)    
    }
}

