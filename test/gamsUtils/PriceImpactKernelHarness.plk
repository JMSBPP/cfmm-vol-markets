import std::constructor::return_runtime;
import v3::math::sqrt_price_math::getNextSqrtPriceFromAmount0RoundingUp;
import v3::util::return_u256;

///          P_{1/2}(Δ^I) = (L̄ · P_{1/2}(i)) / (L̄ + Δ^I · P_{1/2}(i))
/// @dev keccak256("getNextSqrtPriceFromAmount0RoundingUp(uint160,uint128,uint256,bool)")[0..4]
const GET_NEXT_SQRT_PRICE_FROM_AMOUNT0_ROUNDING_UP_SELECTOR = 0x157f652f;

init {
    return_runtime();
}

run {
    let selector = @evm_calldataload(0) >> 224;
    if selector == GET_NEXT_SQRT_PRICE_FROM_AMOUNT0_ROUNDING_UP_SELECTOR {
        let sqrtPX96 = @evm_calldataload(4);
        let liquidity = @evm_calldataload(36);
        let amount = @evm_calldataload(68);
        let add = @evm_calldataload(100) > 0;
        return_u256(getNextSqrtPriceFromAmount0RoundingUp(sqrtPX96, liquidity, amount, add));
    } else {
        @evm_revert(@malloc_uninit(0), 0);
    }
}
