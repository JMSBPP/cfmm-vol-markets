import std::constructor::return_runtime;
import v3::math::tick_math::getSqrtRatioAtTick;
import v3::util::return_u256;

/// @title PriceKernelHarness
/// @notice Minimal reader harness exposing Uniswap V3 `getSqrtRatioAtTick` as a single
///         external entrypoint, so the GAMS pricing kernel can diff its tick -> sqrtPriceX96
///         mapping against the on-chain reference implementation.
/// @dev Pure reader: no constructor state, nothing to persist. ABI surface is exactly
///      `getSqrtRatioAtTick(int24) returns (uint256)`.
///
///      An ABI-encoded `int24` argument is sign-extended to a full 32-byte word, which is
///      precisely the two's-complement `u256` that `tick_math::getSqrtRatioAtTick` expects
///      (it uses `@evm_slt` / `-tick` for the |tick| branch). The raw calldata word is
///      therefore forwarded unchanged. Out-of-range ticks revert inside the callee
///      (`tick_math::revert_R`), which is the desired strict behaviour for a diff harness.

/// @dev keccak256("getSqrtRatioAtTick(int24)")[0..4]
const GET_SQRT_RATIO_AT_TICK_SELECTOR = 0x986cfba3;

init {
    return_runtime();
}

run {
    let selector = @evm_calldataload(0) >> 224;
    if selector == GET_SQRT_RATIO_AT_TICK_SELECTOR {
        let tick = @evm_calldataload(4);
        return_u256(getSqrtRatioAtTick(tick));
    } else {
        @evm_revert(@malloc_uninit(0), 0);
    }
}
