import std::constructor::return_runtime;
import std::regions::calldata;
import std::option::{Option, Some, None, is_none, unwrap};
import types::utils::Extra::*;
import pos_spec::VolOrder::*;
import lib::protocol_integrations::panoptic_v2::VolPositionId::vol_order_to_panoptic_token_id;
import types::protocol_integrations::panoptic_v2::PanopticPoolId::*;

// Harness for the VolOrder(T) TYPE and the Extra(T) DESCRIPTOR (Phase 2, VORD-01), written to
// 02-REGRESSION-ASSESSMENT.md §4a as corrected at the 02-04 chunk review. RED-first.
//
// Extra is a descriptor -- flags | offset | len -- saying WHERE the operands live. It carries no
// tokenId: the builder still returns a PanopticTokenId. Phase 2 exercises the no-payload path only.

// cast sig "roundTripNone(uint256)"                -> 0x5784c808
const SEL_ROUND_TRIP = 0x5784c808;
// cast sig "extraIsNoneAfterUnpack(uint256)"       -> 0xd60b13a1
const SEL_EXTRA_IS_NONE = 0xd60b13a1;
// cast sig "tokenIdWithNoneExtra(uint256,uint256)" -> 0xb60dae51
const SEL_TOKEN_ID_NONE_EXTRA = 0xb60dae51;
// cast sig "extraDecodeFields(uint256)"            -> 0x7a2fafcb
const SEL_EXTRA_DECODE_FIELDS = 0x7a2fafcb;
// cast sig "extraEncodeRoundTrip(uint256)"         -> 0x031e3809
const SEL_EXTRA_ENCODE_ROUND_TRIP = 0x031e3809;
// cast sig "packIgnoresExtra(uint256,uint256)"     -> 0xfc9384ff
const SEL_PACK_IGNORES_EXTRA = 0xfc9384ff;
// cast sig "unwrapNoneReverts(uint256)"            -> 0xc0e8737e
const SEL_UNWRAP_NONE_REVERTS = 0xc0e8737e;
// Phase 2.5 (VORD-07): the 40-bit FLAG_PANOPTIC payload.
// cast sig "payloadOptionRatio(uint256,uint256)"   -> 0x2f731a5b
const SEL_PAYLOAD_OPTION_RATIO = 0x2f731a5b;
// cast sig "payloadTokenType(uint256,uint256)"     -> 0x6c16f796
const SEL_PAYLOAD_TOKEN_TYPE = 0x6c16f796;
// cast sig "payloadVegoid(uint256)"                -> 0xe1a7fc3d
const SEL_PAYLOAD_VEGOID = 0xe1a7fc3d;
// cast sig "payloadValidate(uint256)"              -> 0x52525605
const SEL_PAYLOAD_VALIDATE = 0x52525605;
// cast sig "payloadRequireVegoidAgrees(uint256,uint256)" -> 0x365f4b6e
const SEL_PAYLOAD_REQUIRE_VEGOID_AGREES = 0x365f4b6e;

init { return_runtime(); }

const return_1 = fn (a: u256) never {
    let out = @malloc_uninit(32);
    @mstore32(out, a);
    @evm_return(out, 32);
};

const return_3 = fn (a: u256, b: u256, c: u256) never {
    let out = @malloc_uninit(96);
    @mstore32(out, a); @mstore32(out +% 32, b); @mstore32(out +% 64, c);
    @evm_return(out, 96);
};

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // roundTripNone(packed) -- the codec is untouched by the Option-valued `extra`: pack(unpack(x))
    // is still the identity on the 248-bit word.
    if selector == SEL_ROUND_TRIP {
        return_1(pack_vol_order(unpack_vol_order(@evm_calldataload(4))));
    }

    // extraIsNoneAfterUnpack(packed) -> 1 if the unpacked order's `extra` is None. The minimal
    // instantiation is a VALUE (None), not a distinct type.
    if selector == SEL_EXTRA_IS_NONE {
        let vo = unpack_vol_order(@evm_calldataload(4));
        return_1(if is_none(Extra(calldata), vo.extra) { 1 } else { 0 });
    }

    // tokenIdWithNoneExtra(packed, poolId) -- the Phase 2 no-payload path: the builder is generic
    // over T but still returns a PanopticTokenId, and `pool_id` is still a parameter.
    if selector == SEL_TOKEN_ID_NONE_EXTRA {
        let vo = unpack_vol_order(@evm_calldataload(4));
        return_1(
            vol_order_to_panoptic_token_id(
                calldata,
                vo,
                PanopticPoolId { word: @evm_calldataload(36) },
            ).tokenId,
        );
    }

    // extraDecodeFields(word) -> (flags, offset, len). Reverts on a reserved flag bit or on a len
    // the flags do not imply -- the descriptor is validated, not merely read.
    if selector == SEL_EXTRA_DECODE_FIELDS {
        let e = extra_decode(calldata, @evm_calldataload(4));
        return_3(e.flags, e.offset, e.len);
    }

    // extraEncodeRoundTrip(word) -> encode(decode(word)): the packed layout is a bijection on the
    // fields it defines, so a descriptor survives a round trip through the type.
    if selector == SEL_EXTRA_ENCODE_ROUND_TRIP {
        return_1(extra_encode(calldata, extra_decode(calldata, @evm_calldataload(4))));
    }

    // packIgnoresExtra(packed, word) -- an order carrying Some(Extra) packs to the same word as the
    // same order carrying None. The "pack/unpack stays region-agnostic" claim, tested.
    if selector == SEL_PACK_IGNORES_EXTRA {
        let vo = unpack_vol_order(@evm_calldataload(4));
        let rich = vol_order_with_extra(calldata, vo, extra_decode(calldata, @evm_calldataload(36)));
        return_1(pack_vol_order(rich));
    }

    // unwrapNoneReverts(packed) -- reading through a None `extra` is a runtime REVERT, not a zero.
    if selector == SEL_UNWRAP_NONE_REVERTS {
        let vo = unpack_vol_order(@evm_calldataload(4));
        return_1(unwrap(vo.extra).flags);
    }

    // ---- Phase 2.5 (VORD-07): the 40-bit payload. Leg k at [8k..8k+7]; vegoid at 32..39. ----

    if selector == SEL_PAYLOAD_OPTION_RATIO {
        return_1(extra_payload_option_ratio(@evm_calldataload(4), @evm_calldataload(36)));
    }

    if selector == SEL_PAYLOAD_TOKEN_TYPE {
        return_1(extra_payload_token_type(@evm_calldataload(4), @evm_calldataload(36)));
    }

    if selector == SEL_PAYLOAD_VEGOID {
        return_1(extra_payload_vegoid(@evm_calldataload(4)));
    }

    // Returns 1 on success; the interesting outcome is the REVERT on a zero vegoid or a zero
    // optionRatio, which is the only reachable invalid value in either field.
    if selector == SEL_PAYLOAD_VALIDATE {
        extra_payload_validate(@evm_calldataload(4));
        return_1(1);
    }

    // Returns 1 on success; the interesting outcomes are the REVERTS -- on a mismatch, and on a
    // zero vegoid even when the poolId's vegoid nibble is also zero and the equality holds.
    if selector == SEL_PAYLOAD_REQUIRE_VEGOID_AGREES {
        extra_payload_require_vegoid_agrees(@evm_calldataload(4), @evm_calldataload(36));
        return_1(1);
    }

    @evm_stop();
}
