import std::constructor::return_runtime;
import std::regions::*;
import std::option::{Option, Some, None, is_some, is_none, unwrap};
import std::error::require;
import types::protocol_integrations::PanopticTokenId::*;
import pos_spec::VolOrder::*;
import lib::protocol_integrations::PanopticTokenIdSetterLib::vol_order_to_panoptic_token_id;

// Harness for the VolOrder(T) TYPE (Phase 2, VORD-01), written to 02-REGRESSION-ASSESSMENT.md §4a.
// RED-first: it exercises Extra(T), the Option-valued `extra`, and the builder's None path, so the
// plank job type-checks them. Absence is std Option/None -- a VALUE, not a tag type -- so there is
// ONE VolOrder type per region and `T` here is always `calldata`, matching every current caller.
//
// The two things that must NOT compile live in fixtures/plank-negative/ (outside compile-plank's
// src/test scan) and are driven from VolOrderType.t.sol through vm.tryFfi.

// cast sig "roundTripNone(uint256)"            -> 0x5784c808
const SEL_ROUND_TRIP = 0x5784c808;
// cast sig "extraIsNoneAfterUnpack(uint256)"   -> 0xd60b13a1
const SEL_EXTRA_IS_NONE = 0xd60b13a1;
// cast sig "tokenIdViaExtra(uint256,uint256)"  -> 0xc85cb95b
const SEL_TOKEN_ID_VIA_EXTRA = 0xc85cb95b;
// cast sig "extraDecodeFlags(bytes)"           -> 0x461539b8
const SEL_EXTRA_DECODE_FLAGS = 0x461539b8;
// cast sig "packIgnoresExtra(uint256,bytes)"   -> 0x7cbf1d93
const SEL_PACK_IGNORES_EXTRA = 0x7cbf1d93;
// cast sig "unwrapNoneReverts(uint256)"        -> 0xc0e8737e
const SEL_UNWRAP_NONE_REVERTS = 0xc0e8737e;

init { return_runtime(); }

const return_1 = fn (a: u256) never {
    let out = @malloc_uninit(32);
    @mstore32(out, a);
    @evm_return(out, 32);
};

// A bytes(calldata) view over the ABI `bytes` argument whose head word sits at `slot`.
const calldata_bytes_at = fn (slot: u256) bytes(calldata) {
    let off = @evm_calldataload(slot);
    bytes(calldata) { ptr: 4 +% off +% 32, length: @evm_calldataload(4 +% off) }
};

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // roundTripNone(packed) -- the codec is untouched by the Option-valued `extra`: pack(unpack(x))
    // is still the identity on the 248-bit word, and `extra` never enters it.
    if selector == SEL_ROUND_TRIP {
        return_1(pack_vol_order(unpack_vol_order(@evm_calldataload(4))));
    }

    // extraIsNoneAfterUnpack(packed) -> 1 if the unpacked order's `extra` is None. The minimal
    // instantiation is a VALUE (None), not a distinct type.
    if selector == SEL_EXTRA_IS_NONE {
        let vo = unpack_vol_order(@evm_calldataload(4));
        return_1(if is_none(Extra(calldata), vo.extra) { 1 } else { 0 });
    }

    // tokenIdViaExtra(packed, poolId) -- the builder's None path: it returns the UPDATED
    // VolOrder(T) and the tokenId LANDS in `extra`. Read it back out; unwrap reverts if the
    // builder failed to land it, so a silent no-op cannot pass.
    if selector == SEL_TOKEN_ID_VIA_EXTRA {
        let vo = unpack_vol_order(@evm_calldataload(4));
        let built = vol_order_to_panoptic_token_id(calldata, vo, @evm_calldataload(36));
        return_1(unwrap(unwrap(built.extra).token_id).tokenId);
    }

    // extraDecodeFlags(data) -- the tagged ADDRESS SPACE: flags(u8) || [ptr(u256) if PANOPTIC].
    // Returns the flag byte; reverts on a reserved bit or on a length the flags do not imply.
    if selector == SEL_EXTRA_DECODE_FLAGS {
        return_1(extra_decode(calldata, calldata_bytes_at(4)).flags);
    }

    // packIgnoresExtra(packed, data) -- an order carrying Some(Extra) packs to the same word as
    // the same order carrying None. This is the "pack/unpack stays region-agnostic" claim, tested.
    if selector == SEL_PACK_IGNORES_EXTRA {
        let vo = unpack_vol_order(@evm_calldataload(4));
        let rich = vol_order_with_extra(calldata, vo, extra_decode(calldata, calldata_bytes_at(36)));
        return_1(pack_vol_order(rich));
    }

    // unwrapNoneReverts(packed) -- reading through a None `extra` is a runtime REVERT, not a
    // zero value. Pairs with the compile-time negative in fixtures/plank-negative/.
    if selector == SEL_UNWRAP_NONE_REVERTS {
        let vo = unpack_vol_order(@evm_calldataload(4));
        return_1(unwrap(vo.extra).flags);
    }

    @evm_stop();
}
