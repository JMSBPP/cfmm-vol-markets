import pos_spec::VolOrder::*;
import std::constructor::return_runtime;
import pos_spec::TickVolatility::*;
import pos_spec::VolRangeWidth::*;
import pos_spec::SpreadTickAssimetry::*;
import pos_spec::TickUtils::*;
import v3::util::return_u256;

// signature :: set_vol_order_vol_strike(uint256,uint88)
const SELECTOR_VOL_ORDER_SET_VOL_STRIKE = 0x0fdef212;
 
// signature :: set_vol_order_skew(uint256,uint16)
const SELECTOR_VOL_ORDER_SET_SKEW = 0x5ef414c7;

// signature:: set_vol_order_range_width(uint256,uint256)
const SELECTOR_VOL_ORDER_SET_RANGE_WIDTH = 0x4836d27e;

 // todo: set vol width args
/////////////////////////////////////////
// const SELECTOR_VOL_ORDER_SET_RANGE_ //
/////////////////////////////////////////

// signature:: tick_bucket_from_vol_order(uint256)
const SELECTOR_VOL_ORDER_TICK_BUCKET_FROM_VOL_ORDER = 0x1072034b;

init { return_runtime();}

run{
	let selector = @evm_shr(224,@evm_calldataload(0));
	if selector == SELECTOR_VOL_ORDER_SET_VOL_STRIKE {
	   let prev_vol_order = @evm_calldataload(4);
	   let vol_strike = @evm_calldataload(36) & 0xffffffffffffffffffffff;
	   let vol_order = set_vol_order_vol_strike(unpack_vol_order(prev_vol_order),unpack_tick_volatility(vol_strike));
	   return_vol_order_incomplete(vol_order);
	   
	} else if selector == SELECTOR_VOL_ORDER_SET_SKEW {
	     let prev_vol_order = @evm_calldataload(4);
	     let skew = @evm_calldataload(36) & 0xffff;
	     let vol_order = set_vol_order_skew(unpack_vol_order(prev_vol_order),unpack_spread_tick_assimetry(skew));
	     
	     return_vol_order_incomplete(vol_order);
	} else if selector == SELECTOR_VOL_ORDER_SET_RANGE_WIDTH {
	     let prev_vol_order = @evm_calldataload(4);
	     let packed_range_width = @evm_calldataload(36);

	     let vol_order = set_vol_order_range_width(unpack_vol_order(prev_vol_order),unpack_vol_range_width(packed_range_width));
	     return_vol_order_incomplete(vol_order);
	} else if selector == SELECTOR_VOL_ORDER_TICK_BUCKET_FROM_VOL_ORDER {
	       let vol_order = unpack_vol_order(@evm_calldataload(4));
	       return_u256(pack_tick_bucket(tick_bucket_from_vol_order(vol_order)));
	}


	@evm_stop();
}

