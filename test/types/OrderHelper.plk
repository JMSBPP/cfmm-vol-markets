
import std::constructor::return_runtime;
import std::type::sizeof;
import types::Order::{Order,make, validate_order};
import v3::util::revert_empty;

const SELECTOR_INIT_ORDER = 0xc566b5c5;

init {
      return_runtime();
}

const handle_state = fn (selector: u256) void {
      	if selector == 0xc566b5c5 {
	   let orderDataPtr = @evm_calldataload(4);
	   let orderDataStart = 4 + orderDataPtr;
	   let orderDataLen = @evm_calldataload(orderDataStart);
	   let mut i = 0;
	   let tickLower = @evm_calldataload(orderDataStart + 24 + i*24 ) & 0xFFFFFF;
	   let tickUpper = @evm_calldataload(orderDataStart + 48 + i*24) & 0xFFFFFF;
	   let varianceExposureAmt = @evm_calldataload(orderDataStart + 72 + i*88);
	   validate_order(tickLower, tickUpper, varianceExposureAmt);
	   let order = make(tickLower, tickUpper, varianceExposureAmt);
	   let orderTypeSize = sizeof(Order);
	   let ret = @malloc_uninit(orderTypeSize);
	   @mstore32(ret, order.tickLower);
	   @mstore32(ret +% 32 , order.tickUpper);
	   @mstore32(ret +% 64, order.varianceExposureAmt);
	   @evm_return(ret, orderTypeSize);
	} else {
	    revert_empty();
	}
};

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    handle_state(selector);
    @evm_stop();
   	
}