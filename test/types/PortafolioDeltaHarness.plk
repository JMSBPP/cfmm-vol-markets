import std::constructor::return_runtime;
import v3::util::return_u256;
import types::Portafolio::*;

// cast sig "toDelta(int128,int128)"        -> 0x436ece8c
const SEL_TO_DELTA = 0x436ece8c;
// cast sig "amt0(int256)"                  -> 0xac15091b
const SEL_AMT0 = 0xac15091b;
// cast sig "amt1(int256)"                  -> 0xe1014524
const SEL_AMT1 = 0xe1014524;
// cast sig "deltaAdd(int256,int256)"       -> 0x827006b2
const SEL_ADD = 0x827006b2;
// cast sig "deltaSub(int256,int256)"       -> 0x6742911c
const SEL_SUB = 0x6742911c;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    if selector == SEL_TO_DELTA {
        return_u256(to_portafolio_delta(@evm_calldataload(4), @evm_calldataload(36)));
    }
    if selector == SEL_AMT0 {
        return_u256(portafolio_delta_amount0(@evm_calldataload(4)));
    }
    if selector == SEL_AMT1 {
        return_u256(portafolio_delta_amount1(@evm_calldataload(4)));
    }
    if selector == SEL_ADD {
        return_u256(portafolio_delta_add(@evm_calldataload(4), @evm_calldataload(36)));
    }
    if selector == SEL_SUB {
        return_u256(portafolio_delta_sub(@evm_calldataload(4), @evm_calldataload(36)));
    }

    @evm_stop();
}
