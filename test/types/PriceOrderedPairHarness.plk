import std::constructor::return_runtime;
import types::pricing::PriceCoordinate::*;
import types::pricing::PriceOrderedPair::*;

// signature:: priceOrderedPair(uint256,uint256,uint256,int24,int24) -> (bytes32,uint256,uint256)
//   args  : tick_spacing, subs_elasticity (η, Q64.96), numb_rep, i1, i2
//   return: (geometry, lower, upper)
//   cast sig "priceOrderedPair(uint256,uint256,uint256,int24,int24)" -> 0x4bca8b50
const SEL_PRICE_ORDERED_PAIR = 0x4bca8b50;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // tick_spacing@4, eta@36, numb_rep@68, i1@100, i2@132
    if selector == SEL_PRICE_ORDERED_PAIR {
        let coord = price_coordinate(
            @evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68)
        );
        let op = price_ordered_pair(coord, @evm_calldataload(100), @evm_calldataload(132));
        // ABI tuple (bytes32,uint256,uint256) = 3 static words = 96 bytes
        let out = @malloc_uninit(96);
        @mstore32(out, op.geometry);
        @mstore32(out +% 32, op.lower);
        @mstore32(out +% 64, op.upper);
        @evm_return(out, 96);
    }

    @evm_stop();
}
