import std::constructor::return_runtime;
import v3::util::return_u256;
import lib::LiquidityAmounts::*;
import types::ldf::LDFParams::*;
import types::pricing::PriceCoordinate::*;
import types::Collateral::*;
import types::exposure::VegaExposure::{VegaNominal};

// cast sig "liquidityForCollateral(int24,int24,int24,uint256,uint256)" -> 0x03d5f263
const SEL_LFC = 0x03d5f263;
// cast sig "liquidityForVega(int24,int24,int24,uint256,uint256,uint256)" -> 0xec2818d0
const SEL_LFV = 0xec2818d0;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // liquidityForCollateral(minTick@4, tickSpacing@36, length@68, alphaX96@100, collateral@132)
    if selector == SEL_LFC {
        // build a geometric LDFParams (i_min, xi=alpha, iota=length) and a coordinate (only tick_spacing is used)
        let ldf_params = ldf_geometric_params(@evm_calldataload(4), @evm_calldataload(100), @evm_calldataload(68));
        let coord = price_coordinate(@evm_calldataload(36), 0, 96);
        let chunk = liquidity_for_collateral(ldf_params, coord, Collateral { val: @evm_calldataload(132) });
        return_u256(chunk.size);
    }

    // liquidityForVega(minTick@4, tickSpacing@36, length@68, alphaX96@100, exposure@132, priceVolX96@164)
    if selector == SEL_LFV {
        let ldf_params = ldf_geometric_params(@evm_calldataload(4), @evm_calldataload(100), @evm_calldataload(68));
        let coord = price_coordinate(@evm_calldataload(36), 0, 96);
        let chunk = liquidity_for_vega(
            ldf_params, coord,
            VegaNominal { exposure: @evm_calldataload(132), priceVolX96: @evm_calldataload(164) }
        );
        return_u256(chunk.size);
    }

    @evm_stop();
}
