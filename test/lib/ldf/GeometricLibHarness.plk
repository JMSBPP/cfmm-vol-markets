import std::constructor::return_runtime;
import v3::util::return_u256;
import lib::ldf::GeometricLib::*;

// cast sig "geoDensity(int24,int24,int24,int24,uint256)" -> 0xec3b36d7
const SEL_GEO_DENSITY = 0xec3b36d7;
// cast sig "geoCumAmount0(int24,uint256,int24,int24,int24,uint256)" -> 0xccd90b3b
const SEL_GEO_CUM0 = 0xccd90b3b;
// cast sig "geoCumAmount1(int24,uint256,int24,int24,int24,uint256)" -> 0xf3e7779f
const SEL_GEO_CUM1 = 0xf3e7779f;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // geoDensity(roundedTick@4, tickSpacing@36, minTick@68, length@100, alphaX96@132)
    if selector == SEL_GEO_DENSITY {
        return_u256(geometric_liquidity_density_x96(
            @evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68),
            @evm_calldataload(100), @evm_calldataload(132)
        ));
    }

    // geoCumAmount0(roundedTick@4, totalLiquidity@36, tickSpacing@68, minTick@100, length@132, alphaX96@164)
    if selector == SEL_GEO_CUM0 {
        return_u256(geometric_cumulative_collateral_on_liquidity(
            @evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68),
            @evm_calldataload(100), @evm_calldataload(132), @evm_calldataload(164)
        ));
    }

    // geoCumAmount1(roundedTick@4, totalLiquidity@36, tickSpacing@68, minTick@100, length@132, alphaX96@164)
    if selector == SEL_GEO_CUM1 {
        return_u256(geometric_cumulative_underlying_on_liquidity(
            @evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68),
            @evm_calldataload(100), @evm_calldataload(132), @evm_calldataload(164)
        ));
    }

    @evm_stop();
}
