import std::constructor::return_runtime;
import std::option::{None, Some};
import std::regions::calldata;
import lib::panoptic::Binning::ladder_from_vol_order;
import pos_spec::SpreadTickAssimetry::*;
import pos_spec::TickVolatility::*;
import pos_spec::VolOrder::*;
import pos_spec::VolRangeWidth::*;
import pos_spec::VegaTarget::*;
import types::Extra::{Extra};
import types::protocol_integrations::Pool::*;
import types::protocol_integrations::Registry::*;
import types::protocol_integrations::VolMarketKey::*;
import types::protocol_integrations::Venue::*;
import types::Pair::*;
import std::core::addr::addr_from_u256;

// Binning harness — ladderFromVolOrder geometry + full ladder path (spec Panoptic.Binning).
// cast sig "ladderGeometryFromVolOrder(uint256,uint256,uint256,uint256,uint256)" -> 0xb5d1b675
// cast sig "ladderFromVolOrder(uint256,uint256,uint256,uint256,uint256)" -> 0x4fcfdf3e

const SEL_GEOMETRY = 0xb5d1b675;
const SEL_LADDER = 0x4fcfdf3e;

const FIX_C0 = 0x1111;
const FIX_C1 = 0x2222;
const FIX_REG = 0x3333;
const FIX_FEE = 3000;

const fixture_market = fn(ts: u256) VolMarketKey(V4) {
    let p = pair(addr_from_u256(FIX_C0), addr_from_u256(FIX_C1), 0);
    let reg = registry_v4(addr_from_u256(FIX_REG));
    vol_market_key(V4, Some(p), Some(reg), Some(pool_v4(p, reg, FIX_FEE, ts)))
};

const fixture_vol_order = fn(
    strike: u256,
    width: u256,
    skew: u256,
    target_vega: u256,
    ts: u256
) VolOrder(calldata) {
    VolOrder(calldata) {
        rangeWidth: VolRangeWidth { width: width, tickSpacing: ts },
        volStrike: TickVolatility { vol: strike },
        skew: SpreadTickAssimetry { spread: skew },
        targetVega: unpack_vega_target(target_vega),
        extra: None(Extra(calldata))
    }
};

const return_ladder_geometry = fn(lo: u256, hi: u256, star: u256, vega: u256) void {
    let out = @malloc_uninit(128);
    @mstore32(out, lo);
    @mstore32(out +% 32, hi);
    @mstore32(out +% 64, star);
    @mstore32(out +% 96, vega);
    @evm_return(out, 128);
};

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    if selector == SEL_GEOMETRY {
        let strike = @evm_calldataload(4);
        let width = @evm_calldataload(36);
        let skew = @evm_calldataload(68);
        let target_vega = @evm_calldataload(100);
        let ts = @evm_calldataload(132);
        let vo = fixture_vol_order(strike, width, skew, target_vega, ts);
        let g = vol_order_ladder_geometry(calldata, vo);
        return_ladder_geometry(g.lo, g.hi, g.star, g.vega);
    }

    if selector == SEL_LADDER {
        let strike = @evm_calldataload(4);
        let width = @evm_calldataload(36);
        let skew = @evm_calldataload(68);
        let target_vega = @evm_calldataload(100);
        let ts = @evm_calldataload(132);
        let vo = fixture_vol_order(strike, width, skew, target_vega, ts);
        let market = fixture_market(ts);
        let l = ladder_from_vol_order(V4, calldata, market, vo);
        return_ladder_geometry(l.lo, l.hi, l.star, l.vega);
    }

    @evm_stop();
}
