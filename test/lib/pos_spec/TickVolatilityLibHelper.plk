import lib::pos_spec::TickVolatilityLib::*;
import std::constructor::return_runtime;
import pos_spec::TickVolatility::*;
import std::addr::addr_from_u256;
// it receives the address of the implementation and stores it on bytecode as immutable


// signature::tick_volatility_tick(uint256)
const SELECTOR_TICK_VOLATILITY_TICK = 0x3ca2702d;
// signature::tick_volatility_sqrt_price_X64x96(uint256)
const SELECTOR_TICK_VOLATILITY_SQRT_PRICE_X64x96 = 0xe77624bf;
// signature:  set_implementation(address)
const SELECTOR_SET_IMPL = 0x4cd69da0;
// keccak256("tick-volatility.exp-math")
const SLOT_EXP_MATH_IMPL = 0xe871036a295e1722f30447cb2ff68b23f234f24f72c2778501eb78e58506b511;

init { return_runtime();}


run{
	let selector = @evm_shr(224,@evm_calldataload(0));
	let tick_vol =  @evm_calldataload(4);

	if selector == SELECTOR_LN_VOL_WAD {
	   return_lnVolWAD(addr_from_u256(@evm_sload(SLOT_EXP_MATH_IMPL)),wrap_tick_volatility(tick_vol));   
	} else if selector == SELECTOR_LN_VOL_X96 {
 	   return_lnVolX96(addr_from_u256(@evm_sload(SLOT_EXP_MATH_IMPL)),wrap_tick_volatility(tick_vol));	
	} else if selector == SELECTOR_TICK_VOLATILITY_TICK {
	    return_tick_volatility_tick(wrap_tick_volatility(tick_vol));
	} else if selector == SELECTOR_TICK_VOLATILITY_SQRT_PRICE_X64x96{
	    return_tick_volatility_sqrt_price_X64x96(wrap_tick_volatility(tick_vol));
	} else if selector == SELECTOR_SET_IMPL {
	       let impl = @evm_calldataload(4);
	       @evm_sstore(SLOT_EXP_MATH_IMPL, impl);
	}
	@evm_stop();
}