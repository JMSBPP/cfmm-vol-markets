import std::constructor::return_runtime;
import lib::fee_volatility::RealizedVolatilityLib::*;
import pos_spec::TickVolatility::*;
import v3::util::{return_u256};

// signature:: volatilityOnRange(int256,int256,int256,int256,int256) -> uint256
const SELECTOR_VOLATILITY_ON_RANGE = 0xc6342af0;

init { return_runtime(); }

run {
	let selector = @evm_shr(224, @evm_calldataload(0));

	if selector == SELECTOR_VOLATILITY_ON_RANGE {
	   let dt        = @evm_calldataload(4);
	   let tick0     = @evm_calldataload(36);
	   let tick1     = @evm_calldataload(68);
	   let avg_tick0 = @evm_calldataload(100);
	   let avg_tick1 = @evm_calldataload(132);
	   let res = calculate_realized_volatility(avg_tick0, avg_tick1, tick0, tick1, dt);
	   return_u256(res.vol);
	}
	@evm_stop();
}
