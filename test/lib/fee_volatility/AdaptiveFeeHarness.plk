import std::constructor::return_runtime;
import lib::fee_volatility::AdaptiveFee::*;
import types::fee_volatility::AlgebraFeeConfiguration::*;

// Harness for the Algebra AdaptiveFee port (exp_x_g4 / sigmoid / get_fee). Differential-tested vs the
// real @cryptoalgebra/dynamic-fee-plugin AdaptiveFee library.

// cast sig "expXg4(uint256,uint16)"                 -> 0x312f3cb5
const SEL_EXPXG4 = 0x312f3cb5;
// cast sig "sigmoid(uint256,uint16,uint16,uint256)" -> 0x7a8c1738
const SEL_SIGMOID = 0x7a8c1738;
// cast sig "getFee(uint88,uint256)"                  -> 0x899a6574
const SEL_GETFEE = 0x899a6574;
// cast sig "validateConfig(uint16,uint16,uint32,uint32,uint16,uint16,uint16)" -> 0xb5a8a256
const SEL_VALIDATE = 0xb5a8a256;
// cast sig "initialConfig()"                         -> 0x04d94317
const SEL_INITIAL = 0x04d94317;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // expXg4(x@4, g@36) -> uint256 ; computes g^4 and calls exp_x_g4(x, g, g^4) as sigmoid does.
    if selector == SEL_EXPXG4 {
        let x = @evm_calldataload(4);
        let g = @evm_calldataload(36);
        let g4 = g *% g *% g *% g;
        let out = @malloc_uninit(32);
        @mstore32(out, exp_x_g4(x, g, g4));
        @evm_return(out, 32);
    }

    // sigmoid(x@4, g@36, alpha@68, beta@100) -> uint256
    if selector == SEL_SIGMOID {
        let out = @malloc_uninit(32);
        @mstore32(out, sigmoid(@evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68), @evm_calldataload(100)));
        @evm_return(out, 32);
    }

    // getFee(volatility@4, packedConfig@36) -> uint256 (fee in 1e-6 units)
    if selector == SEL_GETFEE {
        let out = @malloc_uninit(32);
        @mstore32(out, get_fee(@evm_calldataload(4), @evm_calldataload(36)));
        @evm_return(out, 32);
    }

    // validateConfig(alpha1@4, alpha2@36, beta1@68, beta2@100, gamma1@132, gamma2@164, baseFee@196)
    // -> uint256 1 (reverts if invalid). Fields masked to width first (as the module will).
    if selector == SEL_VALIDATE {
        let cfg = AlgebraFeeConfiguration {
            alpha1: @evm_calldataload(4) & 0xffff,
            alpha2: @evm_calldataload(36) & 0xffff,
            beta1: @evm_calldataload(68) & 0xffffffff,
            beta2: @evm_calldataload(100) & 0xffffffff,
            gamma1: @evm_calldataload(132) & 0xffff,
            gamma2: @evm_calldataload(164) & 0xffff,
            base_fee: @evm_calldataload(196) & 0xffff
        };
        validate_fee_configuration(cfg);
        let out = @malloc_uninit(32);
        @mstore32(out, 1);
        @evm_return(out, 32);
    }

    // initialConfig() -> uint256 (packed default config)
    if selector == SEL_INITIAL {
        let out = @malloc_uninit(32);
        @mstore32(out, algebra_fee_config_pack(initial_fee_configuration()));
        @evm_return(out, 32);
    }

    @evm_stop();
}
