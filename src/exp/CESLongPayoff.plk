import std::constructor::return_runtime;
import v3::math::sqrt_price_math::{getNextSqrtPriceFromAmount0RoundingUp, getAmount1DeltaUnsigned};
import v3::math::full_math::mulDiv;
import v3::math::fixed_point_96::Q96;
import v3::util::return_u256;

/// @dev signature:: "cesLongPayoff(uint160,uint128,uint256)"
const CES_LONG_PAYOFF_SELECTOR = 0x1dbad771;

///         π_{1/2}^{trader} = ( P_{1/2}(i)·Δ^I − Δ^O )²
const cesLongPayoff = fn (sqrtPX96: u256, liquidity: u256, amount0In: u256) u256 {
    let term = mulDiv(sqrtPX96, amount0In, Q96);
    let shortfall = if term >= amount1Out { term - amount1Out } else { amount1Out - term };
    shortfall *% shortfall
};

init {
    return_runtime();
}

run {
    let selector = @evm_calldataload(0) >> 224;
    if selector == CES_LONG_PAYOFF_SELECTOR {
        let sqrtPX96 = @evm_calldataload(4);
        let liquidity = @evm_calldataload(36);
        let amount0In = @evm_calldataload(68);
        return_u256(cesLongPayoff(sqrtPX96, liquidity, amount0In));
    } else {
        @evm_revert(@malloc_uninit(0), 0);
    }
}
