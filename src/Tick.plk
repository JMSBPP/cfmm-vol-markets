/// Tick demo: setTick/readTick against EIP-1153 transient storage; emits SetTick.
use std::prelude::*;

const TICK_SLOT = 0;

/// cast sig "setTick(uint256)"
const SET_TICK_SELECTOR = 0xfb972e51;
/// cast sig "readTick()"
const READ_TICK_SELECTOR = 0x23f6079d;
/// cast sig-event "SetTick(uint256)"
const SET_TICK_TOPIC = 0x2833a7bdc4e30391adeb052e4232401f54ff1a34cd8db2c61c32b3199b3907c2;

init {
    return_runtime();
}

const set_tick = fn (value: u256) void {
    @evm_tstore(TICK_SLOT, value);
    let buf = @malloc_uninit(32);
    @mstore32(buf, value);
    @evm_log1(buf, 32, SET_TICK_TOPIC);
};

const read_tick = fn () never {
    let value = @evm_tload(TICK_SLOT);
    let buf = @malloc_uninit(32);
    @mstore32(buf, value);
    @evm_return(buf, 32);
};

run {
    let selector = @evm_calldataload(0) >> 224;
    if selector == SET_TICK_SELECTOR {
        set_tick(@evm_calldataload(4));
        @evm_stop();
    } else if selector == READ_TICK_SELECTOR {
        read_tick();
    } else {
        @evm_revert(@malloc_uninit(0), 0);
    }
}
