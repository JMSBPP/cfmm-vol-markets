// note: returns the uint160 corresponds to the sqrtPrice of the tick vol
const tick_volatility_sqrt_price_X64x96 = fn(self: TickVolatility) u256 {
      let volXQ64x96 = volQ64X96(self);
      volXQ64x96.vol
};
// note: returns the tick associated with the tickVolatility
const tick_volatility_tick = fn (self: TickVolatility) u256 {
      getTickAtSqrtRatio(tick_volatility_sqrt_price_X64x96(self))          
      
};


// note: returns the uint160 corresponds to the sqrtPrice of the tick vol
const return_tick_volatility_sqrt_price_X64x96 = fn(self: TickVolatility) never {
      let res = tick_volatility_sqrt_price_X64x96(self);
      let out_ptr = @malloc_uninit(32);
      @mstore32(out_ptr, res);
      @evm_return(out_ptr, 32);
};

// note: returns the tick associated with the tickVolatility
const return_tick_volatility_tick = fn (self: TickVolatility) never {
      let res = tick_volatility_tick(self);
      let out_ptr = @malloc_uninit(32);
      @mstore32(out_ptr, res);
      @evm_return(out_ptr, 32);      
};