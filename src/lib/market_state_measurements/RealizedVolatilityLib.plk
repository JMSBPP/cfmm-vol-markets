	 let dt = (@evm_timestamp() & 0xFFFFFFFF ) -% last_timepoint.timestamp;
	 let current_tick_cumulative = last_timepoint.tick_cumulative +% ( tick *% dt );
	 // todo: timestamp is also a type that fits 32 bytes
	 if @evm_timestamp() & 0xFFFFFFFF  == last_timepoint.timestamp {avg_tick_res = AvgTickRes{avg_tick: tick, window_start_index: ref_index};};

        avg_tick_res = AvgTickRes{avg_tick: @evm_div(current_tick_cumulative -% last_timepoint.tick_cumulative,dt), window_start_index: ref_index};
	
	// todo: This needs to be implemented using the plank equivalent implementation  
