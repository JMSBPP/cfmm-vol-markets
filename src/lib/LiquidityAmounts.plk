import types::ldf::LDFParams::*;
import types::ldf::LiquidityChunk::*;
import types::PriceCoordinate::*;
import types::Collateral::*;
import types::exposure::VegaExposure::{VegaNominal};
import types::Portafolio::*;
import lib::ldf::GeometricDistribution::{geometric_cumulative_amount0, geometric_cumulative_amount1};
import v3::math::full_math::mulDiv;
import v3::util::revert_empty;

const Q96 = 0x1000000000000000000000000;                         // 2^96
const U128_MAX = 0xffffffffffffffffffffffffffffffff;             // 2^128 - 1 (Panoptic LiquidityChunk domain)

// liquidity_for_collateral: the total liquidity L̄ a geometric-LDF position holds when funded by
// `collateral` token0 over its support [i_min, i_max). Reviewed design (two-step review resolution):
//   cost_M = cumulativeAmount0(i_min - Δ, Q96, tickSpacing, i_min, length, alpha)   -- token0 per unit-Q96
//            liquidity over the FULL support (evaluated at i_min - Δ so the right-exclusive range is [i_min, i_max))
//   L̄     = mulDiv(collateral, Q96, cost_M)                                          -- linear inversion, round DOWN
//            (cost_M rounds up inside the closed form, so L̄ rounds down -> conservative, never over-issues)
// Only the geometric LDF is supported here (O(1) closed form). Non-geometric kinds revert; the generic
// per-tick integrator over an arbitrary density fn is deferred (gas/DoS -- see the SPEC + review).
//
// note: takes PriceCoordinate (not PricePair) -- it carries tick_spacing (and η); the price convention is
// η-independent here by eta_split_kernel_identity, so p(i) = getSqrtRatioAtTick(i) as cumulativeAmount0 uses.
const liquidity_for_collateral = fn (
    ldf_params: LDFParams, coord: PriceCoordinate, collateral: Collateral
) LiquidityChunk {
    if ldf_params.kind != LDF_GEOMETRIC {
        revert_empty();
    }
    let w0 = ldf_params.word0;
    let min_tick = @evm_signextend(2, w0 & 0xffffff);            // signed i_min (24-bit sign-extended)
    let alpha_x96 = @evm_shr(24, w0) & 0xffffffffffffffffffffffffffffffffffffffff; // xi, 160-bit
    let length = @evm_shr(184, w0) & 0xffffff;                   // iota

    let cost_m = geometric_cumulative_amount0(
        min_tick -% coord.tick_spacing, Q96, coord.tick_spacing, min_tick, length, alpha_x96
    );
    if cost_m == 0 {
        revert_empty();
    }

    let size = mulDiv(collateral.val, Q96, cost_m);
    if size > U128_MAX {
        revert_empty();
    }

    LiquidityChunk { size: size, ldf_params: ldf_params }
};

// liquidity_for_vega: the liquidity a geometric-LDF position holds when funded by a vega nominal.
// exposure.md §2: ΔM = N_v · p_vol, so the collateral-equivalent is exposure·priceVolX96/Q96 (round down),
// and the result reduces to liquidity_for_collateral(ΔM).
const liquidity_for_vega = fn (
    ldf_params: LDFParams, coord: PriceCoordinate, vega_nominal: VegaNominal
) LiquidityChunk {
    let delta_m = mulDiv(vega_nominal.exposure, vega_nominal.priceVolX96, Q96);
    liquidity_for_collateral(ldf_params, coord, Collateral { val: delta_m })
};

// portafolio_for_liquidity: the (Q_X token1, Q_M token0) amounts a geometric-LDF position of liquidity
// L̄ holds over its full support [i_min, i_max). Full-support model (both directions share it; see SPEC).
//   gross_input  = cumulativeAmount0(i_min − Δ, L̄, …)   -- all token0 over [i_min, i_max)
//   gross_output = cumulativeAmount1(i_max, L̄, …)        -- all token1 over [i_min, i_max) (Q_X sums leftward;
//                  at i_max the closed form's `>= upper` clamp sets x = length-1 = the full support)
// ldf_params is read from the LiquidityChunk (it embeds it), not passed separately.
const portafolio_for_liquidity = fn (coord: PriceCoordinate, liquidity: LiquidityChunk) Portafolio {
    let ldf_params = liquidity.ldf_params;
    if ldf_params.kind != LDF_GEOMETRIC {
        revert_empty();
    }
    let w0 = ldf_params.word0;
    let min_tick = @evm_signextend(2, w0 & 0xffffff);
    let alpha_x96 = @evm_shr(24, w0) & 0xffffffffffffffffffffffffffffffffffffffff;
    let length = @evm_shr(184, w0) & 0xffffff;
    let ts = coord.tick_spacing;
    let i_max = min_tick +% (length *% ts);
    let l_bar = liquidity.size;
    Portafolio {
        gross_output_amt: geometric_cumulative_amount1(i_max, l_bar, ts, min_tick, length, alpha_x96),
        gross_input_amt: geometric_cumulative_amount0(min_tick -% ts, l_bar, ts, min_tick, length, alpha_x96)
    }
};

// liquidity_for_portafolio: the largest liquidity L̄ both legs of `portafolio` can back over the full support.
// Each token amount is linear in L̄, so each gives a candidate; L̄ = min(L̄_M, L̄_X) each rounded DOWN
// (fund-safety — driving from one leg alone over-issues liquidity the other side can't honor). Full-support
// model (mirrors liquidity_for_collateral per leg): cost_M = cumulativeAmount0(i_min−Δ, Q96),
// cost_X = cumulativeAmount1(i_max, Q96).
const liquidity_for_portafolio = fn (
    ldf_params: LDFParams, coord: PriceCoordinate, portafolio: Portafolio
) LiquidityChunk {
    if ldf_params.kind != LDF_GEOMETRIC {
        revert_empty();
    }
    let w0 = ldf_params.word0;
    let min_tick = @evm_signextend(2, w0 & 0xffffff);
    let alpha_x96 = @evm_shr(24, w0) & 0xffffffffffffffffffffffffffffffffffffffff;
    let length = @evm_shr(184, w0) & 0xffffff;
    let ts = coord.tick_spacing;
    let i_max = min_tick +% (length *% ts);

    let cost_m = geometric_cumulative_amount0(min_tick -% ts, Q96, ts, min_tick, length, alpha_x96);
    let cost_x = geometric_cumulative_amount1(i_max, Q96, ts, min_tick, length, alpha_x96);
    if (cost_m == 0) or (cost_x == 0) {
        revert_empty();
    }

    let l_m = mulDiv(portafolio.gross_input_amt, Q96, cost_m);
    let l_x = mulDiv(portafolio.gross_output_amt, Q96, cost_x);
    let size = if l_m < l_x { l_m } else { l_x };
    if size > U128_MAX {
        revert_empty();
    }

    LiquidityChunk { size: size, ldf_params: ldf_params }
};
