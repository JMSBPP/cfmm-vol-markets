
const INIT_TICK_CUMMULATIVE = 0;


const ping_initialized = fn() bool { return true ;}

const oracle_lte = fn (time: u256, a: u256, b: u256) bool {
    if (a <= time) and (b <= time) { return a <= b; }
    let aAdjusted = if a > time { a } else { a +% (1 << 32) };
    let bAdjusted = if b > time { b } else { b +% (1 << 32) };
    aAdjusted <= bAdjusted
};




