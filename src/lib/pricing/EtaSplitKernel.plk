import v3::math::tick_math::getSqrtRatioAtTick;
import v3::math::full_math::mulDiv;
import types::Numerics::{Q96};

// The η-split price kernel — the on-chain form of the cfmm-vol-markets-spec theorem `eta_split_kernel_identity`
// (JMSBPP/cfmm-vol-markets-spec: lean/exp/eta.lean, proven, closed by `ring`):
//
//     P_half(⌊η·i⌋) · P_half(i − ⌊η·i⌋)  =  P_half(i)          for η ∈ (0,1)
//
// η (`eta`) is Q64.96 in (0, 2^96). In the Q64.96 sqrt-price domain the base ½-kernel P_half is exactly
// getSqrtRatioAtTick (which bakes in basis 1.0001), so the theorem's product recombines with a 2^96
// divisor. mulDiv is 512-bit, so the product of the two ~160-bit legs never overflows.

// P_half(i): the η=½ (Δi=½) sqrt-price kernel = 1.0001^(i/2)·2^96.
const p_half = fn (i: u256) u256 { getSqrtRatioAtTick(i) };

// tickSplit_minus η i = ⌊η·i⌋.  SAR by 96 is floor toward −∞ on the two's-complement product,
// which is exactly ⌊·⌋ for both signs of i (no separate negative-floor fix-up needed).
const tick_split_minus = fn (eta: u256, i: u256) u256 { @evm_sar(96, eta *% i) };

// tickSplit_plus η i = i − ⌊η·i⌋  (the two legs' ticks always sum back to i).
const tick_split_plus = fn (eta: u256, i: u256) u256 { i -% tick_split_minus(eta, i) };

// eta_split_kernel_identity: recombine the two half-kernel legs in Q96 — equals P_half(i) for every η.
const eta_split_kernel = fn (eta: u256, i: u256) u256 {
    mulDiv(p_half(tick_split_minus(eta, i)), p_half(tick_split_plus(eta, i)), Q96)
};
