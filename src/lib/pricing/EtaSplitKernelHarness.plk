import std::constructor::return_runtime;
import v3::util::return_u256;
import lib::pricing::EtaSplitKernel::*;
import types::pricing::PriceCoordinate::*;

// cast sig "tickSplitMinus(uint256,int24)"                    -> 0x07841e83
const SEL_MINUS  = 0x07841e83;
// cast sig "tickSplitPlus(uint256,int24)"                     -> 0x6eb69a62
const SEL_PLUS   = 0x6eb69a62;
// cast sig "etaSplitKernel(uint256,int24)"                    -> 0x9afba810
const SEL_KERNEL = 0x9afba810;
// cast sig "priceAtTick(uint256,uint256,uint256,int24)"       -> 0xfe054da4
const SEL_PRICE  = 0xfe054da4;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // eta@4, i@36
    if selector == SEL_MINUS  { return_u256(tick_split_minus(@evm_calldataload(4), @evm_calldataload(36))); }
    if selector == SEL_PLUS   { return_u256(tick_split_plus(@evm_calldataload(4), @evm_calldataload(36))); }
    if selector == SEL_KERNEL { return_u256(eta_split_kernel(@evm_calldataload(4), @evm_calldataload(36))); }

    // priceAtTick(tickSpacing@4, eta@36, numbRep@68, i@100): build the frame, then price via price_at_tick.
    if selector == SEL_PRICE {
        let c = price_coordinate(@evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68));
        return_u256(price_at_tick(c, @evm_calldataload(100)));
    }

    @evm_stop();
}
