const MarketStatisticsInitResult = struct { currentSampleSize: u256, nextTargetedSampleSize: u256 };
const MarketStatisticsWriteResult = struct { indexUpdated: u256, currentSampleSizeUpdated: u256 };


const MarketStatisticsState = struct { ss_index:u256 , lastTimepointTimestamp :u256,initialized :bool};


const pack_market_statistics_state = fn(ss_index:u256, lastTimepointTimestamp :u256,initialized :bool) u256 {
  (ss_index & 0xFFFF)
  | ((lastTimepointTimestamp & 0xFFFFFFFF) << 32)
  | ((if initialized { 1 } else { 0 }) << 248)
};

const unpack_market_statistics_state = fn(packed:u256) MarketStatisticsState {
      MarketStatisticsState{
		ss_index: packed & 0xFFFF,
		lastTimepointTimestamp : @evm_shr(32, packed) & 0xFFFFFFFF,
		initialized : (@evm_shr(248, packed) & 1) > 0
      }
};