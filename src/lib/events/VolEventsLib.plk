// VolEventsLib (EV-01, .planning/events-subgraph-gams-SPEC.md D3/D4): Solidity-ABI event
// emitters, hand-packed over @evm_log2/log3. One emit_* fn per event; the subgraph feeding
// the GAMS database (DATA-08 producer half) indexes exactly these logs.
//
// TOPIC0 constants are precomputed with `cast keccak` over the CANONICAL signature and
// RESTATED test-side, where they are asserted against solc's own EventName.selector
// (test/events/*, spec D8) -- a drifting signature string is caught by the reference
// compiler, not by re-hashing the same mistake twice.
//
// SIGNED-FIELD RULE (spec D1, review F-SE1): ABI data words for intN fields MUST be the
// full 32-byte sign-extended two's complement. Any emitter taking a signed field
// canonicalizes it as @evm_signextend(byte, x & mask) BEFORE the mstore -- never emit the
// masked (storage) representation and never trust a caller-supplied word's high bits.
// Unsigned fields are masked to their declared width for the same reason.
//
// MEMORY: each emitter allocates its own fresh buffer via @malloc_uninit. Plank's bump
// allocator never hands out overlapping regions, so an emit between a pre-allocated return
// buffer's @malloc_uninit and its @evm_return cannot alias it (the documented hazard is
// REUSING a region, VolOrderManagerMod.plk:183-199; fresh allocation is the safe side).
// VolOrderManagerReturnEncodingTest stays in the regression set as the aliasing sentinel.

// cast keccak "VolOrderCreated(uint256,uint88,uint24,uint16)"
const TOPIC0_VOL_ORDER_CREATED = 0x6a5dc72627af2833e83e355ac3f2217c1ebee6afe8249d81d035bd1e0f9ee1a5;
// cast keccak "TimepointWritten(bytes32,uint32,int24,uint88,int24,int56)"
const TOPIC0_TIMEPOINT_WRITTEN = 0x44d3c76a584327df3a91e46e185e97959195c01202945078eebb23b19c161415;
// cast keccak "WindowChanged(bytes32,uint32)"
const TOPIC0_WINDOW_CHANGED = 0x046630eacacfeb3f36a64fd8cb291b41c3e78bcd57f8733e12b9afeb69968b47;

const MASK_U88_EV = 0xFFFFFFFFFFFFFFFFFFFFFF;
const MASK_U32_EV = 0xFFFFFFFF;
const MASK_U24_EV = 0xFFFFFF;
const MASK_U16_EV = 0xFFFF;
const MASK_I56_EV = 0xFFFFFFFFFFFFFF;
// SIGNEXTEND takes a 0-indexed BYTE position: int24 = 3 bytes -> 2, int56 = 7 bytes -> 6.
const SIGN_BYTE_I24_EV = 2;
const SIGN_BYTE_I56_EV = 6;

// E1 VolOrderCreated(uint256 indexed orderId, uint88 strike, uint24 width, uint16 skew).
// No poolId topic (spec D2): orders are market-agnostic at creation; the pool join is E2's.
// Call AFTER the sstore of the packed order (one event per state transition).
const emit_vol_order_created = fn(order_id: u256, strike: u256, width: u256, skew: u256) void {
    let buf = @malloc_uninit(96);
    @mstore32(buf,        strike & MASK_U88_EV);
    @mstore32(buf +% 32,  width  & MASK_U24_EV);
    @mstore32(buf +% 64,  skew   & MASK_U16_EV);
    @evm_log2(buf, 96, TOPIC0_VOL_ORDER_CREATED, order_id);
};

// E3 TimepointWritten(bytes32 indexed poolId, uint32 timestamp, int24 tick,
//                     uint88 volatilityCumulative, int24 averageTick, int56 tickCumulative).
// pool_id is the PERMANENT module-global sentinel 0 for module-keyed emitters (spec D2).
// The signed fields (tick, avg_tick, tick_cumulative) arrive either raw-caller-supplied or
// masked-for-storage; BOTH are ABI-wrong -- canonicalize per the signed-field rule above.
// Call AFTER the timepoint + state sstores (one event per state transition).
const emit_timepoint_written = fn(
    pool_id: u256,
    timestamp: u256,
    tick: u256,
    vol_cumulative: u256,
    avg_tick: u256,
    tick_cumulative: u256
) void {
    let buf = @malloc_uninit(160);
    @mstore32(buf,        timestamp & MASK_U32_EV);
    @mstore32(buf +% 32,  @evm_signextend(SIGN_BYTE_I24_EV, tick & MASK_U24_EV));
    @mstore32(buf +% 64,  vol_cumulative & MASK_U88_EV);
    @mstore32(buf +% 96,  @evm_signextend(SIGN_BYTE_I24_EV, avg_tick & MASK_U24_EV));
    @mstore32(buf +% 128, @evm_signextend(SIGN_BYTE_I56_EV, tick_cumulative & MASK_I56_EV));
    @evm_log2(buf, 160, TOPIC0_TIMEPOINT_WRITTEN, pool_id);
};

// cast keccak "FeeConfigurationChanged(bytes32,uint16,uint16,uint32,uint32,uint16,uint16,uint16)"
const TOPIC0_FEE_CONFIGURATION_CHANGED = 0x0b849672f272805103d1934909aaee0c4e1400438ff5365f6d9d147cb07ed6cf;

// E4 FeeConfigurationChanged(bytes32 indexed poolId, uint16 alpha1, uint16 alpha2,
//                            uint32 beta1, uint32 beta2, uint16 gamma1, uint16 gamma2,
//                            uint16 baseFee).
// Field names/widths are Algebra's AlgebraFeeConfiguration VERBATIM; Theta_phi's doc-symbol
// mapping (alpha_j, beta_j, gamma_j, phi-bar = baseFee) lives in the data contract, not in
// renames. All fields unsigned. Call AFTER validate + sstore (a rejected config never emits).
const emit_fee_configuration_changed = fn(
    pool_id: u256,
    alpha1: u256, alpha2: u256,
    beta1: u256, beta2: u256,
    gamma1: u256, gamma2: u256,
    base_fee: u256
) void {
    let buf = @malloc_uninit(224);
    @mstore32(buf,        alpha1  & MASK_U16_EV);
    @mstore32(buf +% 32,  alpha2  & MASK_U16_EV);
    @mstore32(buf +% 64,  beta1   & MASK_U32_EV);
    @mstore32(buf +% 96,  beta2   & MASK_U32_EV);
    @mstore32(buf +% 128, gamma1  & MASK_U16_EV);
    @mstore32(buf +% 160, gamma2  & MASK_U16_EV);
    @mstore32(buf +% 192, base_fee & MASK_U16_EV);
    @evm_log2(buf, 224, TOPIC0_FEE_CONFIGURATION_CHANGED, pool_id);
};

// E6 WindowChanged(bytes32 indexed poolId, uint32 window). The window is a normalization
// parameter of the sigma^2 series (rv_bar, DATA-03/07) -- the DB cannot reconstruct windowed
// volatility from volatilityCumulative without its history. Call AFTER the window sstore.
const emit_window_changed = fn(pool_id: u256, window: u256) void {
    let buf = @malloc_uninit(32);
    @mstore32(buf, window & MASK_U32_EV);
    @evm_log2(buf, 32, TOPIC0_WINDOW_CHANGED, pool_id);
};
