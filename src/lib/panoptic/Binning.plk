// Panoptic.Binning — spec export surface (chunk 2 will grow with bin_notionals / bin_to_legs).
import pos_spec::VolOrder::*;
import types::Ladder::ladder_from_vol_order as ladder_from_vol_order_ladder;
import types::Ladder::Ladder;
import types::protocol_integrations::VolMarketKey::*;

const ladder_from_vol_order = fn(
    comptime V: type,
    comptime R: type,
    market: VolMarketKey(V),
    vo: VolOrder(R)
) Ladder(V) {
    ladder_from_vol_order_ladder(V, R, market, vo)
};
