// The reactive callback ABI, plugged into RealizedVolatilityMod. onPriceUpdate is invoked
// AUTOMATICALLY by the callback proxy when MarketStateSocket forwards a Swap; the proxy injects
// rvmSender as arg0. This lib decodes the tick the module hands to write_timepoint.

// onPriceUpdate(address,bytes32,uint160,int24) -> 0x88a95317
const SELECTOR_ON_PRICE_UPDATE = 0x88a95317;

// args: rvmSender@4, poolId@36, sqrtPriceX96@68, tick@100
const price_update_tick = fn() u256 { @evm_calldataload(100) };

// block timestamp truncated to u32 (Algebra timepoint convention).
const price_update_timestamp = fn() u256 { @evm_timestamp() & 0xffffffff };

// store_price_update_timepoint: the lib's job -- STORE the timepoint on the buffer. Decodes the Swap tick +
// stamps the current block time, then writes the timepoint via the module's `write_timepoint` (passed as a
// comptime function so the lib owns the callback handling while the module owns the buffer storage).
const store_price_update_timepoint = fn (comptime write_timepoint: function) void {
    write_timepoint(price_update_timestamp(), price_update_tick());
};
