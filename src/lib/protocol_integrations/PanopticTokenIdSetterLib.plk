import types::protocol_integrations::PanopticTokenId::*;
import types::pos_spec::VolOrder::{VolOrder, tick_bucket_from_vol_order};
import lib::pos_spec::TickVolatilityLib::tick_volatility_tick;
import types::pricing::TickUtils::round_tick;

// CR-I2 Layer 1: (VolOrder) -> (PanopticTokenId). A variance-swap order is replicated as a 4-leg,
// all-long Panoptic position whose legs tile the strike support [i_l, i_u] and split put/call at the
// skew-center i*. This is the STRUCTURAL SKELETON only -- the geometric weights (Layer 2) and the
// (sigma^2_R - sigma^2_K)^+ cap (Layer 3) are applied above this. Grounded in PosSpec (backbone),
// GeomProfile / VolInstrument (weights, Layer 2) and Demeterfi / Derman-Kani.
// See .planning/cr-i2-vol-order-to-panoptic-token-id-SPEC.md.
//
// i*  = round_tick(vol tick, Δ) is the ATM-forward p* boundary (proven PosSpec.skewTick center).
// legs = 4 contiguous sub-buckets tiling [i_l, i_u], split at i* and its two mid-points m_p, m_c.
// Each leg is encoded with the floor-strike panoptic_add_leg_from_bucket (exact getTicks reconstruct).
const vol_order_to_panoptic_token_id = fn (vo: VolOrder, pool_id: u256) PanopticTokenId {
    let ts = vo.rangeWidth.tickSpacing;
    let i_star = round_tick(tick_volatility_tick(vo.volStrike), ts);
    let tb = tick_bucket_from_vol_order(vo);
    let i_l = tb.low;
    let i_u = tb.up;

    // put-side and call-side mid split points (Δ-aligned)
    let m_p = round_tick(i_l +% ((i_star -% i_l) </ 2), ts);
    let m_c = round_tick(i_star +% ((i_u -% i_star) </ 2), ts);

    // 4 legs: [i_l,m_p] [m_p,i*] (puts) | [i*,m_c] [m_c,i_u] (calls). Floor-strike encoder writes
    // strike+width per leg; tickSpacing is written ONCE below (not per leg).
    let mut tid = 0;
    tid = panoptic_add_leg_from_bucket(tid, i_l, m_p, ts, 0);
    tid = panoptic_add_leg_from_bucket(tid, m_p, i_star, ts, 1);
    tid = panoptic_add_leg_from_bucket(tid, i_star, m_c, ts, 2);
    tid = panoptic_add_leg_from_bucket(tid, m_c, i_u, ts, 3);

    // tokenType: put (0) below i*, call (1) above i*
    tid = panoptic_add_token_type(tid, 0, 0);
    tid = panoptic_add_token_type(tid, 0, 1);
    tid = panoptic_add_token_type(tid, 1, 2);
    tid = panoptic_add_token_type(tid, 1, 3);

    // all legs long (isLong = 1); uniform structural optionRatio = 1 (weights are Layer 2)
    tid = panoptic_add_is_long(tid, 1, 0);
    tid = panoptic_add_is_long(tid, 1, 1);
    tid = panoptic_add_is_long(tid, 1, 2);
    tid = panoptic_add_is_long(tid, 1, 3);
    tid = panoptic_add_option_ratio(tid, 1, 0);
    tid = panoptic_add_option_ratio(tid, 1, 1);
    tid = panoptic_add_option_ratio(tid, 1, 2);
    tid = panoptic_add_option_ratio(tid, 1, 3);

    // poolId: low 48 bits only (univ3 pattern + vegoid); tickSpacing written exactly once at [48..63]
    tid = panoptic_add_pool_id(tid, pool_id & 0xffffffffffff);
    tid = panoptic_add_tick_spacing(tid, ts);

    PanopticTokenId { tokenId: tid, num_legs: 4 }
};
