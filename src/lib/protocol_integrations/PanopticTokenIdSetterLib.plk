import types::protocol_integrations::PanopticTokenId::*;
import types::pos_spec::VolOrder::{VolOrder, tick_bucket_from_vol_order, tick_bucket_from_vol_order_in};
import std::regions::calldata;
import lib::pos_spec::TickVolatilityLib::tick_volatility_tick;
import lib::ldf::LDFLib::{geometric_leg_weights, LegWeights};
import types::pricing::TickUtils::{round_tick, vol_order_split_points};
import types::Numerics::{Q96, U128_MAX};
import v3::math::tick_math::getSqrtRatioAtTick;
import v3::math::full_math::mulDiv;
import std::error::require;

// CR-I2 Layer 1: (VolOrder) -> (PanopticTokenId). A variance-swap order is replicated as a 4-leg,
// all-long Panoptic position whose legs tile the strike support [i_l, i_u] and split put/call at the
// skew-center i*. This is the STRUCTURAL SKELETON only -- the geometric weights (Layer 2) and the
// (sigma^2_R - sigma^2_K)^+ cap (Layer 3) are applied above this. Grounded in PosSpec (backbone),
// GeomProfile / VolInstrument (weights, Layer 2) and Demeterfi / Derman-Kani.
// See .planning/cr-i2-vol-order-to-panoptic-token-id-SPEC.md.
//
// i*  = round_tick(vol tick, Δ) is the ATM-forward p* boundary (proven PosSpec.skewTick center).
// legs = 4 contiguous sub-buckets tiling [i_l, i_u], split at i* and its two mid-points m_p, m_c.
// Each leg is encoded with the floor-strike panoptic_add_leg_from_bucket (exact getTicks reconstruct).
// PHASE 2 (VORD-01/02): generic over the region tag T -- the ONLY comptime-T signature in this
// file. `vo.extra` is a DESCRIPTOR of where the operands live, not the result: this function still
// RETURNS the PanopticTokenId. Phase 2 is the `None`/no-payload path only -- the geometry is
// exactly today's and `pool_id` is still a parameter, so the emitted id is bit-identical to the
// pre-refactor map (pinned by the untouched golden vectors in VolOrderToPanopticTokenId.t.sol).
// Phase 3 adds the FLAG_PANOPTIC branch: dereference extra's offset for (poolId, OptionRatio[4])
// -- as a Slice(T, u256, Some(4)) over the ratios -- and retire the pool_id parameter.
const vol_order_to_panoptic_token_id = fn (comptime T: type, vo: VolOrder(T), pool_id: u256) PanopticTokenId {
    let ts = vo.rangeWidth.tickSpacing;
    let i_star = round_tick(tick_volatility_tick(vo.volStrike), ts);
    let tb = tick_bucket_from_vol_order_in(T, vo);
    let i_l = tb.low;
    let i_u = tb.up;

    // feasibility guard: each side of i* must span >= 2*ts, so it splits into two non-degenerate
    // legs (width >= 1). Narrower buckets would emit width-0 legs; revert instead.
    require(!@evm_slt(i_star -% i_l, 2 *% ts));
    require(!@evm_slt(i_u -% i_star, 2 *% ts));

    // put-side and call-side mid split points (Δ-aligned) -- SHARED with Layer 2's geometric_leg_weights
    // so the weights line up with the legs placed here.
    let sp = vol_order_split_points(i_l, i_u, i_star, ts);
    let m_p = sp.m_p;
    let m_c = sp.m_c;

    // width bound: each leg's width (in tickSpacings) must fit the 12-bit field (< 4096), else the
    // width would silently overflow the mask. Guards the 4 sub-bucket spans directly.
    require(@evm_slt((m_p -% i_l) </ ts, 4096));
    require(@evm_slt((i_star -% m_p) </ ts, 4096));
    require(@evm_slt((m_c -% i_star) </ ts, 4096));
    require(@evm_slt((i_u -% m_c) </ ts, 4096));

    // 4 legs: [i_l,m_p] [m_p,i*] (puts) | [i*,m_c] [m_c,i_u] (calls). Floor-strike encoder writes
    // strike+width per leg; tickSpacing is written ONCE below (not per leg).
    let mut tid = 0;
    tid = panoptic_add_leg_from_bucket(tid, i_l, m_p, ts, 0);
    tid = panoptic_add_leg_from_bucket(tid, m_p, i_star, ts, 1);
    tid = panoptic_add_leg_from_bucket(tid, i_star, m_c, ts, 2);
    tid = panoptic_add_leg_from_bucket(tid, m_c, i_u, ts, 3);

    // tokenType: put (0) below i*, call (1) above i*
    tid = panoptic_add_token_type(tid, 0, 0);
    tid = panoptic_add_token_type(tid, 0, 1);
    tid = panoptic_add_token_type(tid, 1, 2);
    tid = panoptic_add_token_type(tid, 1, 3);

    // all legs long (isLong = 1); uniform structural optionRatio = 1 (weights are Layer 2)
    tid = panoptic_add_is_long(tid, 1, 0);
    tid = panoptic_add_is_long(tid, 1, 1);
    tid = panoptic_add_is_long(tid, 1, 2);
    tid = panoptic_add_is_long(tid, 1, 3);
    tid = panoptic_add_option_ratio(tid, 1, 0);
    tid = panoptic_add_option_ratio(tid, 1, 1);
    tid = panoptic_add_option_ratio(tid, 1, 2);
    tid = panoptic_add_option_ratio(tid, 1, 3);

    // riskPartner(i) = i (self-partner): all-long legs define no spread, so each leg is its own
    // partner. validate() accepts self-partnered legs (riskPartnerIndex == i skips the mutual check).
    tid = panoptic_add_risk_partner(tid, 1, 1);
    tid = panoptic_add_risk_partner(tid, 2, 2);
    tid = panoptic_add_risk_partner(tid, 3, 3);

    // poolId: low 48 bits only (univ3 pattern + vegoid); tickSpacing written exactly once at [48..63]
    tid = panoptic_add_pool_id(tid, pool_id & 0xffffffffffff);
    tid = panoptic_add_tick_spacing(tid, ts);

    PanopticTokenId { tokenId: tid, num_legs: 4 }
};

// ==========================================================================================
// V2-03 (vol-order-v2-target-vega-SPEC.md D4): the SIZING map. The codomain widens to the
// PAIR (PanopticTokenId, positionSize) -- the tokenId is scale-free; DeltaQ_v* lands on the
// pair. Panoptic DERIVES per-leg chunk liquidity from ONE positionSize (there is no per-leg
// liquidity input), so the single scalar below is the entire on-chain scale control.
// ==========================================================================================

const MintPlan = struct {
      token_id: PanopticTokenId,
      position_size: u256 // uint128-fit-checked; SFPM mintTokenizedPosition's scalar
};

const LegSplit = struct { i_l: u256, m_p: u256, i_star: u256, m_c: u256, i_u: u256, ts: u256 };

// The SHARED split geometry (identical to vol_order_to_panoptic_token_id's -- one source of
// truth so sizing and leg placement can never drift).
const vol_order_leg_split = fn (vo: VolOrder(calldata)) LegSplit {
    let ts = vo.rangeWidth.tickSpacing;
    let i_star = round_tick(tick_volatility_tick(vo.volStrike), ts);
    let tb = tick_bucket_from_vol_order(vo);
    let sp = vol_order_split_points(tb.low, tb.up, i_star, ts);
    LegSplit { i_l: tb.low, m_p: sp.m_p, i_star: i_star, m_c: sp.m_c, i_u: tb.up, ts: ts }
};

// dsqrt of a leg [lo, hi]: getSqrtRatioAtTick(hi) - getSqrtRatioAtTick(lo), Q96. Positive by
// construction (hi > lo after the layer-1 feasibility guards); checked `-` enforces it.
const leg_dsqrt = fn (lo: u256, hi: u256) u256 {
    getSqrtRatioAtTick(hi) - getSqrtRatioAtTick(lo)
};

// position_size_for_target_vega: the MAXIMAL uint128 scalar whose INDUCED total liquidity
// does not exceed DeltaQ_v*.
//
// MECHANISM (SE review, verified vs Panoptic getLiquidityChunk): with optionRatio = 1 and
// asset = 1 on every leg, Panoptic derives leg k's chunk liquidity as
// getLiquidityForAmount1 = amount * Q96 / dsqrt_k, so
//     Sum_k L_k = positionSize * S / Q96,   S = Sum_k mulDiv(Q96, Q96, dsqrt_k)
// and the quantity-exact (one-sided, floor) inversion is
//     positionSize = mulDiv(DeltaQ_v*, Q96, S)      -- delivered <= target, MAXIMAL.
// The ASSET BIT IS LOAD-BEARING: asset = 0 flips the exponent sign of the induced ladder
// (L proportional to 1.0001^(+t/2), the INVERSE weighting) -- pinned to 1 here and tested.
const position_size_for_target_vega = fn (vo: VolOrder(calldata)) u256 {
    let s = vol_order_leg_split(vo);
    let s_sum = mulDiv(Q96, Q96, leg_dsqrt(s.i_l, s.m_p))
        + mulDiv(Q96, Q96, leg_dsqrt(s.m_p, s.i_star))
        + mulDiv(Q96, Q96, leg_dsqrt(s.i_star, s.m_c))
        + mulDiv(Q96, Q96, leg_dsqrt(s.m_c, s.i_u));
    let ps = mulDiv(vo.targetVega.vega, Q96, s_sum);
    // uint128 fit (SFPM positionSize width) + a degenerate-delivery refusal: ps == 0 means
    // the target is too small for this range to deliver ANY liquidity -- refuse rather than
    // mint an empty position that claims a vega.
    require(ps > 0);
    require(ps <= U128_MAX);
    ps
};

// vol_order_to_mint: the V2 codomain. Layer-1 tokenId + the PINNED asset = 1 on all legs +
// the DeltaQ_v*-derived positionSize. iota <= 4 legs is structural (layer 1 always emits 4).
const vol_order_to_mint = fn (vo: VolOrder(calldata), pool_id: u256) MintPlan {
    let base = vol_order_to_panoptic_token_id(calldata, vo, pool_id);
    let mut tid = base.tokenId;
    // asset = 1 (token1 = the vega numeraire). panoptic_add_asset is additive-shl; the
    // layer-1 word has these bits at 0, so the adds are exact bit-sets.
    tid = panoptic_add_asset(tid, 1, 0);
    tid = panoptic_add_asset(tid, 1, 1);
    tid = panoptic_add_asset(tid, 1, 2);
    tid = panoptic_add_asset(tid, 1, 3);

    MintPlan {
        token_id: PanopticTokenId { tokenId: tid, num_legs: 4 },
        position_size: position_size_for_target_vega(vo)
    }
};

const LegLiquidities = struct { l0: u256, l1: u256, l2: u256, l3: u256 };

// The INDUCED per-leg profile (what Panoptic's chunk derivation will deploy for this plan):
// L_k = mulDiv(positionSize, Q96, dsqrt_k) -- getLiquidityForAmount1 restated.
const induced_leg_liquidities = fn (vo: VolOrder(calldata)) LegLiquidities {
    let s = vol_order_leg_split(vo);
    let ps = position_size_for_target_vega(vo);
    LegLiquidities {
        l0: mulDiv(ps, Q96, leg_dsqrt(s.i_l, s.m_p)),
        l1: mulDiv(ps, Q96, leg_dsqrt(s.m_p, s.i_star)),
        l2: mulDiv(ps, Q96, leg_dsqrt(s.i_star, s.m_c)),
        l3: mulDiv(ps, Q96, leg_dsqrt(s.m_c, s.i_u))
    }
};

// The EXPLICIT average-density per-leg chunks (the #14 decision of record,
// size_k = L_bar * w_k / n_k with L_bar = DeltaQ_v*, w_k the geometric leg masses, n_k the
// leg's column count): the LDF-side realization the lens computes against. The COUPLING
// TEST compares this profile to the induced one.
const average_density_chunks = fn (vo: VolOrder(calldata)) LegLiquidities {
    let s = vol_order_leg_split(vo);
    let w = geometric_leg_weights(s.i_l, s.i_u, s.ts, s.i_star, s.m_p, s.m_c);
    let tv = vo.targetVega.vega;
    let n0 = (s.m_p -% s.i_l) </ s.ts;
    let n1 = (s.i_star -% s.m_p) </ s.ts;
    let n2 = (s.m_c -% s.i_star) </ s.ts;
    let n3 = (s.i_u -% s.m_c) </ s.ts;
    LegLiquidities {
        l0: mulDiv(tv, w.w0, Q96) </ n0,
        l1: mulDiv(tv, w.w1, Q96) </ n1,
        l2: mulDiv(tv, w.w2, Q96) </ n2,
        l3: mulDiv(tv, w.w3, Q96) </ n3
    }
};
