// CR-I2 Layer 2 (= CR-I3, weight-vector portion): geometric leg weights for the 4-leg tokenId that
// Layer 1 builds. A leg over columns [c_lo, c_hi) carries the normalized geometric mass
// cum(c_hi) - cum(c_lo), with cum = geometric_cumulative_density_x96 and ratio xi* = 1.0001^(-Δ/2).
// "Longing options = providing liquidity" -- these weights are the Carr-Madan / Demeterfi replication
// (GeomProfile.geomWeight_sum / logContractLiquidity_geometric). Mint SIZING (LiquidityChunk /
// positionSize) and optionRatio quantization remain LATER increments; CR-I3's sized deliverable stays
// open. See .planning/cr-i2-layer2-geometric-weights-SPEC.md.

import lib::math::FixedPointMath::rpow;
import v3::math::full_math::mulDiv;
import v3::math::tick_math::getSqrtRatioAtTick;
import types::Numerics::{Q96};
import std::error::require;

const LegWeights = struct { w0: u256, w1: u256, w2: u256, w3: u256 };

// geometric_leg_weights: the 4 legs' normalized geometric masses (Q96) over the CR-I2 sub-bucket
// tiling of [i_l, i_u] split at (m_p, i_star, m_c). Takes the split points as inputs (the caller uses
// the SHARED vol_order_split_points, so the columns line up with the emitted legs -- resolves the
// review BLOCKER). xi* = getSqrtRatioAtTick(-Δ) = 1.0001^(-Δ/2) < Q96 always. Sum == Q96 EXACTLY:
// the weights telescope off shared endpoints (0, cum1, cum2, cum3, Q96) and the interior roundings
// cancel. den = (1 - xi^iota) computed once. Ordering guard reverts on a non-monotone column set so a
// Layer-1 boundary bug surfaces as a revert, not a 2^256 leg.
const geometric_leg_weights = fn (i_l: u256, i_u: u256, tickSpacing: u256, i_star: u256, m_p: u256, m_c: u256) LegWeights {
    let xi = getSqrtRatioAtTick(0 -% tickSpacing);
    let iota = (i_u -% i_l) </ tickSpacing;
    let c1 = (m_p -% i_l) </ tickSpacing;
    let c2 = (i_star -% i_l) </ tickSpacing;
    let c3 = (m_c -% i_l) </ tickSpacing;
    // 0 = c0 <= c1 <= c2 <= c3 <= c4 = iota  (unsigned; boundaries are in-support so < 2^24)
    require((c1 <= c2) and (c2 <= c3) and (c3 <= iota));

    let den = Q96 -% rpow(xi, iota, Q96);          // (1 - xi^iota); > 0 for xi < Q96, iota >= 1
    let cum1 = mulDiv(Q96 -% rpow(xi, c1, Q96), Q96, den);
    let cum2 = mulDiv(Q96 -% rpow(xi, c2, Q96), Q96, den);
    let cum3 = mulDiv(Q96 -% rpow(xi, c3, Q96), Q96, den);

    LegWeights { w0: cum1, w1: cum2 -% cum1, w2: cum3 -% cum2, w3: Q96 -% cum3 }
};
