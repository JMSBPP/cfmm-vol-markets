import std::constructor::return_runtime;
import lib::LiquidityAmounts::*;
import types::ldf::LDFParams::*;
import types::ldf::LiquidityChunk::*;
import types::PriceCoordinate::*;
import types::Portafolio::*;

// cast sig "portafolioForLiquidity(int24,int24,int24,uint256,uint256)" -> 0x8525e29a
const SEL_PFL = 0x8525e29a;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // portafolioForLiquidity(minTick@4, tickSpacing@36, length@68, alphaX96@100, liquiditySize@132)
    if selector == SEL_PFL {
        let ldf_params = ldf_geometric_params(@evm_calldataload(4), @evm_calldataload(100), @evm_calldataload(68));
        let coord = price_coordinate(@evm_calldataload(36), 0, 96);
        let liquidity = LiquidityChunk { size: @evm_calldataload(132), ldf_params: ldf_params };
        let p = portafolio_for_liquidity(coord, liquidity);
        // ABI tuple (uint256 grossOutput, uint256 grossInput) = 64 bytes
        let out = @malloc_uninit(64);
        @mstore32(out, p.gross_output_amt);
        @mstore32(out +% 32, p.gross_input_amt);
        @evm_return(out, 64);
    }

    @evm_stop();
}
