import std::constructor::return_runtime;

// CallbackRealizedVolatilityMod — the destination the MarketStateSocket forwards price updates to.
// For now onPriceUpdate ACKs by recording the last receipt (readable via lastUpdate). The real body
// will write a timepoint (tick, timestamp) into the RealizedVolatility oracle instead of just storing.

const SLOT_LAST_POOL_ID = 0;
const SLOT_LAST_SQRT_P  = 1;
const SLOT_LAST_TICK    = 2;
const SLOT_COUNT        = 3;

// onPriceUpdate(bytes32,uint160,int24) -> 0x675f5c35
const SELECTOR_ON_PRICE_UPDATE = 0x675f5c35;
// lastUpdate() -> (bytes32,uint160,int24,uint256) -> 0xc0463711
const SELECTOR_LAST_UPDATE     = 0xc0463711;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    if selector == SELECTOR_ON_PRICE_UPDATE {
        // onPriceUpdate(poolId@4, sqrtPriceX96@36, tick@68): ACK receipt + bump count.
        // Placeholder for the real RealizedVol timepoint write (tick, block.timestamp).
        @evm_sstore(SLOT_LAST_POOL_ID, @evm_calldataload(4));
        @evm_sstore(SLOT_LAST_SQRT_P,  @evm_calldataload(36));
        @evm_sstore(SLOT_LAST_TICK,    @evm_calldataload(68));
        @evm_sstore(SLOT_COUNT, @evm_sload(SLOT_COUNT) +% 1);
        @evm_stop();
    }

    if selector == SELECTOR_LAST_UPDATE {
        // lastUpdate() -> (bytes32 poolId, uint160 sqrtPriceX96, int24 tick, uint256 count)
        let out = @malloc_uninit(128);
        @mstore32(out,       @evm_sload(SLOT_LAST_POOL_ID));
        @mstore32(out +% 32, @evm_sload(SLOT_LAST_SQRT_P));
        @mstore32(out +% 64, @evm_sload(SLOT_LAST_TICK));
        @mstore32(out +% 96, @evm_sload(SLOT_COUNT));
        @evm_return(out, 128);
    }

    @evm_stop();
}
