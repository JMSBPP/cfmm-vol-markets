import std::constructor::return_runtime;

// CallbackRealizedVolatilityMod — the destination the MarketStateSocket forwards price updates to.
// Reactive callbacks receive the RVM id (deployer) as arg0, injected by the callback proxy, so
// onPriceUpdate takes `rvmSender` first. For now it ACKs by recording the last receipt (readable via
// lastUpdate); the real body will write a timepoint (tick, timestamp) into the RealizedVolatility
// oracle instead. rvmSender authentication is deferred (accepted and stored, not yet checked).

const SLOT_LAST_RVM     = 0;
const SLOT_LAST_POOL_ID = 1;
const SLOT_LAST_SQRT_P  = 2;
const SLOT_LAST_TICK    = 3;
const SLOT_COUNT        = 4;

// onPriceUpdate(address,bytes32,uint160,int24) -> 0x88a95317
const SELECTOR_ON_PRICE_UPDATE = 0x88a95317;
// lastUpdate() -> (bytes32,uint160,int24,uint256) -> 0xc0463711
const SELECTOR_LAST_UPDATE     = 0xc0463711;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    if selector == SELECTOR_ON_PRICE_UPDATE {
        // onPriceUpdate(rvmSender@4, poolId@36, sqrtPriceX96@68, tick@100): ACK receipt + bump count.
        // Placeholder for the real RealizedVol timepoint write (tick, block.timestamp).
        @evm_sstore(SLOT_LAST_RVM,     @evm_calldataload(4));
        @evm_sstore(SLOT_LAST_POOL_ID, @evm_calldataload(36));
        @evm_sstore(SLOT_LAST_SQRT_P,  @evm_calldataload(68));
        @evm_sstore(SLOT_LAST_TICK,    @evm_calldataload(100));
        @evm_sstore(SLOT_COUNT, @evm_sload(SLOT_COUNT) +% 1);
        @evm_stop();
    }

    if selector == SELECTOR_LAST_UPDATE {
        // lastUpdate() -> (bytes32 poolId, uint160 sqrtPriceX96, int24 tick, uint256 count)
        let out = @malloc_uninit(128);
        @mstore32(out,       @evm_sload(SLOT_LAST_POOL_ID));
        @mstore32(out +% 32, @evm_sload(SLOT_LAST_SQRT_P));
        @mstore32(out +% 64, @evm_sload(SLOT_LAST_TICK));
        @mstore32(out +% 96, @evm_sload(SLOT_COUNT));
        @evm_return(out, 128);
    }

    @evm_stop();
}
