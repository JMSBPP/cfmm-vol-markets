import std::constructor::return_runtime;
import helpers::PriceUpdateLogWithSwap::emit_price_update_swap;

// PriceSetterHook (Plank) — the price-setter used to drive the reactive experiment rig. Its
// write_price entrypoint moves the price by emitting a Swap (via the TEST helper
// PriceUpdateLogWithSwap) so MarketStateSocket has an event to react to -- NO real swap. The
// stateful price-to-state write is a future addition; today write_price is the reactive origin.

// write_price(bytes32,uint160,int24) -> 0x1864e57d
const SELECTOR_WRITE_PRICE = 0x1864e57d;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    
    if selector == SELECTOR_WRITE_PRICE {
        // write_price(poolId@4, sqrtPriceX96@36, tick@68): emit the Swap that moves the price.
        emit_price_update_swap(@evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68));
        @evm_stop();
    }

    @evm_stop();
}
