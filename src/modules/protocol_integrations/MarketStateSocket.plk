import std::constructor::return_runtime;

// MarketStateSocket — lives on the Reactive Network. startSocket subscribes to a univ4 pool's Swap
// event; react() forwards each Swap's price update to the registered callback via a Callback event
// (relayed by the callback proxy to the destination chain). SYSTEM_CONTRACT is the canonical reactive
// system contract (0x...fffFfF), mock-etched in tests.

const SYSTEM_CONTRACT = 0xfffFfF;
const SWAP_TOPIC0     = 0x40e9cecb9f5f1f1c5b9c97dec2917b7ee92e57ba5563708daca94dd84ad7112f;
const REACTIVE_IGNORE = 0xa65f96fc951c35ead38878e0f0b7a3c744a6f5ccc1476b313353ce31712313ad;

// Callback(uint256 indexed,address indexed,uint64 indexed,bytes) topic0
const CALLBACK_TOPIC0 = 0x8dd725fa9d6cd150017ab9e60318d40616439424e2fade9c1c58854950917dfc;
// onPriceUpdate(address,bytes32,uint160,int24) -> the destination selector the Callback payload targets
const ON_PRICE_UPDATE = 0x88a95317;
const DEST_CHAIN      = 8453;      // Base (where the pool + RealizedVol callback live)
const CALLBACK_GAS    = 1000000;   // 1M -- ample for the callback's few sstores

const SLOT_CALLBACK = 0;

// subscribe(uint256,address,uint256,uint256,uint256,uint256) -> 0x5a6aced0
const SELECTOR_SUBSCRIBE    = 0x5a6aced0;
// startSocket(uint256,address,bytes32) -> 0xe64a8dcb
const SELECTOR_START_SOCKET = 0xe64a8dcb;
// setCallback(address) -> 0x8daa63ac
const SELECTOR_SET_CALLBACK = 0x8daa63ac;
// react((uint256,address,uint256,uint256,uint256,uint256,bytes,uint256,uint256,uint256,uint256,uint256)) -> 0x0d152c2c
const SELECTOR_REACT        = 0x0d152c2c;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    if selector == SELECTOR_SET_CALLBACK {
        // setCallback(callback@4): register the destination the socket forwards to.
        @evm_sstore(SLOT_CALLBACK, @evm_calldataload(4));
        @evm_stop();
    }

    if selector == SELECTOR_START_SOCKET {
        let chain_id     = @evm_calldataload(4);
        let pool_manager = @evm_calldataload(36);
        let pool_id      = @evm_calldataload(68);

        // subscribe(chain_id, poolManager, Swap topic0, poolId, IGNORE, IGNORE): 4 + 6*32 = 196 bytes
        let buf = @malloc_uninit(196);
        @mstore4(buf, SELECTOR_SUBSCRIBE);
        @mstore32(buf +% 4,   chain_id);
        @mstore32(buf +% 36,  pool_manager);
        @mstore32(buf +% 68,  SWAP_TOPIC0);
        @mstore32(buf +% 100, pool_id);
        @mstore32(buf +% 132, REACTIVE_IGNORE);
        @mstore32(buf +% 164, REACTIVE_IGNORE);
        @evm_call(@evm_gas(), SYSTEM_CONTRACT, 0, buf, 196, buf, 0);
        @evm_stop();
    }

    if selector == SELECTOR_REACT {
        // react(LogRecord): LogRecord has a dynamic member (bytes data), so the struct is a DYNAMIC
        // tuple -> calldata is: selector@0, tuple-offset@4, tuple@(4+offset). Head words (rel. to
        // tuple base t): chain_id@0, _contract@32, topic_0@64, topic_1@96, topic_2@128, topic_3@160,
        // data-offset@192 (rel. to t), then block_number@224 ...
        let t          = 4 +% @evm_calldataload(4);    // tuple base
        let pool_id    = @evm_calldataload(t +% 96);   // topic_1
        let data_rel   = @evm_calldataload(t +% 192);  // offset to the bytes data, rel. to t
        let data_start = t +% data_rel +% 32;          // skip the bytes-length word
        // Swap non-indexed data: (amount0, amount1, sqrtPriceX96, liquidity, tick, fee)
        let sqrt_p = @evm_calldataload(data_start +% 64);
        let tick   = @evm_calldataload(data_start +% 128);

        let callback = @evm_sload(SLOT_CALLBACK);

        // Callback event data = abi.encode(bytes payload), payload =
        //   onPriceUpdate(rvmSender=0 placeholder, poolId, sqrtPriceX96, tick) = 4 + 4*32 = 132 bytes.
        // Encoding: [offset 0x20][len 132][payload padded to 160] = 224 bytes.
        let out = @malloc_uninit(224);
        @mstore32(out +% 192, 0);                       // zero the trailing pad word (196..224); tick overwrites 192..196
        @mstore32(out,        0x20);                     // offset to the bytes
        @mstore32(out +% 32,  132);                      // payload length
        @mstore4 (out +% 64,  ON_PRICE_UPDATE);          // payload: selector
        @mstore32(out +% 68,  0);                        //          rvmSender placeholder (proxy overwrites)
        @mstore32(out +% 100, pool_id);                  //          poolId
        @mstore32(out +% 132, sqrt_p);                   //          sqrtPriceX96
        @mstore32(out +% 164, tick);                     //          tick
        @evm_log4(out, 224, CALLBACK_TOPIC0, DEST_CHAIN, callback, CALLBACK_GAS);
        @evm_stop();
    }

    @evm_stop();
}
