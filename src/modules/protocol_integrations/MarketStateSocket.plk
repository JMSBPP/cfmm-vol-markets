      // todo: It subscribes to the Swap event. The market ID has a MarketIdEventsLib which
      // from the type, it offers the risght topic 0
      // todo: Use type annotaions
      // note: For the UniV4 price_update_event == Swap 
      let price_update_topic0::bytes4 = price_update_event(marketId);
    
      // todo Call the system contract on the subscribe event
};

const stop_socket = fn(marketId: MarketId)  never {
      require(unpack_market_state_socket_liveness(@evm_sload(SLOT_MARKET_STATE_SOCKET_LIVENESS)).initialized);
      
};

