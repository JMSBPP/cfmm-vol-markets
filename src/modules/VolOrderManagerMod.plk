import std::constructor::return_runtime;
import std::core::addr::{msg_sender, addr, cast_addr};
import std::membytes::membytes_write;
import std::abi::abi_encode;
import std::type::sizeof;

// todo: This is provisional, real type is more typed checked and has non primitive argument types
const VolOrder = struct {
       volTarget: u256,
       rangeWidth: u256,
       skew: u256
};

// signature:: event OrderCreated(address indexed owner, uint32 indexed timestamp, bytes encodedVolOrder)
const TOPIC_ORDER_CREATED = 0xa8892769;

// signature:: create_order(uint88,uint24,uint16)
const SELECTOR_CREATE_ORDER = 0x6501fe94;


// todo: This fn will have difernt types as they are devloped on feat/plank
const log_create_order = fn(
    owner: addr,
    blockTimestamp: u256,
    volTarget: u256,
    rangeWidth: u256,
    skew: u256
) void {
    let log_data = @malloc_uninit(160);

    @mstore32(log_data, 32);       
    @mstore32(log_data +% 32, 96);

    @mstore32(log_data +% 64, volTarget & 0xffffffffffffffffffffff);
    @mstore32(log_data +% 96, rangeWidth & 0xffffff);
    @mstore32(log_data +% 128, skew & 0xffff);

    @evm_log3(log_data, 160, TOPIC_ORDER_CREATED, cast_addr(owner, u256), blockTimestamp);
};

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    if selector == SELECTOR_CREATE_ORDER {
       let volTarget = @evm_calldataload(4);
       let rangeWidth = @evm_calldataload(36);
       let skew = @evm_calldataload(68);
       
       log_create_order(msg_sender(), @evm_timestamp() & 0xFFFFFFFF ,volTarget, rangeWidth, skew);  
    }
    @evm_stop();
}
init {
     return_runtime();
}