import std::constructor::return_runtime;
import v3::util::{return_u256, revert_empty};
import std::error::require;
import types::premium::AlgebraFeeConfiguration::*;
import lib::premium::AdaptiveFee::{get_fee, validate_fee_configuration};
import interfaces::premium::DynamicFeeInterface::*;

// DynamicFeeMod -- owner-gated port of @cryptoalgebra/dynamic-fee-plugin DynamicFeePluginImplementation.
// Stores a packed u144 fee config; getCurrentFee(volatility) = base_fee + sigmoid1 + sigmoid2 (the fee
// accrued as premium when building on Panoptic via v4 hooks). Volatility is PASSED IN (the caller
// sources it from RealizedVolatilityMod.getAverageVolatility). See
// .planning/premium-dynamic-fee-module-SPEC.md.
//
// SECURITY: the reference impl has no access control because it is delegatecall'd from a gating
// connector -- which we do NOT port. This module therefore ADDS an owner gate (TOFU: first
// initializeDynamicFee caller becomes owner) on the config setters. getters are open.
//
// HAZARD: before initializeDynamicFee, the config is zero, so getCurrentFee returns base_fee = 0 --
// positions accrue NO premium. The deployer MUST initialize before any pool relies on this, and the
// calling hook SHOULD assert owner() != 0 (initialized) first.

// keccak256("DynamicFeeMod.FeeConfig")
const SLOT_FEE_CONFIG = 0xe5761e8cd317c4d597677269dd64759154936fc4e5dc5b7a81ad6459211b6ce8;
// keccak256("DynamicFeeMod.Owner")
const SLOT_OWNER = 0xc99ba5be4e6b931a7c55d648195bb699713c86a8b8de473f5ba33d9db41b160d;

const MASK_U88 = 0xffffffffffffffffffffff;
const MASK_ADDR = 0xffffffffffffffffffffffffffffffffffffffff;

// Build a config from the 7 calldata words, EACH masked to declared width (Solidity's ABI decoder
// delivers clean uintN; Plank gets raw words, so we clean here BEFORE validate -- else a dirty-high
// gamma with low-16 == 0 passes validate then packs to 0 -> silent DIV-by-zero in sigmoid).
const config_from_calldata = fn () AlgebraFeeConfiguration {
    AlgebraFeeConfiguration {
        alpha1: @evm_calldataload(4) & 0xffff,
        alpha2: @evm_calldataload(36) & 0xffff,
        beta1: @evm_calldataload(68) & 0xffffffff,
        beta2: @evm_calldataload(100) & 0xffffffff,
        gamma1: @evm_calldataload(132) & 0xffff,
        gamma2: @evm_calldataload(164) & 0xffff,
        base_fee: @evm_calldataload(196) & 0xffff
    }
};

// store a validated config (shared by initialize + change)
const store_config = fn (cfg: AlgebraFeeConfiguration) void {
    validate_fee_configuration(cfg);
    @evm_sstore(SLOT_FEE_CONFIG, algebra_fee_config_pack(cfg));
};

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    if selector == SELECTOR_INITIALIZE_DYNAMIC_FEE {
        // owner TOFU: first caller becomes owner; afterwards only the owner may re-initialize.
        let owner = @evm_sload(SLOT_OWNER);
        if owner == 0 {
            @evm_sstore(SLOT_OWNER, @evm_caller() & MASK_ADDR);
        } else {
            require((@evm_caller() & MASK_ADDR) == owner);
        }
        store_config(config_from_calldata());
        @evm_stop();

    } else if selector == SELECTOR_CHANGE_FEE_CONFIGURATION {
        require((@evm_caller() & MASK_ADDR) == @evm_sload(SLOT_OWNER));
        store_config(config_from_calldata());
        @evm_stop();

    } else if selector == SELECTOR_GET_CURRENT_FEE {
        // getCurrentFee(uint88 volatilityAverage) -> uint16
        let vol = @evm_calldataload(4) & MASK_U88;
        let c = @evm_sload(SLOT_FEE_CONFIG);
        // short-circuit: both sigmoids disabled -> base_fee. Parenthesized -- Plank has no
        // Solidity-style |-vs-== precedence net (both operands u256).
        if (afc_alpha1(c) | afc_alpha2(c)) == 0 {
            return_u256(afc_base_fee(c));
        }
        return_u256(get_fee(vol, c));

    } else if selector == SELECTOR_GET_FEE_CONFIG {
        // getFeeConfig() -> 7 words (each field padded to 32 bytes, matching the Solidity tuple return)
        let c = @evm_sload(SLOT_FEE_CONFIG);
        let out = @malloc_uninit(224);
        @mstore32(out,        afc_alpha1(c));
        @mstore32(out +% 32,  afc_alpha2(c));
        @mstore32(out +% 64,  afc_beta1(c));
        @mstore32(out +% 96,  afc_beta2(c));
        @mstore32(out +% 128, afc_gamma1(c));
        @mstore32(out +% 160, afc_gamma2(c));
        @mstore32(out +% 192, afc_base_fee(c));
        @evm_return(out, 224);

    } else if selector == SELECTOR_OWNER {
        return_u256(@evm_sload(SLOT_OWNER));
    }

    @evm_stop();
}
