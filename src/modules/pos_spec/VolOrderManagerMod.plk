import std::constructor::return_runtime;
import interfaces::pos_spec::VolOrderManagerInterface::*;
import lib::pos_spec::VolOrderValidationLib::{build_vol_order, validate_order_strict, validate_order};
import lib::events::VolEventsLib::{emit_vol_order_created};
import pos_spec::VolOrder::{pack_vol_order};
import v3::storage::{array_slot};
import v3::util::{return_u256, revert_empty};
import std::error::require;


// "VolOrderManagerMod.orderCount"
const SLOT_ORDER_COUNT = 0x92967cb44e7866428adae18aad4bf59a10fb8d4c189b2b0e8bfe6f2a2469b5c7;
// "VolOrderManagerMod.orders"   (the ARRAY BASE -- hashed again by array_slot, never written to)
const SLOT_ORDERS_BASE = 0x68fef5d6c1ef01f93bf897a4ffcaa37fbdc39061144008f6edd91f64b7b199cb;
const MAX_BATCH = 128;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    if selector == SELECTOR_CREATE_ORDER {
        let order = build_vol_order(
            @evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68), @evm_calldataload(100)
        );
        validate_order_strict(order);
        let id = @evm_sload(SLOT_ORDER_COUNT) + 1;
        @evm_sstore(array_slot(SLOT_ORDERS_BASE, id), pack_vol_order(order));
        @evm_sstore(SLOT_ORDER_COUNT, id);

        emit_vol_order_created(
            id, order.volStrike.vol, order.rangeWidth.width, order.skew.spread, order.targetVega.vega
        );
        @evm_stop();

    } else if selector == SELECTOR_ORDER_COUNT {
        return_u256(@evm_sload(SLOT_ORDER_COUNT));

    } else if selector == SELECTOR_GET_ORDER_PACKED {
        return_u256(@evm_sload(array_slot(SLOT_ORDERS_BASE, @evm_calldataload(4))));

    } else if selector == SELECTOR_CREATE_ORDERS {
        let count = @evm_calldataload(4);
        require(count <= MAX_BATCH);
        require(@evm_calldataload(36) == 0x40);
        require(@evm_calldataload(68) == count);
        require(@evm_calldatasize() >= 100 + 32 * count);
      	let out = @malloc_zeroed(64 + 64 * count);
        @mstore32(out +% 0, 0x20);
        @mstore32(out +% 32, count);

        let mut i = 0;
        let mut id = @evm_sload(SLOT_ORDER_COUNT);
        while i < count {
            let word = @evm_calldataload(100 + i * 32);
            let order = build_vol_order(
                @evm_shr(16, word) & 0xFFFFFFFFFFFFFFFFFFFFFF,
                @evm_shr(104, word) & 0xFFFFFF,
                word & 0xFFFF,
                @evm_shr(128, word)
            );

            let base = 64 + 64 * i;

            if validate_order(order) {
                id = id + 1;
                @evm_sstore(array_slot(SLOT_ORDERS_BASE, id), pack_vol_order(order));
                emit_vol_order_created(
                    id, order.volStrike.vol, order.rangeWidth.width, order.skew.spread, order.targetVega.vega
                );
                @mstore32(out +% base, 1);
                @mstore32(out +% (base + 32), id);
            } else {
                // A FAILED TUPLE IS EXACTLY (false, 0). Not (false, id), not a skipped slot.
                @mstore32(out +% base, 0);
                @mstore32(out +% (base + 32), 0);
            }
            i = i + 1;
        }
       	@evm_sstore(SLOT_ORDER_COUNT, id);
        @evm_return(out, 64 + 64 * count);
    }
    revert_empty();
}
