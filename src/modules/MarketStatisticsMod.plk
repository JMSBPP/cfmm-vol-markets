const initializeTWAP = fn(currentTimestamp :u256, tick :u256) never {
      let initRes = initialize_timepoint_buffer(currentTimestamp);
      @evm_sstore(SLOT_MARKET_STATISTICS_STATE, pack_market_statistics_state(INIT_STORAGE_INDEX,currentTimestamp,true));
};

const write_ss_index = fn(_ss_index:u256) void {

};

const write_last_timepoint_timestamp = fn(_last_timepoint_timestamp: u256) void {

};

const ss_index = fn() u256 {
      unpack_market_statistics_state(@evm_sload(SLOT_MARKET_STATISTICS_STATE)).ss_index;
};

const last_timepoint_timestamp = fn() u256 {
      unpack_market_statistics_state(@evm_sload(SLOT_MARKET_STATISTICS_STATE)).lastTimepointTimestamp;
};

const getTwapTick = fn(dt:u256, tick :u256, currentTimestamp) never {

let twapTick = _getTwapTick(dt,tick,currentTimestamp);
      let out_ptr = @malloc_uninit(32);
      @mstore32(out_ptr, twapTick);
      @evm_return(out_ptr, 32);
};

const _getTwapTick = fn(dt:u256, tick :u256, currentTimestamp) u256 {
            
};


const initialize_timepoint_buffer = fn (time: u256) MarketStatisticsInitResult {

    let slot = array_slot(SLOT_TIMEPOINT_BUFFER_BASE, INIT_STORAGE_INDEX);
    @evm_sstore(slot, pack_time_tick_observation(time, INIT_TICK_CUMMULATIVE, ping_initialized()));
    MarketStatisticsInitResult { currentSampleSize: MIN_SAMPLE_SIZE, nextTargetedSampleSize: MIN_SAMPLE_SIZE }
};

const read_tick_bounds_from_positions = fn(selector: u256) u256 {
    let ptr = @malloc_uninit(32);

    @mstore4(ptr, selector);

    let succ = @evm_staticcall(
        @evm_gas(),
        @evm_sload(SLOT_POSITIONS_STATE_ID),
        ptr,
        SELECTOR_SIZE,
        ptr,
        WORD_SIZE
    );

    if !succ { revert_empty(); }

    decode_int24(@mload32(ptr))
};

// TODO: This needs adjustments
const fetch_mean_tick =
      fn(ss_indexUpdated: u256, blockTimestamp: u256, prev_blockTimestamp: u256,
      tick:u256, prevTickCummulative :u256) u256 {
      		 let dt = @evm_sub(blockTimestamp, prev_blockTimestamp);
      		 int56 currentTickCumulative = @evm_add(prevTickCumulative, @evm_mul(tick, dt));
		 return @evm_div(@evm_sub(currentTickCumulative,prevTickCummulative),dt);
}

