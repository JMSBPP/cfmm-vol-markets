const write_timepoint = fn (
   ss_Index: u256,
   blockTimestamp: u256,
   tick: u256,
   currentSampleSize: u256,
   nextTargetedSampleSize: u256
 ) MarketStatisticsWriteResult {
     //  ==================================== SLOAD ======================
    let slot = array_slot(SLOT_OBSERVATIONS_BASE, ss_index);
    let prev_timepoint = unpack_time_tick_observation(@evm_sload(slot));
 
    // ============================== TIME =================================
    if prev_timepoint.blockTimestamp == blockTimestamp {
        return MarketStatisticsWriteResult { indexUpdated: ss_index, currentSampleSizeUpdated: currentSampleSize };
    }
    let prev_blockTimestamp = prev_timepoint.blockTimestamp
    let dt = blockTimestamp -% prev_blockTimestamp;
    
    // ===========================================================================

    // ========================== SAMPLE & SS_INDEX ==================================
    // TODO: This needs to be refactored on the type Size 
    let mut sampleSizeOnUpdate = currentSampleSize;
    if (nextTargetedSampleSize > currentSampleSize) and (ss_index == (currentSampleSize - 1)) {
        sampleSizeOnUpdate = nextTargetedSampleSize;
    }
    let ss_indexUpdated = (ss_index + 1) % sampleSizeOnUpdate;
    // ===============================================================================

    // =================================== TICK_CUMM_UPDATE ======================
    let tickCumulative = last.tickCumulative +% (tick *% dt);

    // ================================ TICK_MEAN_UPDATE ===================================
    let tickMean = fetch_mean_tick(
    	ss_index, ss_indexUpdated, blockTimestamp, prev_blockTimestamp, tick, tickCummulative);
    // ================================ TICK_MIN_UPDATE ===================================
    let tickMin = read_tick_bounds_from_positions(READ_TICK_MIN_SELECTOR);
    // ================================ TICK_MAX_UPDATE ====================================
    let tickMax = read_tick_bounds_from_positions(READ_TICK_MAX_SELECTOR);
    
    // ================================ REALIZED_TICK_VOL_UPDATE============================
    // TODO: placeholder
    let realizedTickVol = 0;
    // let realizedTickVol = fetch_realized_vol(dt, tickMean, tick);
    //======================================= SSTORE ================================= 
    let newSlot = array_slot(SLOT_OBSERVATIONS_BASE, ss_indexUpdated);
    @evm_sstore(
	newSlot,
	pack_time_tick_observation(
		blockTimestamp,tickCumulative,tickMean, tickMin,
		tickMax,realizedTickVol, ping_initialized()
	)
     );

    //======================================= RETURN =========================================
    MarketStatisticsWriteResult { indexUpdated: indexUpdated, currentSampleSizeUpdated: sampleSizeOnUpdate }
};


// TODO: This needs to be related with the sample size and encapsulated probably on its own type
const ssindex_grow = fn (current: u256, next: u256) u256 {
    if current == 0 { revert_empty(); }
    if next <= current { return current; }
    let mut i = current;
    while i < next {
        let slot = array_slot(SLOT_OBSERVATIONS_BASE, i);
        @evm_sstore(slot, 1); // set blockTimestamp to 1 to prevent fresh SSTOREs
        i = i + 1;
    }
    next
};

const fetch_tick_time_integrated = fn (time: u256, secondsAgo: u256, tick: u256, index: u256, cardinality: u256) TimeIntegratedTickBucket {
    if secondsAgo == 0 {
        let slot = array_slot(SLOT_OBSERVATIONS_BASE, index);
        let last = unpack(TimeTickObservation,@evm_sload(slot));
        let mut resultTickCumulative = last.tickCumulative;
        if last.blockTimestamp != time {
            let delta = time -% last.blockTimestamp;
            resultTickCumulative = last.tickCumulative +% (tick *% delta);
        }
        return TimeIntegratedTickBucket { tickCumulative: resultTickCumulative};
    }
    
    let target = time -% secondsAgo;
 
    // binary search or direct lookup
    let mut l = (index + 1) % cardinality;
    let mut r = l + cardinality - 1;
    let mut i = 0;

    // first check if target is at or after newest
    let newestSlot = array_slot(SLOT_OBSERVATIONS_BASE, index);
    let newest = unpack(TimeTickObservation,@evm_sload(newestSlot));
    if oracle_lte(time, newest.blockTimestamp, target) {
        if newest.blockTimestamp == target {
            return TimeIntegratedTickBucket { tickCumulative: newest.tickCumulative };
        } else {
            let delta = target -% newest.blockTimestamp;
            let tickCumulative = newest.tickCumulative +% (tick *% delta);
            return TimeIntegratedTickBucket { tickCumulative: tickCumulative };
        }
    }

    // check oldest
    let oldestSlot = array_slot(SLOT_OBSERVATIONS_BASE, l % cardinality);
    let mut oldest = unpack(TimeTickObservation ,@evm_sload(oldestSlot));
    if !oldest.initialized {
        oldest = unpack(TimeTickObservation, @evm_sload(array_slot(SLOT_OBSERVATIONS_BASE, 0)));
    }
    if !oracle_lte(time, oldest.blockTimestamp, target) {
        revert_empty();
    }

    // binary search
    let mut beforeOrAt = newest;
    let mut atOrAfter = newest;
    let mut found = false;
    while !found {
        i = (l + r) </ 2;
        beforeOrAt = unpack(TimeTickObservation,@evm_sload(array_slot(SLOT_OBSERVATIONS_BASE, i % cardinality)));
        if beforeOrAt.initialized {
            atOrAfter = unpack(TimeTickObservation, @evm_sload(array_slot(SLOT_OBSERVATIONS_BASE, (i + 1) % cardinality)));
            let targetAtOrAfter = oracle_lte(time, beforeOrAt.blockTimestamp, target);
            if targetAtOrAfter and oracle_lte(time, target, atOrAfter.blockTimestamp) {
                found = true;
            } else if !targetAtOrAfter {
                r = i - 1;
            } else {
                l = i + 1;
            }
        } else {
            l = i + 1;
        }
    }

    if target == beforeOrAt.blockTimestamp {
        return TimeIntegratedTickBucket { tickCumulative: beforeOrAt.tickCumulative };
    } else if target == atOrAfter.blockTimestamp {
        return TimeIntegratedTickBucket { tickCumulative: atOrAfter.tickCumulative  };
    } else {
        let observationTimeDelta = atOrAfter.blockTimestamp -% beforeOrAt.blockTimestamp;
        let targetDelta = target -% beforeOrAt.blockTimestamp;
        let tickCumulativeDelta = atOrAfter.tickCumulative -% beforeOrAt.tickCumulative;

        let tickCumulative = beforeOrAt.tickCumulative +% ((tickCumulativeDelta </ observationTimeDelta) *% targetDelta);
        return TimeIntegratedTickBucket { tickCumulative: tickCumulative };
    }
};


init {
      
     return_runtime();
}


run{

	let selector = @evm_shr(224, @evm_calldataload(0));
	if selector == SELECTOR_INITIALIZE_TWAP {
	   let mut blockTimestamp = @evm_calldataload(4);
	   let mut tick = @evm_calldataload(36);
	   blockTimestamp =
	   tick = 
	   initializeTWAP(blockTimestamp, tick);
	} else if selector == SELECTOR_GET_TWAP_TICK {
	       let mut dt = @evm_calldataload(4);
	       let mut tick = @evm_calldataload(36);
	       let mut blockTimestamp = @evm_calldataload(68);
	       dt = 
	       tick =
	       blockTimestamp =
	       getTwapTick(dt, tick, blockTimestamp);
	}

	@evm_stop();
}



