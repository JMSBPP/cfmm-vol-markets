const INIT_STORAGE_INDEX = 0;
// TODO: This next TWO go in a more generic utils file
const SELECTOR_SIZE = 4;
const WORD_SIZE = 32;
const ZERO_OFFSET = 0;
// keccak256("MarketStatistics.TimepointBuffer")
const SLOT_TIMEPOINT_BUFFER_BASE = 0xebcc1c85998b5d57b50ec9abef805c95e52fe44b384a65c3105984469083819e;

// keccak256("MarketStatistics.ImpliedStatsBuffer")
const SLOT_IMPLIED_STATS_BUFFER_BASE = 0x67ee822f163614d994d5baa76f89d7060161a55c849af93d19712d3f85b60c0c;

