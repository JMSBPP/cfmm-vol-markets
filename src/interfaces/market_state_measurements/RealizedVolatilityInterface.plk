// ABI selectors for RealizedVolatilityMod.
//
// These are NOT invented for the port: initializeTWAP and getTwapTick are the exact selectors
// Algebra's VolatilityOraclePluginImplementation is called with in
// test/MarketStatisticsTest.t.sol:86,91. Keeping the same ABI makes RealizedVolatilityMod
// call-compatible with MarketStatisticsAlgebraRef / MarketStatisticsUniV3Ref by construction,
// so ONE Solidity interface can drive all three implementations in the differential test.
//
// Values are keccak256(signature)[0:4].
//
// (This file was previously truncated mid-declaration -- `const SELECTOR_INITIALIZE_VOL_STATE`
// with no value and no terminator -- which is why every importer failed with "unexpected EOF".)

// signature:: initializeTWAP(uint32,int24)
const SELECTOR_INITIALIZE_TWAP = 0xed64c40a;

// signature:: writeTimepoint(uint32,int24)
const SELECTOR_WRITE_TIMEPOINT = 0xb09b2297;

// signature:: getTwapTick(uint32,int24,uint32) -> int24
const SELECTOR_GET_TWAP_TICK = 0x1a72d0df;

// signature:: getTickCumulative(uint32,int24,uint32) -> int56
// Not part of Algebra's plugin ABI; exposed because the raw accumulator is the most primitive
// quantity Algebra and UniV3 share, and therefore the sharpest surface to diff on -- it
// isolates the ring search + interpolation from the averaging and rounding layered on top.
const SELECTOR_GET_TICK_CUMULATIVE = 0xec7136cd;

// signature:: getAverageVolatility(int24,uint32) -> uint88
const SELECTOR_GET_AVERAGE_VOLATILITY = 0x8171455c;
