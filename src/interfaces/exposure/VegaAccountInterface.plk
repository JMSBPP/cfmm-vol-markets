// ABI selectors for VegaAccountMod. Declared here so BOTH the module's dispatch constants AND
// the Solidity test ABI (test/exposure/VegaAccount.t.sol) are computed from the SAME signature
// strings -- an unpinned string means the differential never even dispatches. Values are
// keccak256(signature)[0:4], recomputed with `cast sig` (never hand-derived).
//
// Type convention: every quantity is an UNSIGNED u256 -- a collateral counter, a Q64.96 price,
// a Q0.96 haircut. Signature strings use `uint256`; the module reads whole 32-byte calldata
// words with no masking (no sub-word packing, no sign extension). This matches the Phase-13
// VegaIssuanceKernelHarness precedent.

// signature:: deposit(uint256)                  (collateralAmt; write, ends @evm_stop)
const SELECTOR_DEPOSIT = 0xb6b55f25;

// signature:: setRiskPrice(uint256)             (pRiskX96; write, reverts on 0, ends @evm_stop)
const SELECTOR_SET_RISK_PRICE = 0x647b5b63;

// signature:: previewDeposit(uint256) -> uint256    (pure issuance, no state change)
const SELECTOR_PREVIEW_DEPOSIT = 0xef8b30f7;

// signature:: previewRiskPrice(uint256,uint256) -> uint256   (oracleX96, hX96; H1 p_risk, h<1 via lib)
const SELECTOR_PREVIEW_RISK_PRICE = 0x2d3436e3;

// State readers -- every stored field is exposed so the module is not a black box and
// quotient-only assertions are impossible by construction.
// signature:: totalDeposits() -> uint256
const SELECTOR_TOTAL_DEPOSITS = 0x7d882097;
// signature:: totalShares() -> uint256
const SELECTOR_TOTAL_SHARES = 0x3a98ef39;
// signature:: riskWeightedShares() -> uint256
const SELECTOR_RISK_WEIGHTED_SHARES = 0x3a2594b5;
// signature:: riskPrice() -> uint256
const SELECTOR_RISK_PRICE = 0xd04266d9;
