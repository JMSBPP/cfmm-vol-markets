use std::constructor::return_runtime;

use std::membytes::{
    membytes_new, membytes, membytes_write, membytes_read_u256
};

use custom_utils::protocol_integrations::ReactiveConsumer::{
    SYSTEM, BLACKLIST_CONTRACT_TOPIC0, SUBSCRIBE_SELECTOR, REACTIVE_IGNORE,
    DEBT_SELECTOR
};

use custom_utils::math::max;


use std::option::unwrap;

use custom_utils::gas::{
    Gas, evmGas
};

use custom_utils::unmerged_std::event::emit;


use custom_utils::economics::price::{
    UnitPrice, NullPriceMultiplier, PriceMultiplier
};

use custom_utils::economics::quantity::{
    Overhead, NoOverhead
};

use custom_utils::economics::cost::{
    Cost, Free, NeqCost
};

use std::core::ops::less_equals;

// 11124600000000000
// 419893838200000000000
const ReactiveGasLimit = fn() Gas { 900000};

const ReactiveGasOverhead = fn () Overhead {
      let mut resReactiveGasOverhead: Overhead = NoOverhead();
      let reactiveGasOverheadMemBuff: membytes = membytes_new(36);
      // cast sig "_extraGas()"
      @mstore4(reactiveGasOverheadMemBuff.ptr, 0xe5563728);
      if !@evm_staticcall(@evm_gas(),SYSTEM,reactiveGasOverheadMemBuff.ptr,4,reactiveGasOverheadMemBuff.ptr+%4,32) {
       // cast sig "FailedToQueryReactivePricingMultiplier()"
       @mstore4(reactiveGasOverheadMemBuff.ptr, 0x9df15aef);
       @evm_revert(reactiveGasOverheadMemBuff.ptr, 4);   
    }
    resReactiveGasOverhead = unwrap(membytes_read_u256(reactiveGasOverheadMemBuff,4));
    resReactiveGasOverhead
};



// \(c_{\texttt{reactive}} = p_{\text{base}} \cdot K_{\texttt{pricing}} \cdot ( g + K_{\texttt{extra}})\)
// TODO: This is to be better typed with the economics utils
const ReactiveCost = fn (g:Gas) Cost {
      let base: UnitPrice = max(@evm_basefee(), @evm_gasprice());
      let effectiveReactivePrice : u256 = @evm_mul(base,ReactivePricingMultiplier());
      let effectiveGasConsumption : u256 = @evm_add(g, ReactiveGasOverhead());
      let effectiveReactiveCost: u256 = @evm_mul(effectiveReactivePrice, effectiveGasConsumption);
      effectiveReactiveCost
};


const ReactivePricingMultiplier = fn () PriceMultiplier {
    let mut resReactivePricingMultilplier: PriceMultiplier = NullPriceMultiplier();
    let reactivePricingMultiplierMemBuff: membytes = membytes_new(36);
    // cast sig "_gasPriceCoeffPer1000()"
    @mstore4(reactivePricingMultiplierMemBuff.ptr, 0x2c16b16f);
    if !@evm_staticcall(@evm_gas(), SYSTEM,reactivePricingMultiplierMemBuff.ptr,4,reactivePricingMultiplierMemBuff.ptr+%4,32) {
       // cast sig "FailedToQueryReactivePricingMultiplier()"
       @mstore4(reactivePricingMultiplierMemBuff.ptr, 0x9df15aef);
       @evm_revert(reactivePricingMultiplierMemBuff.ptr, 4);   
    }
    resReactivePricingMultilplier = unwrap(membytes_read_u256(reactivePricingMultiplierMemBuff,4));
    resReactivePricingMultilplier
};

const MaxReactiveCost = fn () Cost { ReactiveCost(ReactiveGasLimit())};


const initialize_socket = struct {};

const ReactiveCostLog = struct {
      initialized: bool,
      owed: Cost
};

const LiveReactiveCostExt = fn( src: u256) Cost {
      let liveReactiveCostMemBuff: membytes = membytes_new(68);
      @mstore4(liveReactiveCostMemBuff.ptr, DEBT_SELECTOR);
      membytes_write(liveReactiveCostMemBuff,4,src);
      if !@evm_staticcall(@evm_gas(), SYSTEM, liveReactiveCostMemBuff.ptr,36,liveReactiveCostMemBuff.ptr+%36,32){
      	 // cast sig "FailedToFetchLiveReactiveCost()"      	 			     
      	 @mstore4(liveReactiveCostMemBuff.ptr,0x302e8fb6);
	 @evm_revert(liveReactiveCostMemBuff.ptr,4);
      }
      unwrap(membytes_read_u256(liveReactiveCostMemBuff,36))
};


const LiveReactiveCost = fn () Cost { LiveReactiveCostExt(@evm_address_this())};


const ReactiveCostSocket = fn (action: type) void {
     if action == initialize_socket {
     	let subscribeMemBuff: membytes = membytes_new(196);
     	@mstore4(subscribeMemBuff.ptr, SUBSCRIBE_SELECTOR);
     	membytes_write(subscribeMemBuff,4,@evm_chainid());
	membytes_write(subscribeMemBuff,36,SYSTEM);
	membytes_write(subscribeMemBuff,68,BLACKLIST_CONTRACT_TOPIC0);
	membytes_write(subscribeMemBuff,100, @evm_address_this());
	membytes_write(subscribeMemBuff,132, (REACTIVE_IGNORE, REACTIVE_IGNORE));
     	if !@evm_call(@evm_gas(), SYSTEM, @evm_selfbalance(), subscribeMemBuff.ptr,subscribeMemBuff.length,subscribeMemBuff.ptr+%subscribeMemBuff.length,0) {
	   			  // cast sig "ReactiveCostFailedToSubscribe()"
	    			  @mstore4(subscribeMemBuff.ptr,0xfa0788fc);
     				  }
        else {
	     emit(ReactiveCostLog{ initialized: true, owed: LiveReactiveCost()});
	}				  				  
     }				  
};

const reactive = struct {};
const callback = struct {};

const ServiceDisbursement = fn (comptime service: type) void {
          let settleDisbursementMemBuff: membytes = membytes_new(4);
    let liveCost: Cost = LiveReactiveCost();
    if less_equals(liveCost, @evm_selfbalance()) {
           if !@evm_call(@evm_gas(), SYSTEM, LiveReactiveCost(), settleDisbursementMemBuff.ptr,0,settleDisbursementMemBuff.ptr,0) {
	     // cast sig "FailedSubscriptionDisbursement()"
	     @mstore4(settleDisbursementMemBuff.ptr,0x3e80703e);
	     @evm_revert(settleDisbursementMemBuff.ptr,4);   }
    	  if NeqCost(LiveReactiveCost(),Free()){
	     // cast sig "InsufficientDisbursement()"
	     @mstore4(settleDisbursementMemBuff.ptr,0xb9a26969);
	     @evm_revert(settleDisbursementMemBuff.ptr,4);   }
    }
};


init {
     return_runtime();
}



run {
	let retReactiveCostMemBuff: membytes = membytes_new(32);
	membytes_write(retReactiveCostMemBuff,0,LiveReactiveCost());
	@evm_return(retReactiveCostMemBuff.ptr,32);
}