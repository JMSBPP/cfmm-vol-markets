use custom_utils::protocol_integrations::UniswapV4Consumer::POOL_MANAGER_SLOT;

// cast keccak vol-markets.Panoptic.SemiFungiblePositionManager
const POSITION_MANAGER_SLOT = 0x5d183a17afb73127be7710fe47c9fb9e2c293dd8bf1313365406b092a2c42880;

// cast sig "setPositionManager(address)"
const SET_POSITION_MANAGER_SELECTOR = 0x5760f2e3;

const VEGOID_DEFAULT = 2;

const SFPM_POOL_MANAGER_IMMUTABLE_OFFSET = 2013;

const poolManagerOnPositionManager = fn (positionManager: u256) u256 {
      let word: u256 = @malloc_uninit(32);
      @evm_extcodecopy(positionManager, word, SFPM_POOL_MANAGER_IMMUTABLE_OFFSET, 32);
      @mload32(word)
};

const storePositionManager = fn (positionManager: u256) void {
      let expected: u256 = @evm_sload(POOL_MANAGER_SLOT);
      let rev: u256 = @malloc_uninit(4);
      if expected == 0 {
      	 // cast sig "PoolManagerNotSet()"
      	 @mstore4(rev, 0x33069b04);
	 @evm_revert(rev, 4);
      }
      if poolManagerOnPositionManager(positionManager) != expected {
      	 // cast sig "PositionManagerPoolManagerMismatch()"
      	 @mstore4(rev, 0x432d688c);
	 @evm_revert(rev, 4);
      }
      @evm_sstore(POSITION_MANAGER_SLOT, positionManager);
};
