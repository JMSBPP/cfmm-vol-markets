use custom_utils::more_regions::storage;

// cast keccak vol-markets.Uniswap.PoolManager
const POOL_MANAGER_SLOT = 0x88a114aa1e554c058ec89d3e36fbd9461439057395b0516c7441f43f1154c823;

// =========================== INPUT: UniswapV4Consumer =================================

const uniswap = struct { consumer: u256 };

const consumer = fn (protocol: type, on: type) u256 {
      if protocol == uniswap {
      	 if on == storage {
      	      let u = uniswap { consumer: @evm_sload(POOL_MANAGER_SLOT) };
      	      @get_field(u, "consumer")
      	 }
      	 else {
      	      @compile_error("consumer: only storage");
      	 }
      }
      else {
      	 @compile_error("consumer: only uniswap");
      }
};

// ============================ OUTPUT: UniswapV4Consumer =================================

// cast sig "setPoolManager(address)"
const SET_POOL_MANAGER_SELECTOR = 0x7aef6715;

const POOLS_SLOT = 6;
// cast sig "extsload(bytes32)"
const EXTSLOAD_SELECTOR = 0x1e2eaeaf;

// Uniswap v4 Slot0: lpFee at bit 208
const LP_FEE_OFFSET = 208;

// Uniswap v4 PoolKey word indices (currency0=0, currency1=1)
const LP_FEE_POOL_KEY_IDX = 2;
const TICK_SPACING_POOL_KEY_IDX = 3;
const HOOK_POOL_KEY_IDX = 4;


// cast sig "sync(address)"
const SYNC_SELECTOR = 0xa5841194;
// cast sig "settle()"
const SETTLE_SELECTOR = 0x11da60b4;
// cast sig "settleFor(address)"
const SETTLE_FOR_SELECTOR = 0x3dd45adb;
// cast sig "take(address,address,uint256)"
const TAKE_SELECTOR = 0x0b0d9c09;

// cast sig "unlockCallback(bytes)"
const UNLOCK_CALLBACK_SELECTOR = 0x91dd7346;

// cast sig "unlock(bytes)"
const UNLOCK_SELECTOR = 0x48c89491;

// cast sig "swap((address,address,uint24,int24,address),(bool,int256,uint160),bytes)"
const UNISWAP_V4_SWAP_SELECTOR = 0xf3cd914c;

// cast keccak "Swap(bytes32,address,int128,int128,uint160,uint128,int24,uint24)"
const SWAP_TOPIC = 0x40e9cecb9f5f1f1c5b9c97dec2917b7ee92e57ba5563708daca94dd84ad7112f;

const storePoolManager = fn (poolManager: u256) void {
      @evm_sstore(POOL_MANAGER_SLOT,poolManager);
};

const loadPoolManager = fn () u256 {
      @evm_sload(POOL_MANAGER_SLOT)
};

