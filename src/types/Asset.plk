import std::addr::addr;
import types:GridGeometry::GridGeometry;

const AssetStock = struct {
      space: GridGeometry,
      amt: u256
};

const AssetFlow = struct {
      space: GridGeometry,
      delta: u256
};


const Asset = struct {
      id: addr,
      inventoryPtr: AssetStock,
      balancePtr: AssetFLow      
};