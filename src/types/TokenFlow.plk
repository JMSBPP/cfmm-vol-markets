import std::core::addr::addr;
import cfmm_types::Ray::Ray;
import types::SigmaF::SigmaF;
import types::WeinerGenerator::DeltaW;
import types::TokenAmountNetFlowStochasticBase::{
    intro_base,
    stock,
    magnitude,
    direction,
    TokenAmountNetFlowStochasticBase
};

const TokenFlow = fn () type {
    struct {
        amount: u256,
        dir: u256,
        token: addr,
        from: addr,
        to: addr
    }
};

/// intro(σ_F, ΔW(dt), token, from, to) = (magnitude(stock), direction(stock)) at those addresses.
/// Bridge until #152 full refine: amount/dir from TokenAmountStock.
const token_flow = fn (
    comptime dt: u256,
    sf: SigmaF(Ray),
    dw: DeltaW(dt),
    token: addr,
    from: addr,
    to: addr
) TokenFlow() {
    let base = intro_base(dt, sf, dw);
    let s = stock(dt, base);
    TokenFlow() {
        amount: magnitude(TokenAmountNetFlowStochasticBase(SigmaF(Ray), Ray, dt), s),
        dir: direction(TokenAmountNetFlowStochasticBase(SigmaF(Ray), Ray, dt), s),
        token: token,
        from: from,
        to: to
    }
};
