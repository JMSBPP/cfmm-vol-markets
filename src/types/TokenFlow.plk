import std::core::addr::addr;
import types::SigmaF::{SigmaF, token_amount};
import types::WeinerGenerator::{DeltaW, is_neg_signed};

const TokenFlow = fn () type {
    struct {
        amount: u256,
        dir: u256,
        token: addr,
        from: addr,
        to: addr
    }
};

/// intro(σ_F, ΔW(dt), token, from, to) = (TokenAmount, Dir) at those addresses.
/// Dir 0 = +, 1 = −. dt is the DeltaW index.
const token_flow = fn (
    comptime dt: u256,
    sf: SigmaF(),
    dw: DeltaW(dt),
    token: addr,
    from: addr,
    to: addr
) TokenFlow() {
    let dir = if is_neg_signed(dw.val) { 1 } else { 0 };
    TokenFlow() {
        amount: token_amount(dt, sf, dw),
        dir: dir,
        token: token,
        from: from,
        to: to
    }
};
