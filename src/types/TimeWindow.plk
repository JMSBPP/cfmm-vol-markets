// TimeWindow -- the trailing observation window the realized-volatility oracle
// averages over, in SECONDS.
//
// Algebra's VolatilityOracle fixes this at compile time (`uint32 constant WINDOW = 1 days`).
// Here it is a stored value instead, so the window can be tuned per market without a
// redeploy; RealizedVolatilityMod keeps it at SLOT_TIMEPOINT_BUFFER_WINDOW_SIZE and
// reads/writes it through read_window / write_window.
//
// `window` is logically a u32 (seconds since epoch deltas), carried in a u256 and masked
// to 32 bits on store, matching how Timepoint.timestamp is handled.
const TimeWindow = struct {
      window: u256 // u32
};

const WINDOW_MASK = 0xFFFFFFFF;

// One day, the same default Algebra ships with.
const DEFAULT_TIME_WINDOW = 86400;

const unpack_time_window = fn(packed: u256) TimeWindow {
      TimeWindow {
          window: packed & WINDOW_MASK
      }
};

const pack_time_window = fn(self: TimeWindow) u256 {
      self.window & WINDOW_MASK
};

const time_window_is_set = fn(self: TimeWindow) bool {
      self.window > 0
};
