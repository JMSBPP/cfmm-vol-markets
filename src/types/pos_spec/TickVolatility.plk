import types::Numerics::{WAD,Q64_96_RESOLUTION};
import v3::math::tick_math::getTickAtSqrtRatio;

const TickVolatility = struct {
      vol:u256
};

const tick_volatility_is_complete = fn(self:TickVolatility) bool {
      let res = self.vol > 0;
      res
};

const unpack_tick_volatility = fn(vol: u256) TickVolatility {
      TickVolatility{
		vol:vol
      }
};
const pack_tick_volatility = fn(self :TickVolatility) u256 {
      let res = self.vol;
      res
};

const volQ64X96 = fn(self: TickVolatility) TickVolatility {
      TickVolatility {
      		     // once it arrives is uint256 bounded to uint88 ideally
      		     vol: @evm_shl(Q64_96_RESOLUTION, self.vol)
      }
};

const volWAD = fn(self: TickVolatility) TickVolatility {
      TickVolatility {
      		     vol: @evm_mul(self.vol, WAD)
      }
};

const return_volQ64X96 = fn(self: TickVolatility) never {
      let res = volQ64X96(self);
      let out_ptr = @malloc_uninit(32);
      @mstore32(out_ptr, res.vol);
      @evm_return(out_ptr, 32);
};

const return_volWAD = fn(self: TickVolatility) never {
      let res = volWAD(self);
      let out_ptr = @malloc_uninit(32);
      @mstore32(out_ptr, res.vol);
      @evm_return(out_ptr, 32);
};

// sqrtPriceX64x96 of the vol strike; used until #100 replaces vol-on-ticks geometry.
const tick_volatility_sqrt_price_X64x96 = fn(self: TickVolatility) u256 {
    volQ64X96(self).vol
};

const tick_volatility_tick = fn(self: TickVolatility) u256 {
    getTickAtSqrtRatio(tick_volatility_sqrt_price_X64x96(self))
};