// note: This can use the return function for tickbuckert instead of its own
const tick_bucket_from_vol_order = fn(volOrder:VolOrder) TickBucket{
      // 1. get the tick for the volOrder
      let tick_volatility = tick_volatility_tick(volOrder.volStrike);      
      let bucket = split_tick(volOrder.skew, volOrder.rangeWidth, tick_volatility);
      bucket
};