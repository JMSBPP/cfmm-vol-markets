import pos_spec::TickUtils::{TickBucket, round_tick};
import pos_spec::VolRangeWidth::*;
import pos_spec::SpreadTickAssimetry::*;
import pos_spec::TickVolatility::*;
import pos_spec::VegaTarget::*;
import std::error::require;
import std::regions::calldata;
import std::option::{Option, Some, None};
import types::utils::Extra::{Extra, extra_none_payload};

const VolOrder = fn (comptime T: type) type {
    return struct {
        rangeWidth: VolRangeWidth,
        volStrike: TickVolatility,
        skew: SpreadTickAssimetry,
        targetVega: VegaTarget(0, 0, 0),
        extra: Option(Extra(T))
    };
};

// Attach a descriptor to an order. The four packed fields are untouched.
const vol_order_with_extra = fn (comptime T: type, vo: VolOrder(T), e: Extra(T)) VolOrder(T) {
    VolOrder(T) {
        rangeWidth: vo.rangeWidth,
        volStrike: vo.volStrike,
        skew: vo.skew,
        targetVega: vo.targetVega,
        extra: Some(e)
    }
};

const OFF_TARGET_VEGA = 152;
const MASK_U96_VO = 0xFFFFFFFFFFFFFFFFFFFFFFFF;

const return_vol_order_incomplete = fn(self:VolOrder(calldata)) never {
      let packed = pack_vol_order(self);
      let out_ptr = @malloc_uninit(32);
      @mstore32(out_ptr, packed);
      @evm_return(out_ptr,32);
};

const return_vol_order = fn (self:VolOrder(calldata)) never {
      vol_order_revert_incomplete(self);
      return_vol_order_incomplete(self);
};

const vol_order_is_complete = fn (volOrder :VolOrder(calldata)) bool {
      let res = (vol_range_width_is_complete(volOrder.rangeWidth)) & (spread_tick_assimetry_is_complete(volOrder.skew)) & (tick_volatility_is_complete(volOrder.volStrike)) & (vega_target_is_complete(volOrder.targetVega));
      res
};

const vol_order_revert_incomplete = fn(volOrder:VolOrder(calldata)) void {require(vol_order_is_complete(volOrder))};

// Masks are mechanical truncation AFTER validation (units-table rule 2): the width bounds
// live in the validation lib (strike_fits_packed / target_vega_fits_packed), so for every
// ACCEPTED order the mask is an identity -- pinned by the mask-identity fuzz in
// VolOrderTargetVega.t.sol.
const pack_vol_order = fn(self: VolOrder(calldata)) u256 {
    @evm_shl(OFF_TARGET_VEGA, pack_vega_target(self.targetVega) & MASK_U96_VO)
    | @evm_shl(128, self.rangeWidth.width & 0xFFFFFF)
    | @evm_shl(104, self.rangeWidth.tickSpacing & 0xFFFFFF)
    | @evm_shl(16, self.volStrike.vol & 0xFFFFFFFFFFFFFFFFFFFFFF)
    | (self.skew.spread & 0xFFFF)
};

const unpack_vol_order = fn(_packed: u256) VolOrder(calldata) {
    let width       = @evm_shr(128, _packed) & 0xffffff;
    let tickSpacing = @evm_shr(104, _packed) & 0xffffff;
    let volStrike   = @evm_shr(16, _packed) & 0xffffffffffffffffffffff;
    let skew        = _packed & 0xffff;
    let targetVega  = @evm_shr(OFF_TARGET_VEGA, _packed) & MASK_U96_VO;

    VolOrder(calldata) {
        rangeWidth: VolRangeWidth {
            width: width,
            tickSpacing: tickSpacing
        },
        volStrike: TickVolatility {
            vol: volStrike
        },
        skew: SpreadTickAssimetry {
            spread: skew
        },
        targetVega: unpack_vega_target(targetVega),
        extra: None(Extra(calldata))
    }
};

// note: This calls for type checks on each of the dependant types
const set_vol_order_vol_strike = fn(self: VolOrder(calldata), volStrike:TickVolatility) VolOrder(calldata) {
      VolOrder(calldata) {
      	       rangeWidth: self.rangeWidth,
	       volStrike: volStrike,
	       skew: self.skew,
	       targetVega: self.targetVega,
	       extra: self.extra
      }
};


const set_vol_order_skew = fn(self: VolOrder(calldata),skew:SpreadTickAssimetry) VolOrder(calldata) {
      VolOrder(calldata) {
      	       rangeWidth: self.rangeWidth,
	       volStrike: self.volStrike,
	       skew : skew,
	       targetVega: self.targetVega,
	       extra: self.extra
      }
};


const set_vol_order_range_width = fn(self: VolOrder(calldata),vol_range_width :VolRangeWidth) VolOrder(calldata) {
      VolOrder(calldata) {
      	       rangeWidth: vol_range_width,
	       volStrike: self.volStrike,
	       skew: self.skew,
	       targetVega: self.targetVega,
	       extra: self.extra
      }
};

const set_vol_order_target_vega = fn(self: VolOrder(calldata), target_vega: VegaTarget(0, 0, 0)) VolOrder(calldata) {
      VolOrder(calldata) {
      	       rangeWidth: self.rangeWidth,
	       volStrike: self.volStrike,
	       skew: self.skew,
	       targetVega: target_vega,
	       extra: self.extra
      }
};

// note: This can use the return function for tickbuckert instead of its own
// The ONE region-generic geometry read: the tick bucket of any VolOrder(T). It touches only the
// four packed fields, never `extra` -- the same property that keeps pack/unpack agnostic.
const tick_bucket_from_vol_order_in = fn(comptime T: type, volOrder: VolOrder(T)) TickBucket{
      // 1. get the tick for the volOrder
      let tick_volatility = tick_volatility_tick(volOrder.volStrike);
      let bucket = split_tick(volOrder.skew, volOrder.rangeWidth, tick_volatility);
      bucket
};

// The concrete wrapper its pre-Phase-2 callers keep using unchanged.
const tick_bucket_from_vol_order = fn(volOrder:VolOrder(calldata)) TickBucket{
      tick_bucket_from_vol_order_in(calldata, volOrder)
};

// Pure ladder span fields from a VolOrder — no venue, no Ladder(V).
// Mirrors Haskell ladderFromVolOrder's let-binding before ladderFromSpan.
const LadderGeometry = struct {
    lo: u256,
    hi: u256,
    star: u256,
    vega: u256
};

const vol_order_ladder_geometry = fn(comptime T: type, vo: VolOrder(T)) LadderGeometry {
    let ts = vo.rangeWidth.tickSpacing;
    let tb = tick_bucket_from_vol_order_in(T, vo);
    let star = round_tick(tick_volatility_tick(vo.volStrike), ts);
    LadderGeometry {
        lo: tb.low,
        hi: tb.up,
        star: star,
        vega: vega_amount(vo.targetVega)
    }
};
