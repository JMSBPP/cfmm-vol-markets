};

const add = fn(v1 :VolRangeWidth, v2VolRangeWidth: VolRangeWidth) VolRangeWidth {};
const sub = fn(v1 :VolRangeWidth, v2VolRangeWidth: VolRangeWidth) VolRangeWidth {};

