import v3::util::revert_R;
import v3::abi::decode_int24;


const Order = struct {
      tickLower : u256,
      tickUpper : u256,
      varianceExposureAmt :u256
};

const validate_order = fn(rawTickLower:u256, rawTickUpper: u256, varianceExposureAmt :u256) void {
      let mut tickLower = decode_int24(0);
      let mut tickUpper = decode_int24(24);
      if varianceExposureAmt == 0 {revert_R();}
      if varianceExposureAmt > 0xffffffffffffffffffffff  {revert_R();}
      if tickLower == tickUpper {revert_R();}
      
};

const make = fn( rawTickLower:u256, rawTickUpper: u256, varianceExposureAmt :u256) Order {
      let mut tickLower = decode_int24(0);
      let mut tickUpper = decode_int24(24);
      let tmp = tickLower;
      if tickUpper < tickLower {tickLower = tickUpper  ; tickUpper = tmp;}
      Order {
	 tickLower:tickLower,
	 tickUpper:tickUpper,
	 varianceExposureAmt:varianceExposureAmt
      }
      
};