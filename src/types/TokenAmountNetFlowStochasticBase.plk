const TokenAmountNetFlowStochasticBase = fn (
    comptime C: type,
    comptime N: type,
    comptime dt: u256
) type {
    struct {
        sigma: C,
        dw: DeltaW(dt)
    }
};

const TokenAmountStock = fn (comptime T: type) type {
    struct {
        val: u256
    }
};

const intro_base = fn (
    comptime dt: u256,
    sigma: SigmaF(Ray),
    dw: DeltaW(dt)
) TokenAmountNetFlowStochasticBase(SigmaF(Ray), Ray, dt) {
    TokenAmountNetFlowStochasticBase(SigmaF(Ray), Ray, dt) {
        sigma: sigma,
        dw: dw
    }
};

