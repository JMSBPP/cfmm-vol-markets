import types::pricing::PriceCoordinate::*;

// PricePair: two price points in a coordinate frame (todo §16, ctor (PriceCoordinate, p1, p2) -> PricePair).
// `geometry` is the PriceCoordinateId of the frame that produced the points, so two pairs can be checked
// for the same geometry (the TICK_SPACING-must-match invariant from the pos_spec notes). p1/p2 are the
// sqrtPriceX96 points at the two input ticks, priced through the η-split kernel. Unordered — p1↔i1, p2↔i2;
// the sorted variant is PriceOrderedPair.
const PricePair = struct {
    geometry: u256,   // PriceCoordinateId
    p1: u256,         // sqrtPriceX96 at i1
    p2: u256          // sqrtPriceX96 at i2
};

const price_pair = fn (coord: PriceCoordinate, i1: u256, i2: u256) PricePair {
    PricePair {
        geometry: coord.id,
        p1: price_at_tick(coord, i1),
        p2: price_at_tick(coord, i2)
    }
};
