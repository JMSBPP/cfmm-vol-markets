// PriceCoordinate: the price-coordinate frame a PricePair/PriceBucket lives in. `id`
// (the PriceCoordinateId) is the keccak256 fingerprint of the frame params, so two coordinates
// can be compared for "same geometry" (the TICK_SPACING-must-match invariant from the pos_spec
// notes is enforced by id equality). `subs_elasticity` is η in Q64.96.
//
// note: `basis 1.0001` from todo §16 is NOT a stored field — no TickMath implementation carries
// 1.0001 as a value; it is embedded in the tick_math.plk magic constants. The frame honors the
// basis by delegating pricing to that port via the η-split kernel (see lib::pricing::EtaSplitKernel,
// proven by lean4-spec `eta_split_kernel_identity`).

import lib::pricing::EtaSplitKernel::*;

const PriceCoordinate = struct {
    id: u256,               // PriceCoordinateId = keccak256(tick_spacing, subs_elasticity, numb_rep)
    tick_spacing: u256,
    subs_elasticity: u256,  // η in Q64.96 (η ∈ (0, 2^96))
    numb_rep: u256          // fixed-point scale tag, e.g. 96 for Q64.96
};

// keccak256 over the 96-byte ABI-encoding of (tick_spacing, subs_elasticity, numb_rep) — byte-identical
// to Solidity keccak256(abi.encode(tickSpacing, eta, numbRep)).
const price_coordinate = fn (
    tick_spacing: u256, subs_elasticity: u256, numb_rep: u256
) PriceCoordinate {
    let buf = @malloc_uninit(96);
    @mstore32(buf, tick_spacing);
    @mstore32(buf +% 32, subs_elasticity);
    @mstore32(buf +% 64, numb_rep);
    PriceCoordinate {
        id: @evm_keccak256(buf, 96),
        tick_spacing: tick_spacing,
        subs_elasticity: subs_elasticity,
        numb_rep: numb_rep
    }
};

// price_at_tick: the frame prices a tick via the η-split kernel, with η = the frame's subs_elasticity.
// By `eta_split_kernel_identity` this equals the canonical sqrtPriceX96, while the underlying
// tick_split_minus/plus expose the two legs that downstream PricePair/PriceBucket constructors consume.
const price_at_tick = fn (self: PriceCoordinate, tick: u256) u256 {
    eta_split_kernel(self.subs_elasticity, tick)
};
