import std::option::Option;
import std::core::ops::{checked_add, checked_sub, neg_u256};
import types::IO::IO;
import cfmm_types::Window::*;
import cfmm_types::TimeSpacing::*;

/// types.toml: WeinerGenerator
/// .spec: .spec/REALIZED_VOLATILITY.spec/types/WeinerGenerator/WeinerGenerator.md
/// PRD: https://github.com/JMSBPP/cfmm-vol-markets/issues/143
/// Channel-built DeltaW(dt) via Shock(Pips). Eff = [Timestamp] (WeinerView).
/// Outcome: run_weiner → Option(DeltaW(dt)). Type phase — holes only.
/// Legacy ShockPips / mapHash / passed-eps deltaW removed.

/// DeltaW(dt) — Ray-scale Wiener increment for lattice spacing dt (TimeSpacing).
const DeltaW = fn (comptime dt: u256) type {
    let _ = TimeSpacing(dt);
    struct {
        val: u256
    }
};

/// Command for io wrap; Timestamp env + Shock entropy read in run_weiner (Eff).
const WeinerCmd = struct {
    /// Lattice index j (ShockCmd.j / Window lattice).
    j: u256
};

/// Pure wrap. Execution is run_weiner only.
const io = fn (cmd: WeinerCmd) IO(WeinerCmd) {
    @compile_error("WeinerGenerator.io: define phase");
};

/// Timestamp + Shock.run_shock → √dt · mag → Option(DeltaW(dt)).
/// Named run_weiner — `run` is the Plank entrypoint keyword.
const run_weiner = fn (comptime dt: u256, m: IO(WeinerCmd)) Option(DeltaW(dt)) {
    @compile_error("WeinerGenerator.run_weiner: define phase");
};

/// Project DeltaW payload (Ray-scale u256 until Ray carrier is threaded).
const val = fn (comptime dt: u256, dw: DeltaW(dt)) u256 {
    @compile_error("WeinerGenerator.val: define phase");
};

/// Sign helpers — still used by TokenFlow / SigmaF / TokenHistory.
const is_neg_signed = fn (x: u256) bool {
    x > 0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
};

const abs_signed = fn (x: u256) u256 {
    if is_neg_signed(x) {
        neg_u256(x)
    } else {
        x
    }
};

/// j ∈ [0, n(dt)); n = Window/dt from cfmm-types TimeSpacing.
const assert_j_in_range = fn (comptime dt: u256, j: u256) void {
    let nmax = n(dt);
    if j >= nmax {
        let _ = checked_sub(nmax, checked_add(j, 1));
    }
};
