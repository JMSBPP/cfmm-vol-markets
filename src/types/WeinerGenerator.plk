import std::option::{Option, Some, None, is_some};
import std::core::ops::{checked_mul, checked_div_down, neg_u256};
import std::core::uint::cast_uint;
import types::IO::IO;
import types::Shock::{Shock, ShockCmd, io as shock_io, run_shock, val as shock_val};
import cfmm_types::Pips::{Pips, PIPS};
import cfmm_types::Ray::rayVal;
import cfmm_types::TimeSpacing::*;

/// types.toml: WeinerGenerator
/// .spec: .spec/REALIZED_VOLATILITY.spec/types/WeinerGenerator/WeinerGenerator.md
/// .btt: .spec/REALIZED_VOLATILITY.spec/types/WeinerGenerator/WeinerGeneratorRunWeiner.btt
/// PRD: https://github.com/JMSBPP/cfmm-vol-markets/issues/146
/// Channel-built DeltaW(dt) via Shock(Pips). Eff = [Timestamp] (WeinerView).
/// ΔW = TimeSpacing.sqrt_dt(dt) · mag / PIPS (Ray scale); mag from Shock(Pips).

/// DeltaW(dt) — Ray-scale Wiener increment (u256 word; Ray carrier later).
const DeltaW = fn (comptime dt: u256) type {
    let _ = TimeSpacing(dt);
    struct {
        val: u256
    }
};

/// Command for io wrap; Timestamp env + Shock entropy read in run_weiner (Eff).
const WeinerCmd = struct {
    /// Lattice index j (ShockCmd.j / Window lattice).
    j: u256
};

/// Pure wrap. Execution is run_weiner only.
const io = fn (cmd: WeinerCmd) IO(WeinerCmd) {
    IO(WeinerCmd) { inner: cmd }
};

/// √dt̄ (TimeSpacing.sqrt_dt → Ray) · mag_pips / PIPS → Ray-scale word.
const product_ray = fn (comptime dt: u256, mag_pips: u256) u256 {
    checked_div_down(checked_mul(rayVal(sqrt_dt(dt)), mag_pips), PIPS)
};

/// Timestamp + Shock.run_shock → √dt · mag → Option(DeltaW(dt)).
const run_weiner = fn (comptime dt: u256, m: IO(WeinerCmd)) Option(DeltaW(dt)) {
    let so = run_shock(Pips, shock_io(ShockCmd { j: m.inner.j }));
    if !is_some(Shock(Pips), so) {
        None(DeltaW(dt))
    } else {
        let mag = cast_uint(shock_val(Pips, so.inner).val, u256);
        Some(DeltaW(dt) { val: product_ray(dt, mag) })
    }
};

/// Project DeltaW payload (Ray-scale u256).
const val = fn (comptime dt: u256, dw: DeltaW(dt)) u256 {
    dw.val
};

/// Sign helpers — still used by TokenFlow / SigmaF / TokenHistory.
const is_neg_signed = fn (x: u256) bool {
    x > 0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
};

const abs_signed = fn (x: u256) u256 {
    if is_neg_signed(x) {
        neg_u256(x)
    } else {
        x
    }
};
