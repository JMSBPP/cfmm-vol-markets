import std::constructor::return_runtime;
import types::pricing::PriceCoordinate::*;
import types::pricing::PriceBucket::*;
import lib::TickUtils::*;

// cast sig "priceBucket(uint256,uint256,uint256,int24,int24,int24)"                  -> 0x2ea9e6ed
const SEL_BUCKET  = 0x2ea9e6ed;
// cast sig "priceBucketFromTickBucket(uint256,uint256,uint256,int24,int24,int24)"    -> 0x27256e9b
const SEL_FROM_TB = 0x27256e9b;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // priceBucket(tick_spacing@4, eta@36, numb_rep@68, i1@100, imid@132, i2@164)
    if selector == SEL_BUCKET {
        let coord = price_coordinate(@evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68));
        let bkt = price_bucket(coord, @evm_calldataload(100), @evm_calldataload(132), @evm_calldataload(164));
        let out = @malloc_uninit(128);
        @mstore32(out, bkt.geometry);
        @mstore32(out +% 32, bkt.lower);
        @mstore32(out +% 64, bkt.mid);
        @mstore32(out +% 96, bkt.upper);
        @evm_return(out, 128);
    }

    // priceBucketFromTickBucket(tick_spacing@4, eta@36, numb_rep@68, low@100, up@132, tbSpacing@164)
    if selector == SEL_FROM_TB {
        let coord = price_coordinate(@evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68));
        let tb = TickBucket {
            low: @evm_calldataload(100),
            tickSpacing: @evm_calldataload(164),
            up: @evm_calldataload(132)
        };
        let bkt = price_bucket_from_tick_bucket(coord, tb);
        let out = @malloc_uninit(128);
        @mstore32(out, bkt.geometry);
        @mstore32(out +% 32, bkt.lower);
        @mstore32(out +% 64, bkt.mid);
        @mstore32(out +% 96, bkt.upper);
        @evm_return(out, 128);
    }

    @evm_stop();
}
