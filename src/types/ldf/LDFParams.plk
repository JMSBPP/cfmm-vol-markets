import lib::TickUtils::{TickBucket, pack_tick_bucket};

// todo: It needs to apply the logic of bunni-v2 ldf
// todo: We need to watch out for enum type support on plank so it is the first arg:

// todo: For the kind arg we need a type that from the first 8 bits has the enum

const LDF_GEOMETRIC = 0;
const LDF_UNIFORM   = 1;
const LDF_CARPETED  = 2;

const LDFParams = struct {
    kind: u256,  // semantically u8
    word0: u256,
    word1: u256
};

const ldf_geometric_params = fn( i_min: u256, xi: u256,iota: u256) LDFParams {
    LDFParams {
        kind: LDF_GEOMETRIC,

        word0:
            (i_min & 0xffffff)
            | @evm_shl(24, xi & 0xffffffffffffffffffffffffffffffffffffffff)
            | @evm_shl(184, iota & 0xffffff),

        word1: 0
    }
};

const ldf_uniform_params = fn(tick_bucket: TickBucket) LDFParams {
    LDFParams {
        kind: LDF_UNIFORM,
        word0: pack_tick_bucket(tick_bucket),
        word1: 0
    }
};

const ldf_carpeted_params = fn( i_min: u256, xi: u256,iota: u256,wc: u256) LDFParams {
    LDFParams {
        kind: LDF_CARPETED,

        word0:
            (i_min & 0xffffff)
            | @evm_shl(24, xi & 0xffffffffffffffffffffffffffffffffffffffff)
            | @evm_shl(184, iota & 0xffffff),

        word1:
            wc & 0xffffffffffffffffffffffffffffffffffffffff
    }
};