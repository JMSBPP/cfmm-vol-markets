// Algebra dynamic-fee configuration -- faithful port of @cryptoalgebra/dynamic-fee-plugin
// types/AlgebraFeeConfiguration.sol + AlgebraFeeConfigurationU144.sol. Coefficients for the two
// sigmoids  alpha / (1 + e^((beta - x)/gamma)):
//   alpha1/alpha2  (u16) max value of each sigmoid (hundredths of a bip, 1e-6)
//   beta1/beta2    (u32) x-axis (volatility) shift of each sigmoid
//   gamma1/gamma2  (u16) horizontal stretch of each sigmoid
//   base_fee       (u16) minimum fee
// Constraint (validated in AdaptiveFee): alpha1 + alpha2 + base_fee <= u16 max; gammas != 0.

const AlgebraFeeConfiguration = struct {
    alpha1: u256,   // u16
    alpha2: u256,   // u16
    beta1: u256,    // u32
    beta2: u256,    // u32
    gamma1: u256,   // u16
    gamma2: u256,   // u16
    base_fee: u256  // u16
};

// U144 packed layout (AlgebraFeeConfigurationU144.sol): alpha1@0, alpha2@16, beta1@32, beta2@64,
// gamma1@96, gamma2@112, base_fee@128. Each field masked to its width before shifting.
const algebra_fee_config_pack = fn (self: AlgebraFeeConfiguration) u256 {
    (self.alpha1 & 0xffff)
    | @evm_shl(16,  self.alpha2 & 0xffff)
    | @evm_shl(32,  self.beta1 & 0xffffffff)
    | @evm_shl(64,  self.beta2 & 0xffffffff)
    | @evm_shl(96,  self.gamma1 & 0xffff)
    | @evm_shl(112, self.gamma2 & 0xffff)
    | @evm_shl(128, self.base_fee & 0xffff)
};

// accessors on the packed u144 word (match AlgebraFeeConfigurationU144Lib's shr+mask)
const afc_alpha1   = fn (c: u256) u256 { c & 0xffff };
const afc_alpha2   = fn (c: u256) u256 { @evm_shr(16, c) & 0xffff };
const afc_beta1    = fn (c: u256) u256 { @evm_shr(32, c) & 0xffffffff };
const afc_beta2    = fn (c: u256) u256 { @evm_shr(64, c) & 0xffffffff };
const afc_gamma1   = fn (c: u256) u256 { @evm_shr(96, c) & 0xffff };
const afc_gamma2   = fn (c: u256) u256 { @evm_shr(112, c) & 0xffff };
const afc_base_fee = fn (c: u256) u256 { @evm_shr(128, c) & 0xffff };
