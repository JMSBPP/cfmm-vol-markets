import cfmm_types::Ray::{Ray, intro as ray_intro};

/// types.toml: SigmaF
/// .spec: .spec/REALIZED_VOLATILITY.spec/types/SigmaF/SigmaF.md
/// .btt: .spec/REALIZED_VOLATILITY.spec/types/SigmaF/SigmaFIntro.btt
///       .spec/REALIZED_VOLATILITY.spec/types/SigmaF/SigmaFIntroFromU256.btt
/// PRD: https://github.com/JMSBPP/cfmm-vol-markets/issues/151
/// Phantom N; only SigmaF(Ray) this slice. Eff = []. No token_amount.

const SigmaF = fn (comptime N: type) type {
    struct {
        r: N
    }
};

const intro = fn (r: Ray) SigmaF(Ray) {
    SigmaF(Ray) { r: r }
};

const intro_from_u256 = fn (x: u256) SigmaF(Ray) {
    intro(ray_intro(x))
};
