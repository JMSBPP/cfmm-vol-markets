import types::PriceCoordinate::*;
import lib::TickUtils::*;
import v3::util::revert_empty;

// PriceBucket: three price points (lower ≤ mid ≤ upper) in a coordinate frame (todo §16). Two ctors:
//   (PriceCoordinate, i1, imid, i2) -> PriceBucket   -- three ticks, sorted ascending
//   (TickBucket)                    -> PriceBucket   -- from a [low, up] tick bucket, mid = midpoint tick
// `geometry` is the PriceCoordinateId; the TickBucket ctor enforces the same-geometry invariant
// (coord.tick_spacing == tb.tickSpacing) from the pos_spec notes.
const PriceBucket = struct {
    geometry: u256,   // PriceCoordinateId
    lower: u256,      // sqrtPriceX96 at the min tick
    mid: u256,        // sqrtPriceX96 at the median / midpoint tick
    upper: u256       // sqrtPriceX96 at the max tick
};

// ctor 1: sort the three ticks ascending (by signed comparison), then price each in the frame.
// median = sum − min − max (exact for the small signed tick range).
const price_bucket = fn (coord: PriceCoordinate, i1: u256, imid: u256, i2: u256) PriceBucket {
    let lo_ab = if @evm_slt(i1, imid) { i1 } else { imid };
    let lower_tick = if @evm_slt(lo_ab, i2) { lo_ab } else { i2 };
    let hi_ab = if @evm_slt(i1, imid) { imid } else { i1 };
    let upper_tick = if @evm_slt(hi_ab, i2) { i2 } else { hi_ab };
    let mid_tick = i1 +% imid +% i2 -% lower_tick -% upper_tick;
    PriceBucket {
        geometry: coord.id,
        lower: price_at_tick(coord, lower_tick),
        mid: price_at_tick(coord, mid_tick),
        upper: price_at_tick(coord, upper_tick)
    }
};

// ctor 2: from a TickBucket {low, tickSpacing, up}. Requires coord.tick_spacing == tb.tickSpacing
// (same-geometry invariant); mid = ⌊(low+up)/2⌋ via SAR (floor midpoint tick).
const price_bucket_from_tick_bucket = fn (coord: PriceCoordinate, tb: TickBucket) PriceBucket {
    if coord.tick_spacing != tb.tickSpacing { revert_empty(); }
    let mid_tick = @evm_sar(1, tb.low +% tb.up);
    PriceBucket {
        geometry: coord.id,
        lower: price_at_tick(coord, tb.low),
        mid: price_at_tick(coord, mid_tick),
        upper: price_at_tick(coord, tb.up)
    }
};
