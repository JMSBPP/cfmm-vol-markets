
// A ring-buffer index into the timepoint buffer.
//
// The ring is 2^16 slots (Algebra's `Timepoint[UINT16_MODULO]`), and Algebra gets wraparound
// for free because its index is a `uint16`. Plank carries it in a u256, so the modulus MUST be
// applied explicitly -- see `next`.
const INDEX_MODULO_MASK = 0xFFFF; // UINT16_MODULO - 1

const StorageIndex = struct {
      current: u256
};

const initialize_storage_index = fn() StorageIndex {
      StorageIndex {
      		   current: 0
      }
};

// next wraps at 2^16, exactly as Algebra's `uint16 indexUpdated = lastIndex + 1` does.
//
// The mask is load-bearing, not defensive. Without it, at last_index == 65535 the advanced
// index is 65536, and because array_slot(base, i) = keccak256(base) + i applies no mask of its
// own, write_timepoint's @evm_sstore landed the new timepoint at keccak(base)+65536 -- OUTSIDE
// the ring. Meanwhile pack_realized_volatility_state masks ss_index to 16 bits, so the state
// recorded lastIndex = 0, and every subsequent read resolved index 0 back to the GENESIS
// timepoint. The oracle silently rewound to its initialization state on wrap, losing every
// sample, with no revert.
//
// (The read path already masked -- load_timepoint does `index & TIMEPOINT_INDEX_MASK` -- which
// is why this never surfaced: reads were consistent, writes were not.)
const next = fn(self:StorageIndex) StorageIndex {
      StorageIndex {
      		   current: (self.current +% 1) & INDEX_MODULO_MASK
      }
};
