import std::constructor::return_runtime;
import types::PriceCoordinate::*;

// signature:: coordinate(uint256,uint256,uint256) -> (bytes32,uint256,uint256,uint256)
//   args  : tick_spacing, subs_elasticity (η, Q64.96), numb_rep
//   return: (id, tick_spacing, subs_elasticity, numb_rep)
//   cast sig "coordinate(uint256,uint256,uint256)" -> 0x91b8953e
const SELECTOR_COORDINATE = 0x91b8953e;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // tick_spacing@4, subs_elasticity@36, numb_rep@68
    if selector == SELECTOR_COORDINATE {
        let c = price_coordinate(
            @evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68)
        );
        // ABI tuple (bytes32,uint256,uint256,uint256) = 4 static words = 128 bytes
        let out = @malloc_uninit(128);
        @mstore32(out, c.id);
        @mstore32(out +% 32, c.tick_spacing);
        @mstore32(out +% 64, c.subs_elasticity);
        @mstore32(out +% 96, c.numb_rep);
        @evm_return(out, 128);
    }

    @evm_stop();
}
