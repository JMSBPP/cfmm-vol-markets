
const MIN_SAMPLE_SIZE = 1;
const Sample = struct {
      size: u256
};


const TimeTickObservation = struct {
    blockTimestamp: u256,
    tickCumulative: u256,
    tickMean: u256,
    tickMin: u256,
    tickMax: u256,
    realizedTickVol:u256,
    initialized: bool
};


const TimeIntegratedTickBucket = struct { tickCumulative: u256  };


const pack_time_tick_observation = fn (
    blockTimestamp: u256,
    tickCumulative: u256,
    tickMean: u256,
    tickMin: u256,
    tickMax: u256,
    realizedTickVol: u256,
    initialized: bool
) u256 {
   (blockTimestamp & 0xFFFFFFFF)
    | ((tickCumulative & 0xFFFFFFFFFFFFFF) << 32)
    | ((tickMean & 0xFFFFFF) << 88) // 32 + 56
    | ((tickMin & 0xFFFFFF) << 112) // 32 + 56 + 24
    | ((tickMax & 0xFFFFFF) << 136) // 32 + 56 + 48
    | ((realizedTickVol & 0xFFFFFFFFFFFFFFFFFFFFFF) << 160) // 32 + 56 + 72
    | ((if initialized { 1 } else { 0 }) << 248)

}

const unpack_time_tick_observation
  = fn (packed: u256) TimeTickObservation {
       let tick_raw = @evm_shr(32, packed) & 0xFFFFFFFFFFFFFF;
       let tickCumulative = if tick_raw >= 0x80000000000000 { tick_raw | 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00000000000000 } else { tick_raw };
    	TimeTickObservation {
           		       blockTimestamp: packed & 0xFFFFFFFF,
			       tickCumulative: tickCumulative,
			       tickMean: @evm_shr(88,packed) & 0xFFFFFF, 
			       tickMin:@evm_shr(112,packed) & 0xFFFFFF,
			       tickMax:@evm_shr(136,packed) & 0xFFFFFF,
			       realizedTickVol: @evm_shr(160, packed) & 0xFFFFFFFFFFFFFFFFFFFFFF
        		       initialized: (@evm_shr(248, packed) & 1) > 0
   }
    
};



