import types::Numerics::{SQ128.128, Q128.128};

const LiquidityStock = struct {
      size : Q128.128
};

const LiquidityFlow = struct {
      delta: SQ128.128
};

const Liquidity  = struct {
      stock: LiquidityStock
      flow: LiquidityFlow
};

const ConcentratedLiquidity = struct {
      liquidity :Liquidity,
      tickLower: u256,
      tickUpper: u256
};
