import v3::util::revert_empty;

// Portafolio: the token amounts a geometric-LDF position holds over its full support [i_min, i_max).

const Portafolio = struct {
    gross_output_amt: u256,   // Q_X -- token1 (cumulativeAmountX over the support)
    gross_input_amt: u256     // Q_M -- token0 (cumulativeAmountM over the support)
};

// PortafolioDelta: a signed (Δtoken0, Δtoken1) packed into one int256 (held in u256), a faithful port of
// v4-core BalanceDelta (amount0 in the upper 128 bits, amount1 in the lower). See .planning/portafolio-delta-SPEC.md.
// amount0 <-> gross_input (Q_M/token0), amount1 <-> gross_output (Q_X/token1). Getters return SIGN-EXTENDED
// int256-in-u256 values (feed straight back into add's signed math). apply_delta onto the unsigned gross fields
// is deferred to the net-amount accounting (see spec).

// int128 fit check == SafeCast.toInt128: signextend(15, x) must equal x, else revert (int128 overflow).
const portafolio_delta_to_int128 = fn (x: u256) u256 {
    if @evm_signextend(15, x) != x {
        revert_empty();
    }
    x
};

// pack(amount0, amount1) = (amount0 << 128) | (amount1 & (2^128-1))  (BalanceDelta.sol:14-18).
// amount0 is NOT masked before shl -- its sign-extension bits shift out past bit 255 (proven correct in review).
const to_portafolio_delta = fn (amount0: u256, amount1: u256) u256 {
    let mask128 = @evm_shl(128, 1) -% 1;
    @evm_shl(128, amount0) | (amount1 & mask128)
};

const portafolio_delta_amount0 = fn (d: u256) u256 { @evm_sar(128, d) };            // signed upper 128
const portafolio_delta_amount1 = fn (d: u256) u256 { @evm_signextend(15, d) };      // signed lower 128

// add/sub: unpack to signed, combine with WRAPPING (+%/-%) -- |a+b| < 2^128 so no int256 overflow; the ONLY
// revert is the downstream int128 fit check (a checked add would spuriously revert on ordinary negative deltas).
const portafolio_delta_add = fn (a: u256, b: u256) u256 {
    to_portafolio_delta(
        portafolio_delta_to_int128(portafolio_delta_amount0(a) +% portafolio_delta_amount0(b)),
        portafolio_delta_to_int128(portafolio_delta_amount1(a) +% portafolio_delta_amount1(b))
    )
};
const portafolio_delta_sub = fn (a: u256, b: u256) u256 {
    to_portafolio_delta(
        portafolio_delta_to_int128(portafolio_delta_amount0(a) -% portafolio_delta_amount0(b)),
        portafolio_delta_to_int128(portafolio_delta_amount1(a) -% portafolio_delta_amount1(b))
    )
};
