import types::PriceCoordinate::*;

// PriceOrderedPair: the ordered variant of PricePair (todo §16, ctor
// (PriceCoordinate, p1, p2) -> PriceOrderedPair). The ctor sorts the two ticks by signed comparison so
// the frame always yields lower ≤ upper (the [sqrtLower, sqrtUpper] form liquidity math consumes),
// regardless of input order. Sorting is done on TICKS (not the ULP-rounded prices) so ordering is exact.
const PriceOrderedPair = struct {
    geometry: u256,   // PriceCoordinateId
    lower: u256,      // sqrtPriceX96 at min(i1, i2)
    upper: u256       // sqrtPriceX96 at max(i1, i2)
};

const price_ordered_pair = fn (coord: PriceCoordinate, i1: u256, i2: u256) PriceOrderedPair {
    let i_lo = if @evm_slt(i1, i2) { i1 } else { i2 };
    let i_hi = if @evm_slt(i1, i2) { i2 } else { i1 };
    PriceOrderedPair {
        geometry: coord.id,
        lower: price_at_tick(coord, i_lo),
        upper: price_at_tick(coord, i_hi)
    }
};
