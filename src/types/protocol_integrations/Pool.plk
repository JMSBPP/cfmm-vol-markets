import std::core::addr::{addr, cast_addr, addr_from_u256};
import std::error::require;
import types::Pair::*;
import types::protocol_integrations::Registry::*;
import types::protocol_integrations::Venue::*;
import types::protocol_integrations::PoolId::*;

const SEL_FEE_V3 = 0xddca3f43;
const SEL_TICK_SPACING = 0xd0c93a7c;
const SEL_GLOBAL_STATE = 0xe76c01e4;
const SEL_EXTSLOAD = 0x1e2eaeaf;
const POOL_SEL_GET_POOL = 0x1698ee82;
const POOL_SEL_POOL_BY_PAIR = 0xd9a641e1;
const POOL_SEL_ALGEBRA_ENTRY_FACTORY = 0xc45a0155;

const POOL_V4_DYNAMIC_FEE_KEY = 0x800000;
const POOLS_SLOT = 6;
const POOL_MASK_U160 = 0xffffffffffffffffffffffffffffffffffffffff;
const POOL_MASK_U24 = 0xffffff;
const POOL_MASK_U16 = 0xffff;

const Pool = fn (comptime V: type) type {
    if !is_venue(V) {
        @compile_error("Pool: V must be V4, V3 or Algebra");
    }
    return struct V {
        pool_id: PoolId(V),
        fee: u256,
        tick_spacing: u256,
    };
};

const pool_v4 = fn (
    pair: Pair, registry: Registry(V4), fee: u256, tick_spacing: u256
) Pool(V4) {
    Pool(V4) {
        pool_id: pool_id_v4_from_context(pair, registry, fee, tick_spacing),
        fee: fee,
        tick_spacing: tick_spacing
    }
};

const pool_v3 = fn (pool: addr, fee: u256, tick_spacing: u256) Pool(V3) {
    Pool(V3) {
        pool_id: pool_id_v3(pool),
        fee: fee,
        tick_spacing: tick_spacing
    }
};

const pool_algebra = fn (pool: addr, fee: u256, tick_spacing: u256) Pool(Algebra) {
    Pool(Algebra) {
        pool_id: pool_id_algebra(pool),
        fee: fee,
        tick_spacing: tick_spacing
    }
};

const pool_fee = fn (comptime V: type, p: Pool(V)) u256 {
    p.fee
};

const pool_tick_spacing = fn (comptime V: type, p: Pool(V)) u256 {
    p.tick_spacing
};

const pool_word = fn (comptime V: type, p: Pool(V)) u256 {
    pool_id_word(V, p.pool_id)
};

const staticcall_u256 = fn (target: u256, cd: u256, len: u256) u256 {
    let ret = @malloc_uninit(32);
    require(@evm_staticcall(@evm_gas(), target, cd, len, ret, 32));
    @mload32(ret)
};

const pool_read_fee_v3 = fn (pool: u256) u256 {
    let cd = @malloc_uninit(4);
    @mstore4(cd, SEL_FEE_V3);
    @evm_and(staticcall_u256(pool, cd, 4), POOL_MASK_U24)
};

const pool_read_tick_spacing_v3 = fn (pool: u256) u256 {
    let cd = @malloc_uninit(4);
    @mstore4(cd, SEL_TICK_SPACING);
    @evm_signextend(2, @evm_and(staticcall_u256(pool, cd, 4), POOL_MASK_U24))
};

const pool_read_fee_algebra = fn (pool: u256) u256 {
    let cd = @malloc_uninit(4);
    @mstore4(cd, SEL_GLOBAL_STATE);
    let ret = @malloc_uninit(192);
    require(@evm_staticcall(@evm_gas(), pool, cd, 4, ret, 192));
    @evm_and(@mload32(ret +% 64), POOL_MASK_U16)
};

const pool_read_tick_spacing_algebra = fn (pool: u256) u256 {
    pool_read_tick_spacing_v3(pool)
};

const pool_v4_state_slot = fn (pool_id: u256) u256 {
    let packed = @malloc_uninit(64);
    @mstore32(packed, pool_id);
    @mstore32(packed +% 32, POOLS_SLOT);
    @evm_keccak256(packed, 64)
};

const pool_v4_slot0_word = fn (manager: u256, pool_id: u256) u256 {
    let state_slot = pool_v4_state_slot(pool_id);
    let cd = @malloc_uninit(36);
    @mstore4(cd, SEL_EXTSLOAD);
    @mstore32(cd +% 4, state_slot);
    let ret = @malloc_uninit(32);
    require(@evm_staticcall(@evm_gas(), manager, cd, 36, ret, 32));
    @mload32(ret)
};

const pool_v4_slot0_sqrt = fn (manager: u256, pool_id: u256) u256 {
    @evm_and(pool_v4_slot0_word(manager, pool_id), POOL_MASK_U160)
};

const pool_v4_slot0_lp_fee = fn (manager: u256, pool_id: u256) u256 {
    @evm_and(@evm_shr(208, pool_v4_slot0_word(manager, pool_id)), POOL_MASK_U24)
};

const pool_v3_at = fn (pool: addr) Pool(V3) {
    let pool_u = cast_addr(pool, u256);
    Pool(V3) {
        pool_id: pool_id_v3(pool),
        fee: pool_read_fee_v3(pool_u),
        tick_spacing: pool_read_tick_spacing_v3(pool_u)
    }
};

const pool_algebra_at = fn (pool: addr) Pool(Algebra) {
    let pool_u = cast_addr(pool, u256);
    Pool(Algebra) {
        pool_id: pool_id_algebra(pool),
        fee: pool_read_fee_algebra(pool_u),
        tick_spacing: pool_read_tick_spacing_algebra(pool_u)
    }
};

const pool_v4_at_keyed = fn (
    pair: Pair, registry: Registry(V4), tick_spacing: u256, fee_key: u256
) Pool(V4) {
    let manager = registry_pool_manager(registry);
    require(manager != 0);
    let id = pool_id_v4_from_context(pair, registry, fee_key, tick_spacing);
    let id_word = pool_id_word(V4, id);
    require(pool_v4_slot0_sqrt(manager, id_word) != 0);
    Pool(V4) {
        pool_id: id,
        fee: pool_v4_slot0_lp_fee(manager, id_word),
        tick_spacing: tick_spacing
    }
};

const pool_v4_at = fn (pair: Pair, registry: Registry(V4), tick_spacing: u256) Pool(V4) {
    pool_v4_at_keyed(pair, registry, tick_spacing, POOL_V4_DYNAMIC_FEE_KEY)
};

const pool_verify_v3 = fn (p: Pool(V3), pair: Pair, registry: Registry(V3)) void {
    let pool_u = pool_id_word(V3, p.pool_id);
    require(pool_read_fee_v3(pool_u) == p.fee);
    require(pool_read_tick_spacing_v3(pool_u) == p.tick_spacing);
    let cd = @malloc_uninit(100);
    @mstore4(cd, POOL_SEL_GET_POOL);
    @mstore32(cd +% 4, cast_addr(pair.token0, u256));
    @mstore32(cd +% 36, cast_addr(pair.token1, u256));
    @mstore32(cd +% 68, p.fee);
    let ret = @malloc_uninit(32);
    require(@evm_staticcall(@evm_gas(), registry_addr(V3, registry), cd, 100, ret, 32));
    require(@mload32(ret) == pool_u);
};

const pool_verify_algebra = fn (p: Pool(Algebra), pair: Pair, registry: Registry(Algebra)) void {
    let pool_u = pool_id_word(Algebra, p.pool_id);
    require(pool_read_fee_algebra(pool_u) == p.fee);
    require(pool_read_tick_spacing_algebra(pool_u) == p.tick_spacing);
    let factory_cd = @malloc_uninit(4);
    @mstore4(factory_cd, POOL_SEL_ALGEBRA_ENTRY_FACTORY);
    let factory_ret = @malloc_uninit(32);
    require(@evm_staticcall(
        @evm_gas(), registry_addr(Algebra, registry), factory_cd, 4, factory_ret, 32
    ));
    let factory = @mload32(factory_ret);
    let cd = @malloc_uninit(68);
    @mstore4(cd, POOL_SEL_POOL_BY_PAIR);
    @mstore32(cd +% 4, cast_addr(pair.token0, u256));
    @mstore32(cd +% 36, cast_addr(pair.token1, u256));
    let ret = @malloc_uninit(32);
    require(@evm_staticcall(@evm_gas(), factory, cd, 68, ret, 32));
    require(@mload32(ret) == pool_u);
};

const pool_verify_v4 = fn (p: Pool(V4), pair: Pair, registry: Registry(V4)) void {
    let manager = registry_pool_manager(registry);
    require(manager != 0);
    let id_word = pool_id_word(V4, p.pool_id);
    require(pool_v4_slot0_sqrt(manager, id_word) != 0);
    require(pool_v4_slot0_lp_fee(manager, id_word) == p.fee);
};

const pool_verify = fn (comptime V: type, p: Pool(V), pair: Pair, registry: Registry(V)) void {
    if V == V3 {
        pool_verify_v3(p, pair, registry);
    } else if V == Algebra {
        pool_verify_algebra(p, pair, registry);
    } else if V == V4 {
        pool_verify_v4(p, pair, registry);
    } else {
        @compile_error("Pool: V must be V4, V3 or Algebra");
    }
};
