import std::core::addr::{addr, cast_addr};
import types::Pair::*;
import types::protocol_integrations::Registry::*;
import types::protocol_integrations::Venue::*;
import types::protocol_integrations::PoolId::*;

const Pool = fn (comptime V: type) type {
    if !is_venue(V) {
        @compile_error("Pool: V must be V4, V3 or Algebra");
    }
    return struct V {
        pool_id: PoolId(V),
        fee: u256,
        tick_spacing: u256,
    };
};

const pool_v4 = fn (
    pair: Pair, registry: Registry(V4), fee: u256, tick_spacing: u256
) Pool(V4) {
    Pool(V4) {
        pool_id: pool_id_v4_from_context(pair, registry, fee, tick_spacing),
        fee: fee,
        tick_spacing: tick_spacing
    }
};

const pool_v3 = fn (pool: addr, fee: u256, tick_spacing: u256) Pool(V3) {
    Pool(V3) {
        pool_id: pool_id_v3(pool),
        fee: fee,
        tick_spacing: tick_spacing
    }
};

const pool_algebra = fn (pool: addr, fee: u256, tick_spacing: u256) Pool(Algebra) {
    Pool(Algebra) {
        pool_id: pool_id_algebra(pool),
        fee: fee,
        tick_spacing: tick_spacing
    }
};

const pool_fee = fn (comptime V: type, p: Pool(V)) u256 {
    p.fee
};

const pool_tick_spacing = fn (comptime V: type, p: Pool(V)) u256 {
    p.tick_spacing
};

const pool_word = fn (comptime V: type, p: Pool(V)) u256 {
    pool_id_word(V, p.pool_id)
};
