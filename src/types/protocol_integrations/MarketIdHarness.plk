import std::constructor::return_runtime;
import types::protocol_integrations::MarketId::*;
import v3::util::return_u256;

// signature:: idFromPoolKey(address,address,uint24,int24,address) -> bytes32
//   cast sig "idFromPoolKey(address,address,uint24,int24,address)" -> 0x84cec51c
const SELECTOR_ID_FROM_POOL_KEY = 0x84cec51c;

// signature:: marketFromPoolKey(address,address,uint24,int24,address) -> (bytes32,address,address,uint24,int24,address)
//   returns (id, key.currency0, key.currency1, key.fee, key.tick_spacing, key.hooks)
//   cast sig "marketFromPoolKey(address,address,uint24,int24,address)" -> 0x42f608ca
const SELECTOR_MARKET_FROM_POOL_KEY = 0x42f608ca;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));

    // currency0@4, currency1@36, fee@68, tickSpacing@100, hooks@132
    if selector == SELECTOR_ID_FROM_POOL_KEY {
        let m = market_id_from_pool_key(
            @evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68),
            @evm_calldataload(100), @evm_calldataload(132)
        );
        return_u256(m.id);
    }
    if selector == SELECTOR_MARKET_FROM_POOL_KEY {
        let m = market_id_from_pool_key(
            @evm_calldataload(4), @evm_calldataload(36), @evm_calldataload(68),
            @evm_calldataload(100), @evm_calldataload(132)
        );
        // ABI tuple (bytes32,address,address,uint24,int24,address) = 6 static words = 192 bytes
        let out = @malloc_uninit(192);
        @mstore32(out, m.id);
        @mstore32(out +% 32, m.key.currency0);
        @mstore32(out +% 64, m.key.currency1);
        @mstore32(out +% 96, m.key.fee);
        @mstore32(out +% 128, m.key.tick_spacing);
        @mstore32(out +% 160, m.key.hooks);
        @evm_return(out, 192);
    }
    @evm_stop();
}
