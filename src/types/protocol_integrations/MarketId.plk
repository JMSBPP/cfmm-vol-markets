const MarketKey = struct {
    currency0: u256,
    currency1: u256,
    fee: u256,
    tick_spacing: u256,
    hooks: u256
};

const MarketId = struct {
    id: u256,          
    key: MarketKey
};

const market_id_from_pool_key = fn (
    currency0: u256, currency1: u256, fee: u256, tick_spacing: u256, hooks: u256
) MarketId {
    let buf = @malloc_uninit(160);
    @mstore32(buf, currency0);
    @mstore32(buf +% 32, currency1);
    @mstore32(buf +% 64, fee);
    @mstore32(buf +% 96, tick_spacing);
    @mstore32(buf +% 128, hooks);
    MarketId {
        id: @evm_keccak256(buf, 160),
        key: MarketKey {
            currency0: currency0,
            currency1: currency1,
            fee: fee,
            tick_spacing: tick_spacing,
            hooks: hooks
        }
    }
};
