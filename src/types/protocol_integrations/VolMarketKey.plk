import std::core::addr::cast_addr;
import std::error::require;
import types::Pair::*;
import types::protocol_integrations::Pool::*;
import types::protocol_integrations::Registry::*;
import types::protocol_integrations::Venue::*;

// VolMarketKey(V): a market key TAGGED BY VENUE.
//
// `V` is a phantom type parameter used as a venue index, exactly as `Extra(T)` uses a region and
// `Shock(R)` uses a region. `struct V { ... }` makes VolMarketKey(V4) and VolMarketKey(Algebra)
// DISTINCT types even though the fields are identical, so an Algebra key can never be read as a V4
// one -- a cross-venue call site is a COMPILE error, not a runtime revert.
//
// ---------------------------------------------------------------------------------------------
// ASSET vs NUMERAIRE -- read this before touching asset_index.
//
// Panoptic's `asset` BIT names the CASH/collateral token that positionSize is denominated in.
// THIS protocol calls that token the NUMERAIRE and calls the OTHER currency the asset.
// The mapping from this key to Panoptic's bit is a NOT -- see vol_market_key_panoptic_asset_bit.
// ---------------------------------------------------------------------------------------------

const VolMarketKey = fn (comptime V: type) type {
    if !is_venue(V) {
        @compile_error("VolMarketKey: V must be V4, V3 or Algebra");
    }
    return struct V {
        pair: Pair,
        registry: Registry(V),
        pool: Pool(V),
    };
};

const vol_market_key = fn (
    comptime V: type,
    p: Pair,
    r: Registry(V),
    pool: Pool(V)
) VolMarketKey(V) {
    VolMarketKey(V) { pair: p, registry: r, pool: pool }
};

const vol_market_key_currency0 = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    cast_addr(k.pair.token0, u256)
};

const vol_market_key_currency1 = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    cast_addr(k.pair.token1, u256)
};

const vol_market_key_asset_index = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    k.pair.asset_index
};

const vol_market_key_registry_word = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    registry_addr(V, k.registry)
};

const vol_market_key_fee = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    pool_fee(V, k.pool)
};

const vol_market_key_tick_spacing = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    pool_tick_spacing(V, k.pool)
};

const vol_market_key_pool_word = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    pool_word(V, k.pool)
};

const vol_market_key_panoptic_asset_bit = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    let ai = vol_market_key_asset_index(V, k);
    require(ai <= 1);
    1 -% ai
};

const MASK_U40 = 0xffffffffff;
const MASK_U160 = 0xffffffffffffffffffffffffffffffffffffffff;
const POOL_ID_OFF_VEGOID_KEY = 40;
const POOL_ID_OFF_TICK_SPACING = 48;

const vol_market_key_v4_pattern = fn (pool_id_v4: u256) u256 { pool_id_v4 & MASK_U40 };

const vol_market_key_v3_pattern = fn (pool_addr: u256) u256 {
    @evm_shr(120, pool_addr & MASK_U160) & MASK_U40
};

const vol_market_key_compose_pool_id = fn (pattern: u256, vegoid: u256, tick_spacing: u256) u256 {
    require(vegoid != 0);
    (pattern & MASK_U40)
    | @evm_shl(POOL_ID_OFF_VEGOID_KEY, vegoid & 0xff)
    | @evm_shl(POOL_ID_OFF_TICK_SPACING, tick_spacing & 0xffff)
};

const SEL_GET_POOL = 0x1698ee82;
const SEL_POOL_BY_PAIR = 0xd9a641e1;
const SEL_ALGEBRA_ENTRY_FACTORY = 0xc45a0155;
const SEL_SFPM_GET_POOL_ID = 0xb33eb6f3;

const staticcall_word = fn (target: u256, args_ptr: u256, args_len: u256) u256 {
    let ret = @malloc_uninit(32);
    let ok = @evm_staticcall(@evm_gas(), target, args_ptr, args_len, ret, 32);
    require(ok);
    @mload32(ret)
};

const vol_market_key_pool_key_hash = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    let buf = @malloc_uninit(160);
    @mstore32(buf, vol_market_key_currency0(V, k));
    @mstore32(buf +% 32, vol_market_key_currency1(V, k));
    @mstore32(buf +% 64, vol_market_key_fee(V, k));
    @mstore32(buf +% 96, vol_market_key_tick_spacing(V, k));
    @mstore32(buf +% 128, vol_market_key_registry_word(V, k));
    @evm_keccak256(buf, 160)
};

const vol_market_key_v4_pool_id = fn (k: VolMarketKey(V4)) u256 {
    vol_market_key_pool_key_hash(V4, k)
};

const vol_market_key_verify_pool = fn (comptime V: type, k: VolMarketKey(V)) void {
    let resolved = if V == V3 {
        let p = @malloc_uninit(100);
        @mstore4(p, SEL_GET_POOL);
        @mstore32(p +% 4, vol_market_key_currency0(V, k));
        @mstore32(p +% 36, vol_market_key_currency1(V, k));
        @mstore32(p +% 68, vol_market_key_fee(V, k));
        staticcall_word(vol_market_key_registry_word(V, k), p, 100)
    } else if V == Algebra {
        let plugin_factory = vol_market_key_registry_word(V, k);
        let factory_cd = @malloc_uninit(4);
        @mstore4(factory_cd, SEL_FACTORY);
        let factory_addr = staticcall_word(plugin_factory, factory_cd, 4);
        let p = @malloc_uninit(68);
        @mstore4(p, SEL_POOL_BY_PAIR);
        @mstore32(p +% 4, vol_market_key_currency0(V, k));
        @mstore32(p +% 36, vol_market_key_currency1(V, k));
        staticcall_word(factory_addr, p, 68)
    } else {
        @compile_error("VolMarketKey: only V3 and Algebra have a pool address to verify");
    };
    require(resolved == vol_market_key_pool_word(V, k));
};

const vol_market_key_to_panoptic_pool_id =
    fn (comptime V: type, k: VolMarketKey(V), sfpm: u256, vegoid: u256) u256 {
    let pattern = if V == V4 {
        vol_market_key_v4_pattern(vol_market_key_pool_key_hash(V, k))
    } else if V == V3 {
        vol_market_key_verify_pool(V, k);
        vol_market_key_v3_pattern(vol_market_key_pool_word(V, k))
    } else {
        @compile_error("VolMarketKey: the Panoptic arm accepts only V4 or V3");
    };

    let candidate = vol_market_key_compose_pool_id(
        pattern, vegoid, vol_market_key_tick_spacing(V, k)
    );

    let id_word = if V == V4 {
        vol_market_key_pool_key_hash(V, k)
    } else {
        vol_market_key_pool_word(V, k)
    };

    let p = @malloc_uninit(132);
    @mstore4(p, SEL_SFPM_GET_POOL_ID);
    @mstore32(p +% 4, 0x40);
    @mstore32(p +% 36, vegoid);
    @mstore32(p +% 68, 32);
    @mstore32(p +% 100, id_word);
    require(candidate == staticcall_word(sfpm, p, 132));

    candidate
};
