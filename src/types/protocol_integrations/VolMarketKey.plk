import std::error::require;
import types::protocol_integrations::Venue::*;

// VolMarketKey(V): a market key TAGGED BY VENUE.
//
// `V` is a phantom type parameter used as a venue index, exactly as `Extra(T)` uses a region and
// `Shock(R)` uses a region. `struct V { ... }` makes VolMarketKey(V4) and VolMarketKey(Algebra)
// DISTINCT types even though the fields are identical, so an Algebra key can never be read as a V4
// one -- a cross-venue call site is a COMPILE error, not a runtime revert.
//
// Verified supported at plank 00c0a1a: the struct tag accepts any comptime value -- std/slice.plk
// tags with `struct (R, T, arity.inner)`, whose third element is a u256 VALUE, not a type -- and
// `is_region` is an ordinary `fn ... bool` in std/regions.plk, not a language rule. Extra.plk's
// region restriction is a library choice in that file, not a constraint on this one.
//
// ---------------------------------------------------------------------------------------------
// ASSET vs NUMERAIRE -- read this before touching asset_index.
//
// Panoptic's `asset` BIT names the CASH/collateral token that positionSize is denominated in:
//   TokenId.sol:112-116  "Get the asset basis for this TokenId ... 0 if asset is token0, 1 if
//                         asset is token1"
//   PanopticMath.getLiquidityChunk  "The asset is the 'basis' of the position. In TradFi, the
//                         asset is always cash and selling a $1000 put requires the user to lock
//                         $1000", then branching asset==0 -> getLiquidityForAmount0, else
//                         getLiquidityForAmount1.
// THIS protocol calls that token the NUMERAIRE (AlgebraIntegralShocksWriterMod.plk:214:
// "asset=pool.token0, numeraire=pool.token1") and denominates vega in it
// (PanopticTokenIdSetterLib.plk:130: "asset = 1 (token1 = the vega numeraire)").
//
// The two vocabularies therefore use "asset" for OPPOSITE roles, and the mapping from this key to
// Panoptic's bit is a NOT -- see vol_market_key_panoptic_asset_bit. Read from panoptic-v2-core
// @ 5555b32; the citations are there so this can be re-checked rather than trusted.
// ---------------------------------------------------------------------------------------------

const VolMarketKey = fn (comptime V: type) type {
    if !is_venue(V) {
        @compile_error("VolMarketKey: V must be V4, V3 or Algebra");
    }
    return struct V {
        currency0: u256,    // sorted: currency0 < currency1
        currency1: u256,
        asset_index: u256,  // 0 => currency0 is the ASSET; the other currency is the numeraire
        fee: u256,          // V4/V3; unused on Algebra (dynamic fee)
        tick_spacing: u256, // V4 explicit; V3/Algebra verified against the pool
        registry: u256,     // V4: hooks | V3: univ3 factory | Algebra: algebra factory
        pool: u256          // V3/Algebra: the ASSERTED pool address. V4: 0
    };
};

// The Panoptic `asset` bit this key derives. IT IS A NOT, NOT A COPY.
//
// Panoptic's bit names the CASH token positionSize is denominated in; this protocol denominates
// vega in the NUMERAIRE and calls the OTHER currency the asset. With exactly two currencies,
// numeraire_index = 1 - asset_index. See the header block for the citations.
//
// Getting this backwards is silent: it emits a STRUCTURALLY VALID tokenId denominated in the wrong
// token, Panoptic's validate() accepts it, the position mints, and
// position_size_for_target_vega inverts the wrong formula. Nothing reverts, so no test that only
// checks "does it revert" can catch it -- which is why KEY-06 asserts both values of asset_index.
//
// asset_index indexes a PAIR, so {0, 1} is its whole domain. A value above 1 REVERTS rather than
// being masked: a masked 2 would read as 0 and select the wrong currency, reproducing the
// inversion's failure by another route.
const vol_market_key_panoptic_asset_bit = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    require(k.asset_index <= 1);
    1 -% k.asset_index
};

// ---- KEY-02: the 40-bit pool PATTERN, and the poolId it composes into ------------------------
//
// PanopticMath.sol:28 is authoritative on the layout:
//     poolId = [16-bit tickSpacing][8-bit vegoid][40-bit poolPattern]
// The prose comment in BOTH SFPMs says "most significant 48 bits" of the pool address / PoolId.
// The CODE says 40. Trust the code -- and note the two venues derive their 40 bits from opposite
// ENDS of their respective inputs, which is why they are separate functions rather than one.

const MASK_U40 = 0xffffffffff;
const MASK_U160 = 0xffffffffffffffffffffffffffffffffffffffff;
const POOL_ID_OFF_VEGOID_KEY = 40;
const POOL_ID_OFF_TICK_SPACING = 48;

// SFPM V4: uint40(uint256(PoolId.unwrap(idV4))) -- the LOW 40 bits of the v4 PoolId.
const vol_market_key_v4_pattern = fn (pool_id_v4: u256) u256 { pool_id_v4 & MASK_U40 };

// SFPM V3: uint40(uint160(univ3pool) >> 120) -- the HIGH 40 bits of the 160-bit ADDRESS.
// NOT the low bits, and not the same end as V4. Deriving this by analogy with the V4 case is the
// most likely way to get it wrong; test__unit__v3AndV4PatternsDifferForTheSameWord pins that a
// shared implementation cannot satisfy both.
const vol_market_key_v3_pattern = fn (pool_addr: u256) u256 {
    @evm_shr(120, pool_addr & MASK_U160) & MASK_U40
};

// vegoid == 0 is rejected HERE as well as in the payload. The two are different entry points and
// neither may depend on the other having been called: a poolId composed with vegoid 0 carries a
// value the SFPM itself refuses (Errors.InvalidTokenIdParameter(0)).
const vol_market_key_compose_pool_id = fn (pattern: u256, vegoid: u256, tick_spacing: u256) u256 {
    require(vegoid != 0);
    (pattern & MASK_U40)
    | @evm_shl(POOL_ID_OFF_VEGOID_KEY, vegoid & 0xff)
    | @evm_shl(POOL_ID_OFF_TICK_SPACING, tick_spacing & 0xffff)
};

// ---- KEY-03 / KEY-02: registry verification and the SFPM-checked poolId ----------------------
//
// Plank std has NO general external-call helper: across std/ at 00c0a1a only std/precompile.plk
// makes calls, and it is hardcoded to precompiles 0x01-0x05. This is that same idiom -- malloc,
// mstore, staticcall, require(success), mload -- which is also what
// AlgebraIntegralShocksWriterMod builds by hand. Nothing is being reinvented.

// getPool(address,address,uint24)   univ3 factory
const SEL_GET_POOL = 0x1698ee82;
// poolByPair(address,address)       algebra factory
const SEL_POOL_BY_PAIR = 0xd9a641e1;
// getPoolId(bytes,uint8)            BOTH SFPMs (V4.sol:1369, V3.sol:1558)
const SEL_SFPM_GET_POOL_ID = 0xb33eb6f3;

const staticcall_word = fn (target: u256, args_ptr: u256, args_len: u256) u256 {
    let ret = @malloc_uninit(32);
    let ok = @evm_staticcall(@evm_gas(), target, args_ptr, args_len, ret, 32);
    require(ok);
    @mload32(ret)
};

// The canonical univ4 PoolId: keccak256 over the 5-field PoolKey, 160 bytes. Generic over V so the
// Panoptic arm can call it from inside a comptime branch without relying on VolMarketKey(V)
// unifying with VolMarketKey(V4) -- a unification nothing in std attests.
const vol_market_key_pool_key_hash = fn (comptime V: type, k: VolMarketKey(V)) u256 {
    let buf = @malloc_uninit(160);
    @mstore32(buf, k.currency0);
    @mstore32(buf +% 32, k.currency1);
    @mstore32(buf +% 64, k.fee);
    @mstore32(buf +% 96, k.tick_spacing);
    @mstore32(buf +% 128, k.registry);   // V4: hooks
    @evm_keccak256(buf, 160)
};

// The V4-only public spelling. This is the value market_id_from_pool_key computes in MarketId.plk,
// which VolMarketKey(V4) SUBSUMES rather than duplicates (KEY-05).
const vol_market_key_v4_pool_id = fn (k: VolMarketKey(V4)) u256 {
    vol_market_key_pool_key_hash(V4, k)
};

// Verify the SUPPLIED pool address against the venue registry. Never CREATE2: SFPM V3 resolves its
// own pool as FACTORY.getPool(token0, token1, fee), and taking the same route means no
// POOL_INIT_CODE_HASH is pinned anywhere, so a fork with a patched pool contract cannot silently
// yield a wrong address.
const vol_market_key_verify_pool = fn (comptime V: type, k: VolMarketKey(V)) void {
    let resolved = if V == V3 {
        let p = @malloc_uninit(100);
        @mstore4(p, SEL_GET_POOL);
        @mstore32(p +% 4, k.currency0);
        @mstore32(p +% 36, k.currency1);
        @mstore32(p +% 68, k.fee);
        staticcall_word(k.registry, p, 100)
    } else if V == Algebra {
        let p = @malloc_uninit(68);
        @mstore4(p, SEL_POOL_BY_PAIR);
        @mstore32(p +% 4, k.currency0);
        @mstore32(p +% 36, k.currency1);
        staticcall_word(k.registry, p, 68)
    } else {
        @compile_error("VolMarketKey: only V3 and Algebra have a pool address to verify");
    };
    require(resolved == k.pool);
};

// DERIVE the candidate, then VERIFY it against the SFPM.
//
// The Panoptic poolId is STATEFUL. Both SFPMs loop
//     while (s_poolIdToKey[poolId].tickSpacing != 0) poolId = incrementPoolPattern(poolId)
// on a 40-bit pattern collision -- "a modern GPU can generate a collision in such a space
// relatively quickly" -- and enforce the stored value at mint (V4.sol:787). So a pure derivation
// yields a CANDIDATE, not an answer, and verifying here makes a collision fail with OUR error at
// build time instead of Panoptic's three calls away at mint.
//
// V4 and V3 ONLY. There is no PanopticFactoryAlgebra, so the Algebra arm has no Panoptic
// continuation and must not be given a synthetic one (KEY-04).
const vol_market_key_to_panoptic_pool_id =
    fn (comptime V: type, k: VolMarketKey(V), sfpm: u256, vegoid: u256) u256 {
    let pattern = if V == V4 {
        vol_market_key_v4_pattern(vol_market_key_pool_key_hash(V, k))
    } else if V == V3 {
        vol_market_key_verify_pool(V, k);
        vol_market_key_v3_pattern(k.pool)
    } else {
        @compile_error("VolMarketKey: the Panoptic arm accepts only V4 or V3");
    };

    let candidate = vol_market_key_compose_pool_id(pattern, vegoid, k.tick_spacing);

    // The id word the SFPM decodes: the v4 PoolId for V4, the pool ADDRESS for V3.
    let id_word = if V == V4 { vol_market_key_pool_key_hash(V, k) } else { k.pool };

    // getPoolId(bytes id, uint8 vegoid). `id` is a DYNAMIC type, so this is NOT a two-word frame:
    //     0   selector | 4  offset = 0x40 | 36  vegoid | 68  id.length = 32 | 100  id word
    // = 132 bytes. An earlier draft used 68 and the SFPM would have decoded garbage.
    let p = @malloc_uninit(132);
    @mstore4(p, SEL_SFPM_GET_POOL_ID);
    @mstore32(p +% 4, 0x40);
    @mstore32(p +% 36, vegoid);
    @mstore32(p +% 68, 32);
    @mstore32(p +% 100, id_word);
    require(candidate == staticcall_word(sfpm, p, 132));

    candidate
};
