
import pos_spec::TickVolatility::*;
import lib::market_state_measurements::RealizedVolatilityLib::*;
import std::core_ops::bool_to_u256;

const INIT_STORAGE_INDEX = 0;
const INIT_TIME_WINDOW = 0; 

// 242 bits
const Timepoint = struct {
      timestamp: u256, // 32
      realizedVolatility :TickVolatility, // 88
      tick: u256,  // 24
      avg_tick: u256,  // 24
      min_tick: u256,  // 24
      tick_cumulative: u256,  // 24
      time_window_start_index: u256, // 16
      initialized: bool
};

// pack_timepoint is the exact inverse of unpack_timepoint: Timepoint -> u256.
//
// This previously existed twice -- once as an empty `fn(self: Timepoint) u256 {}` stub and
// once as an 8-arg field-wise variant. Plank has no overloading, so that was a hard
// "duplicate definition". The struct-taking form is kept (it mirrors unpack_timepoint, and
// it is the shape the callers in RealizedVolatilityMod actually want); callers that used
// the field-wise form now build a Timepoint literal and pack that.
//
// The old 8-arg signature also declared a `max_tick` parameter while its body packed
// `tick_cumulative` -- `max_tick` was never used and `tick_cumulative` was unbound. The
// struct field is `tick_cumulative`, so that is what is packed here.
const pack_timepoint = fn(self: Timepoint) u256 {
    (self.timestamp & 0xFFFFFFFF)
    | @evm_shl(32, self.realizedVolatility.vol & 0xFFFFFFFFFFFFFFFFFFFFFF)
    | @evm_shl(120, self.tick & 0xFFFFFF)
    | @evm_shl(144, self.avg_tick & 0xFFFFFF)
    | @evm_shl(168, self.min_tick & 0xFFFFFF)
    | @evm_shl(192, self.tick_cumulative & 0xFFFFFF)
    | @evm_shl(216, self.time_window_start_index & 0xFFFF)
    | @evm_shl(232, bool_to_u256(self.initialized))
};


const unpack_timepoint = fn(packed: u256) Timepoint {
    Timepoint {
        timestamp:
            packed & 0xFFFFFFFF,

        realizedVolatility: TickVolatility {
            vol:
                @evm_shr(32, packed)
                & 0xFFFFFFFFFFFFFFFFFFFFFF
        },

        tick:
            @evm_shr(120, packed)
            & 0xFFFFFF,

        avg_tick:
            @evm_shr(144, packed)
            & 0xFFFFFF,

        min_tick:
            @evm_shr(168, packed)
            & 0xFFFFFF,

        tick_cumulative:
            @evm_shr(192, packed)
            & 0xFFFFFF,

        time_window_start_index:
            @evm_shr(216, packed)
            & 0xFFFF,

        initialized:
            @evm_eq(
                @evm_shr(232, packed) & 1,
                1
            )
    }
};

const create_timepoint = fn(
    current: Timepoint,
    last_timestamp: u256,
    tick: u256,
    avg_tick: u256,
    window_start_index: u256
) Timepoint {
    
    let delta = @evm_sub(last_timestamp, current.timestamp);

    let realized_vol_delta = calculate_realized_volatility( current.avg_tick, avg_tick,tick,tick,delta);

    let next_realized_volatility = TickVolatility { vol: @evm_add(current.realizedVolatility.vol,realized_vol_delta.vol)};

    let next_min_tick = if @evm_slt(tick, current.min_tick) { tick } else { current.min_tick };
    // tick_cumulative ACCUMULATES -- it is a running integral of tick over time, so the new
    // value is the previous cumulative plus this interval's contribution. Algebra:
    //   last.tickCumulative += int56(tick) * int56(uint56(delta));
    // (this line previously read `next_tick_cumulative = @evm_mul(tick, delta)` -- missing
    // both the `let` binding and the carry-forward of current.tick_cumulative, which would
    // have reset the integral on every write.)
    let next_tick_cumulative = @evm_add(current.tick_cumulative, @evm_mul(tick, delta));
    Timepoint {
        timestamp: last_timestamp,
        realizedVolatility: next_realized_volatility,
        tick: tick,
        avg_tick: avg_tick,
        min_tick: next_min_tick,
        tick_cumulative: next_tick_cumulative,
        time_window_start_index: window_start_index,
        initialized: true
    }
};