use custom_utils::moreRegions::storage;

use std::core::uint::_type_of;
use std::membytes::{membytes,membytes_from_ptr,membytes_read_u256};
use std::option::{unwrap,Some};
use std::regions::{calldata,memory};
use std::mem::unsafe_mem_write;
use std::slice::*;
use std::core::ops::greater_equals;
use std::error::{comptime_assert, require};

// cast keccak vol-markets.TickMoments.Window
const WINDOW_SLOT = 0x11a586e09432f3d1b89c99706d3b8f3173c77004ae593e7e676b5ed839be424c;
// cast sig "set_window(uint256)"
const SET_WINDOW_SELECTOR = 0xdd7afeac;



const INVALID_WINDOW_LEN = 0;
const WINDOW_LEN_CALLDATA_IDX = 0;
const WINDOW_NOT_INITIALIZED_INDEX_VAL = 0;
const STEP_IDX = 1;
const WINDOW_LEN_ONE = 1;
const WINDOW_NOT_INITIALIZED_LEN_VAL = 1;
const WINDOW_UNINITIALIZED = 2;
const WINDOW_INITIALIZED = 3;

const WindowNotInitialized = struct{};
const WindowInitialized = struct {};

const WindowCalldata = tuple{ u256, u256};
const WindowFromCalldataToMemory = Slice(memory, u256, Some(2));

const Window = fn (comptime S: type) type {
      if (S != WindowNotInitialized) & (S != WindowInitialized) {
      	 @compile_error("Window: state must be WindowNotInitialized or WindowInitialized");
      }
      struct (S) {
      	    len: u256,
	    idx: u256
      }
};


const state_to_word = fn (state: type) u256 {
      let mut st_ui256: u256 = 0;
      if state == WindowNotInitialized   { st_ui256 = WINDOW_UNINITIALIZED; }
      else if state == WindowInitialized { st_ui256 = WINDOW_INITIALIZED; }
      st_ui256          
};

const window_len = fn (self: $W) u256 {
      self.len
};

const window_idx = fn(self: $W) u256 {
      self.idx
};

const window_state = fn (on : type) u256 {
      let mut windowStateQueried: u256 = WINDOW_UNINITIALIZED;      
      if on == storage {
      	 windowStateQueried = @evm_sload(window_state_slot(WINDOW_SLOT));
      }
      windowStateQueried
};

const isWindowInitialized = fn (window: $W) bool {
      (@evm_gt(window_idx(window),WINDOW_NOT_INITIALIZED_INDEX_VAL) & @evm_gt(window_len(window)),WINDOW_NOT_INITIALIZED_LEN_VAL)
};

const isNotWindowInitialized = fn(window: $W) bool {
      !isWindowInitialized (window)
};


const nill_window = fn() Window(WindowNotInitialized) {
      Window(WindowNotInitialized) { len: WINDOW_NOT_INITIALIZED_LEN_VAL, idx: WINDOW_NOT_INITIALIZED_INDEX_VAL }
};

const window_len_slot  = fn(ws: u256) u256 {
      require(WINDOW_SLOT == ws);
      WINDOW_SLOT
};

const window_idx_slot  = fn(ws: u256) u256 {
      require(WINDOW_SLOT == ws);
      @evm_add(WINDOW_SLOT,1)
};

const window_state_slot = fn(ws: u256) u256 {
      require(WINDOW_SLOT == ws);
      @evm_add(WINDOW_SLOT,2)
};

const store_window = fn (window: $W, windowState: type ,to:type) void {
      if to == storage {
      	 @evm_sstore(window_len_slot(WINDOW_SLOT), window_len(window));
	 @evm_sstore(window_idx_slot(WINDOW_SLOT), window_idx(window));
	 @evm_sstore(window_state_slot(WINDOW_SLOT), state_to_word(windowState));
      }
};

const InvalidWindowRuntimeConstructor = struct{};

const windowRevertEVMDueTo = fn(window: $W) void {
      let revertBuffer : u256 = @malloc_uninit(4);
      if @evm_or(@evm_iszero(window_len(window)),@evm_gt(window_idx(window),window_len(window))) {
      	 // cast sig "InvalidWindowRuntimeConstructor()"
      	 @mstore4(revertBuffer, 0x1d44e4ed);
      	 @evm_revert(revertBuffer,4);
      }
};

const proposedWindow = fn(len :u256, idx: u256) Window(WindowNotInitialized) {
      Window(WindowNotInitialized) {len: len, idx: idx}
};


const build_window = fn(from: $O) Window(WindowNotInitialized) {
      let mut windowLenBuilt: u256 = WINDOW_NOT_INITIALIZED_LEN_VAL;
      let mut windowIdxBuilt: u256 = WINDOW_NOT_INITIALIZED_INDEX_VAL;
      
      if O == WindowCalldata {
      	 let windowMemory: WindowFromCalldataToMemory = new(memory, from);
      	 windowLenBuilt = unwrap(get(windowMemory, WINDOW_LEN_CALLDATA_IDX));
     }

     if O == storage {
     	windowLenBuilt = @evm_sload(window_len_slot(WINDOW_SLOT));
     	windowIdxBuilt = @evm_sload(window_idx_slot(WINDOW_SLOT));
     }

     windowRevertEVMDueTo(proposedWindow(windowLenBuilt,windowIdxBuilt));
     Window(WindowNotInitialized) { len: windowLenBuilt, idx: windowIdxBuilt } 

};

const fullWindow = fn() Window(WindowInitialized) {
      Window(WindowInitialized) {len: WINDOW_LEN_ONE, idx: WINDOW_NOT_INITIALIZED_LEN_VAL}
};

const update_window = fn(on: type) Window(WindowInitialized) {
      let mut windowUpdated: Window(WindowInitialized) = fullWindow();
      if on == storage {
      	 @evm_sstore(window_state_slot(WINDOW_SLOT),WINDOW_INITIALIZED);
      	 let mut currentWindow : Window(WindowNotInitialized) = build_window(on);
      	 if @evm_lt(window_idx(currentWindow),window_len(currentWindow)) {
	     let idx : u256 = @evm_add(window_idx(currentWindow), STEP_IDX);
	     @evm_sstore(window_idx_slot(WINDOW_SLOT),idx);
	     windowUpdated = Window(WindowInitialized) {len: window_len(currentWindow), idx: idx};
	 }

	 if @evm_eq(window_idx(currentWindow),window_len(currentWindow)) {
	    windowUpdated = Window(WindowInitialized) {len: window_len(currentWindow), idx: window_idx(currentWindow)};
	    currentWindow = restart_window(on);
	 }
      };
      windowUpdated
};

const restart_window = fn (on: type) Window(WindowNotInitialized) {
      if on == storage {
      	 @evm_sstore(window_idx_slot(WINDOW_SLOT),window_idx(nill_window()));
      	 store_window(nill_window(),WindowNotInitialized,on);
      }
      nill_window()
};

const initialize_window = fn(on: type) Window(WindowInitialized) {
      if on == storage {
      	 @evm_sstore(window_state_slot(WINDOW_SLOT), WINDOW_INITIALIZED);
	 update_window(on)
      }    
};