// cast keccak vol-markets.TickMoments.tickAverage
const TICK_AVERAGE_SLOT = 0x639a68f1e2d4af32ba8134bbdb9c46e158a306a8d58cd3f92a9c3e7e5c05a6b3;

const TickAverage = struct {
      window: Window,
      curr: u256
};

const nill_tick_average = fn() TickAverage {
      TickAverage { window : nill_window(), curr: 0}
};

const updatedAverage = fn(R: type, tick:Tick, T: type) TickAverage {
      nill_tick_average()
};

const store_tick_average = fn (origin: type, dst: type,avg: TickAverage) void {
      
};

const fetch_tick_average = fn(origin: type) TickAverage {
      nill_tick_average()
};
