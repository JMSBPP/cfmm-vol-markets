use custom_utils::moreRegions::storage;
use TickMoments::Window::*;
use TickMoments::Tick::*;
use std::core::uint::{u24,try_cast_uint,unsafe_from_u256, cast_uint};
use std::option::{unwrap,Some};
use std::slice::{Slice,new,get};
use std::regions::memory;

// cast keccak vol-markets.TickMoments.tickAverage
const TICK_AVERAGE_SLOT = 0x639a68f1e2d4af32ba8134bbdb9c46e158a306a8d58cd3f92a9c3e7e5c05a6b3;
const TICK_AVERAGE_PREV_TICK_ACC_NOT_INITIALIZED = 0;
// cast sig "read_tick_average()"
const READ_TICK_AVERAGE_SELECTOR = 0x0e97de16;


// note: TickAcc is int56 which aims to encode \(\underbrace{W}_{\texttt{16 bits/window}} \underbrace{i_{\mu}}_{\texttt{19 bits/Tick}}\)
const TickAcc = u256;
// TODO: From now we assume TAS = WS; This is to be verified
const TickAverage = fn(tickAverageState : type ) type {
      struct {
      	     window: Window(tickAverageState),
	     prevTickAcc: TickAcc,
	     tickAvg: Tick
      }
};


const tickAverageReturnEVM = fn() never {
      let retBuff: u256 = @malloc_uninit(32);
      @mstore32(retBuff,@evm_sload(TICK_AVERAGE_SLOT));
      @evm_return(retBuff,32);
};


const set_tickAverage_window = fn(on: type) TickAverage(WindowInitialized) {
      TickAverage (WindowInitialized) {window: update_window(on), prevTickAcc: TICK_AVERAGE_PREV_TICK_ACC_NOT_INITIALIZED }
};


const tickAverageWindow = fn(self: TickAverage(WindowInitialized)) Window(WindowInitialized) {
      self.window
};

const prospectInitializedTickAverage = fn() TickAverage(WindowInitialized) {
      TickAverage(WindowInitialized) {window: fullWindow(), prevTickAcc: TICK_AVERAGE_PREV_TICK_ACC_NOT_INITIALIZED }
};

const initialize_tick_average = fn (on : type) TickAverage(WindowInitialized) {
      let mut tickAverageInitialized : TickAverage(WindowInitialized) = prospectInitializedTickAverage();
      if on == storage {
      	 tickAverageInitialized = set_tickAverage_window(on);
      };

      tickAverageInitialized

};


const toTickAcc =  fn (val:$V) TickAcc {
      if V == Tick {
      	 @evm_sdiv(tickVal(val),1)
      }
};


      let mut prevTickAcc : u256 = TICK_AVERAGE_PREV_TICK_ACC_NOT_INITIALIZED;     

      if U == Tick {
      	 let tick: Tick = inputVal;
      	 prevTickAcc = toTickAcc(tick);      	 
      }

      if U == TickAcc {
      	 prevTickAcc = inputVal
      }
      
      TickAverage (WindowInitialized) {window: tickAverageWindow(tickAverage), prevTickAcc:prevTickAcc}


const update_average = fn (on: type ,tickValue:$T) TickAverage(WindowInitialized) {
      let mut tickAverageOnUpdate : TickAverage(WindowInitialized) = prospectInitializedTickAverage();
      let mut prevTickAcc : u256 = TICK_AVERAGE_PREV_TICK_ACC_NOT_INITIALIZED;
      let mut tickAvg: Tick = toUpdateTick();      
      if on == storage {
      	 if window_state(on) == WINDOW_UNINITIALIZED {
	    tickAverageOnUpdate : TickAverage(WindowInitialized) = initialize_tick_average(on);
	    prevTickAcc = toTickAcc(tickValue);
	    tickAvg = tickValue;
	    tickAverageOnUpdate = TickAverage (WindowInitialized)
	    {window: tickAverageWindow(tickAverage), prevTickAcc:prevTickAcc, tickAvg: tickAvg}
	 }

	 if window_state(on) == WINDOW_INITIALIZED {
	    let updatedTickAcc : TickAcc = AccTick(toTickAcc(storage),toTickAcc(tickValue));
	    // UPDATE TICK AVG operating ithn the window
	    tickAvg = MeanTick(updatedTickAcc, build_window(on));
	 }
	 tickAverageOnUpdate = TickAverage (WindowInitialized) {window: tickAverageWindow(tickAverage), prevTickAcc:prevTickAcc, tickAvg: tickAvg}
      }
      tickAverageUpdated
};

const store_tickAverage = fn (tickAverage:$TA, to: type) void {
      if to == storage {
      	 @evm_sstore(@evm_add(TICK_AVERAGE_SLOT,1), tickAverage.prevTickAcc);
      }
};