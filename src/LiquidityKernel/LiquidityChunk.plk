// 100e18
const DEFAULT_LIQUIDITY_VALUE = 0x0000000000000000000000000000000000000000000000056bc75e2d63100000;
const ZERO_SALT = 0;

const ModifyLiquidityParams = tuple{u256,u256,u256,u256};

const LiquidityChunk  = struct {
      tickLow: u256
      tickUp: u256,
      liquidity: u256
};

const DefaultLiquidity = fn() u256 {
      DEFAULT_LIQUIDITY_VALUE      
};

const LiquidityCalldata = Slice(memory, ModifyLiquidityParams, Some(128));

const DefaultLiquidityCalldata = fn () LiquidityCalldata {
      let defaultLiq: ModifyLiquidityParams = (tickWord(minTick(DefaultTickSpacing())), tickWord(maxTick(DefaultTickSpacing())), DefaultLiquidity(), ZERO_SALT);
      new(memory, defaultLiq)
};


