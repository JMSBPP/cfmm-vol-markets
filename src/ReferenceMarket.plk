import v3::util::{revert_empty, return_u256};
import std:constructor:return_runtime;

init {
     // At init time the init value of the vol termStructure is given and
     // is stored

     // 1. Get the size of the memory data that is given on the constructor
     // 2. read the relevant fields and wrap them on the type
     let initVolTermStructParams = @evm_calldataload(0);
     // 3. store the type on storage
     
     return_runtime();
}

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    if isView(selector) {
        handle_view(selector);
    } else {
        handle_state(selector);
    } 
    @evm_stop();
}



const isView = fn (selector: u256) bool {
    if selector == 0x3b228b3e { return true; }
    if selector == 0x408e87f6 { return true; }
    if selector == 0x065e5360 { return true; }
    if selector == 0x59c4f905 { return true; }
    if selector == 0x55b812a8 { return true; }
    return false;
};

const handle_view = fn (selector: u256) never {
      if selector == 0x3b228b3e {
      	 return_u256(@evm_sload(SLOT_LIQUIDITY));
      } else if selector == 0x408e87f6 {
      	 return_u256(@evm_sload(SLOT_TICK_SPACING));
      } else if selector == 0x065e5360 {
      	 return_u256(@evm_sload(SLOT_CURRENT_TICK));
      } else if selector == 0x59c4f905 {
      	 return_u256(@evm_sload(SLOT_TICK_LOWER));
      } else if selector == 0x55b812a8 {
      	 return_u256(@evm_sload(SLOT_TICK_UPPER));
      } else {
      	 revert_empty();
      }
};

const handle_state = fn (selector: u256) never {
      if selector == 0x08a68255 {
           let _poolLiquidity = @evm_calldataload(4);
	   @evm_sstore(SLOT_LIQUIDITY, _poolLiquidity);
	   let ptr = @malloc_uninit(0);
	   @evm_return(ptr, 0);
      } else if selector == 0x0693ca3b {
       	  let mut _tickSpacing = @evm_calldataload(4);
	  if (_tickSpacing & 0xFFFFFF) >= 0x800000 {
	     _tickSpacing = _tickSpacing | 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF000000;
	  }
	  @evm_sstore(SLOT_TICK_SPACING, _tickSpacing);
	  let ptr = @malloc_uninit(0);
	  @evm_return(ptr, 0);
      } else if selector == 0x8f3f8c52 {
       	  let _currentTick = @evm_calldataload(4);
	  @evm_sstore(SLOT_CURRENT_TICK, _currentTick);
	  let ptr = @malloc_uninit(0);
	  @evm_return(ptr, 0);
      } else if selector == 0x04211dd1 {
       	  let _tickLower = @evm_calldataload(4);
	  // NOTE: We set the tickMin to be the tick lower
	  uint256 _tickSpacing = @evm_sload(SLOT_TICK_SPACING);
	  let minTick = @evm_sdiv(_tickLower, _tickSpacing) *% _tickSpacing;
	  @evm_sstore(SLOT_TICK_LOWER, _tickLower);
	  let ptr = @malloc_uninit(0);
	  @evm_return(ptr, 0);
      } else if selector == 0x37969917 {
       	  let _tickUpper = @evm_calldataload(4);
	  @evm_sstore(SLOT_TICK_UPPER, _tickUpper);
	  let ptr = @malloc_uninit(0);
	  @evm_return(ptr, 0);
       } else {
      	 revert_empty();
      }
};
