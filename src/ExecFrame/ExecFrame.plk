use std::membytes::{
    membytes_write, membytes, membytes_new, membytes_read_u256,
    membytes_from_ptr
};
use std::regions::{
    code, memory
};
use std::slice::{
    new, Slice
};

use custom_utils::protocol_integrations::UniswapV4Consumer::SWAP_TOPIC;
use custom_utils::cfmm_types::Market::{
    MarketMemoryLen, MARKET_ID_SLOT, MarketMemory,MarketKeyMemoryOnExt
};

use custom_utils::more_regions::storage;

use std::option::{
    Some, unwrap
};


use TickMoments::Window::{
    WindowLen
};



const LASNA_CHAIN_ID = 5318007;
const REACTIVE_CHAIN_ID = 1597;
const SYSTEM = 0x8888888888888888888888888888888888888888;
const REACTIVE_IGNORE = 0xa65f96fc951c35ead38878e0f0b7a3c744a6f5ccc1476b313353ce31712313ad;


// cast sig "subscribe(uint256,address,uint256,uint256,uint256,uint256)"
const SUBSCRIBE_SELECTOR = 0x5a6aced0 ;

// cast keccak "ExecFrameListening(bool)"
const EXEC_FRAME_LISTENING_TOPIC = 0x1227acb524d7aa07ee69e714b62f3445b5d1e61777f2bc0531a6be223b740843;


// cast keccak "ExecFrameWindowLen(u256)"
const ExecFrameWindowLen = struct {
      windowLen: WindowLen
};

const InitExecFrameWindowLen = fn (origin :membytes) ExecFrameWindowLen {
      ExecFrameWindowLen {windowLen: unwrap(membytes_read_u256(origin,0))}      
};


const EXEC_FRAME_WINDOW_LEN_TOPIC = 0x402f45325e729fbbea60c3ca601598c3b107c7f7df3ee6c4d10a2b86ff06f789;


const ExecFrameCfg = tuple {u256, u256};

const listen = fn() u256 { 0x1};


const DebugRuntime = struct {
      codeSize : u256,
      runtimeLength: u256,
      initEndOffset: u256
};



const SelfDebugRuntime= fn() DebugRuntime {
      DebugRuntime {
      		   codeSize: @evm_codesize(),
		   runtimeLength: @runtime_length(),
		   initEndOffset: @init_end_offset() 		   
      }
};

const ExpectedInitData = struct {
      windowLen: WindowLen,
      originChainId : u256,
      poolManager:u256,
      io:u256      
};


const ExpectedInitDataFromMemory = fn (memBuffer: membytes) ExpectedInitData {
      ExpectedInitData {
      		       windowLen: unwrap(membytes_read_u256(memBuffer,0)),
		       originChainId: unwrap(membytes_read_u256(memBuffer,32)),
		       poolManager: unwrap(membytes_read_u256(memBuffer,64)),
		       io: unwrap(membytes_read_u256(memBuffer,96))
      }
};

const MemBytesfromPackedToCallable = fn(inputMemBuff: membytes, offset :u256, len: u256) membytes {
      let outputMemBuff: membytes = inputMemBuff;
      if len == 32 {
      	 membytes_write(outputMemBuff,offset,@evm_shr(96, unwrap(membytes_read_u256(inputMemBuff, offset))));}

      else if len == 64 {
      	   membytes_write(outputMemBuff,offset+%32,@evm_shr(96,@evm_or(@evm_shl(160,unwrap(membytes_read_u256(inputMemBuff, offset))),@evm_shr(96,unwrap(membytes_read_u256(inputMemBuff, offset+%32))))));
	   membytes_write(outputMemBuff,offset,@evm_shr(96, unwrap(membytes_read_u256(inputMemBuff, offset))));	   
      }	 	 
      outputMemBuff
};

use custom_utils::unmerged_std::event::emit;

const tmp = struct {blob: membytes};

init {
     // It needs to reserve space to write the windowLen and market id and listening (65)
     let execFrameRuntimeRetMemBuff: membytes = membytes_new(@runtime_length()+%65);

     // Let's log the size of the code on this runtime
     // The runtime length
     // and the init_end_offset
     emit(SelfDebugRuntime());

      // There is only one instruction  on runtime. Thus it's size is 1
     
     // It receives at the end of the runtime code windowLen ,originChainId, poolManager, io -> 128
     
     let mut execFrameReadMemBuff: membytes = membytes_new(128);
     ///           buffer where copying(here), offset in code region (here), lenght of the data to copy(here) 
     @evm_codecopy(execFrameReadMemBuff.ptr,@init_end_offset(),execFrameReadMemBuff.length);
     execFrameReadMemBuff = MemBytesfromPackedToCallable(execFrameReadMemBuff,64,64);

     let execFrameWorkingMemBuff: membytes = membytes_new(196);
          
     if @evm_add(@bool_to_u256(@evm_chainid() == LASNA_CHAIN_ID),@bool_to_u256(@evm_chainid() == REACTIVE_CHAIN_ID)) ==  0 {
	   // cast sig "ExecFrameInvalidEnv()"
	   @mstore4(execFrameWorkingMemBuff.ptr,0x50b371ea);
	   @evm_revert(execFrameWorkingMemBuff.ptr,4);
     }
     
     else {
     	  // It copies the windowLen on the execFrameRuntimeRetMemBuff from execFrameReadMemBuff
	  //  to be revised @mcopy(execFrameReadMemBuff.ptr,execFrameRuntimeRetMemBuff.ptr+%@runtime_length(),32);
	  
	  // emit (tmp {blob: execFrameRuntimeRetMemBuff} );
	  // It logs the len of the window that initialized it
	  emit(InitExecFrameWindowLen(execFrameReadMemBuff));
	  // It subscribes to the Swap event
	  let subscribeMemBuff: membytes = membytes_from_ptr(execFrameWorkingMemBuff.ptr,execFrameWorkingMemBuff.length);
	  @mstore4(subscribeMemBuff.ptr,SUBSCRIBE_SELECTOR);
	  @mcopy(subscribeMemBuff.ptr+%4,execFrameReadMemBuff.ptr+%32,64);
	  membytes_write(subscribeMemBuff,68,SWAP_TOPIC);
	  membytes_write(subscribeMemBuff,100,(REACTIVE_IGNORE,REACTIVE_IGNORE,REACTIVE_IGNORE));
	  if !@evm_call(@evm_gas(), SYSTEM, @evm_selfbalance(), subscribeMemBuff.ptr,subscribeMemBuff.length,subscribeMemBuff.ptr+%subscribeMemBuff.length,0) {
	     	// cast sig "ExecFrameFailedToSubscribe()"
	   	@mstore4(subscribeMemBuff.ptr,0xa2cb2a3e);
	  }
	  let marketMemory :MarketMemory = MarketKeyMemoryOnExt(unwrap(membytes_read_u256(execFrameReadMemBuff,96)), storage);
	  
    }	  
    // 	  // it requests the market Key from the reference io passed at deploy time	  
    // 	  // let marketMemory :MarketMemory = MarketKeyMemoryOnExt(unwrap(membytes_read_u256(execFrameReadMemBuff,96)), storage);
    // 	  // let marketId: u256 = @evm_keccak256(marketMemory.ptr,MarketMemoryLen(marketMemory));
    // 	  // It stores on execFrameRuntimeRetMemBuff the marketId
    // 	  // membytes_write(execFrameRuntimeRetMemBuff,@init_end_offset()+%32,marketId);
	  
    // 	  // It sets it's state to listening
    // 	  // @mstore1(execFrameRuntimeRetMemBuff.ptr+%@init_end_offset()+%64,listen());
    // }
    
    @evm_codecopy(execFrameRuntimeRetMemBuff.ptr, @runtime_start_offset(), @runtime_length());
    @evm_return(execFrameRuntimeRetMemBuff.ptr, execFrameRuntimeRetMemBuff.length);
}


run {
    @evm_stop();
}