// cast keccak "ExecFrameListening(bool)"
const EXEC_FRAME_LISTENING_TOPIC = 0x1227acb524d7aa07ee69e714b62f3445b5d1e61777f2bc0531a6be223b740843;

// cast sig "listening()"
const LISTENING_SELECTOR = 0xea0caa68;
// cast sig "remainingStateUpdatesToListen()"
const REMAINING_STATE_UPDATES_TO_LISTEN_SELECTOR = 0xc82056f6;

// cast keccak "ExecFrameWindowLen(u256)"
const ExecFrameWindowLen = struct {
      windowLen: WindowLen
};

const InitExecFrameWindowLen = fn (origin :membytes) ExecFrameWindowLen {
      ExecFrameWindowLen {windowLen: unwrap(membytes_read_u256(origin,160))}      
};



const EXEC_FRAME_WINDOW_LEN_TOPIC = 0x402f45325e729fbbea60c3ca601598c3b107c7f7df3ee6c4d10a2b86ff06f789;


const ExecFrameCfg = tuple {u256, u256};

const listen = fn() u256 { 0x1};


const DebugRuntime = struct {
      codeSize : u256,
      runtimeLength: u256,
      initEndOffset: u256
};



const SelfDebugRuntime= fn() DebugRuntime {
      DebugRuntime {
      		   codeSize: @evm_codesize(),
		   runtimeLength: @runtime_length(),
		   initEndOffset: @init_end_offset() 		   
      }
};



const ExpectedInitData = struct {
      windowLen: WindowLen,
      originChainId : u256,
      poolManager:u256,
      io:u256      
};


const ExpectedInitDataFromMemory = fn (memBuffer: membytes) ExpectedInitData {
      ExpectedInitData {
      		       windowLen: unwrap(membytes_read_u256(memBuffer,0)),
		       originChainId: unwrap(membytes_read_u256(memBuffer,32)),
		       poolManager: unwrap(membytes_read_u256(memBuffer,64)),
		       io: unwrap(membytes_read_u256(memBuffer,96))
      }
};

const MemBytesfromPackedToCallable = fn(inputMemBuff: membytes, offset :u256, len: u256) membytes {
      let outputMemBuff: membytes = inputMemBuff;
      if len == 32 {
      	 membytes_write(outputMemBuff,offset,@evm_shr(96, unwrap(membytes_read_u256(inputMemBuff, offset))));}

      else if len == 64 {
      	   membytes_write(outputMemBuff,offset+%32,@evm_shr(96,@evm_or(@evm_shl(160,unwrap(membytes_read_u256(inputMemBuff, offset))),@evm_shr(96,unwrap(membytes_read_u256(inputMemBuff, offset+%32))))));
	   membytes_write(outputMemBuff,offset,@evm_shr(96, unwrap(membytes_read_u256(inputMemBuff, offset))));	   
      }	 	 
      outputMemBuff
};

use custom_utils::unmerged_std::event::emit;

const tmp = struct {blob: membytes};

use std::fixedbytes::{
    bytes32, bytes32_from_u256
};


const LogBytes32 = struct {value: bytes32 };


use custom_utils::protocol_integrations::ReactiveCost::{
    ReactiveCostSocket, initialize_socket, reactive, ServiceDisbursement
};


const SocketCfgInitData = tuple {u256,u256,u256, u256, u256,u256, u256, u256};

const SocketCfgInit = struct {
     originChainId: u256,
     poolManager: u256,
     swapTopic: u256,
     marketId: u256,
     sys: u256,
     windowLen: u256,
     service: u256,
     callbackChainId: u256
};

const socketCfgInitMemLen = fn () u256 {
      @field_count(SocketCfgInit)*32
};

const socketCfgDataFromStruct = fn ( S :SocketCfgInit) SocketCfgInitData {
      (@get_field(S, "originChainId"), @get_field(S, "poolManager"), @get_field(S, "swapTopic"), @get_field(S, "marketId"), @get_field(S, "sys"), @get_field(S, "windowLen"), @get_field(S, "service"), @get_field(S, "callbackChainId"))     
};

init {
     let mut execFrameReadMemBuff: membytes = membytes_new(socketCfgInitMemLen());
     @evm_codecopy(execFrameReadMemBuff.ptr,@init_end_offset(),execFrameReadMemBuff.length);
     let socketCfgInit: SocketCfgInit = abi_decode(SocketCfgInit, execFrameReadMemBuff);

     let socketCfgInitDataMemBuff : Slice(memory, u256, Option(u256) { inner: @field_count(SocketCfgInit), is_some: true }) = new(memory, socketCfgDataFromStruct(socketCfgInit));
     
     let serviceRef: u256 = socketCfgInit.service;
     ReactiveCostSocket(initialize_socket, serviceRef);
     emit(InitExecFrameWindowLen(execFrameReadMemBuff));
     let sysRef: u256 = socketCfgInit.sys;
	  // It subscribes to the Swap event
      let subscribeMemBuff: membytes = membytes_new(196);
      @mstore4(subscribeMemBuff.ptr,SUBSCRIBE_SELECTOR);
      @mcopy(subscribeMemBuff.ptr+%4,execFrameReadMemBuff.ptr,160);
      membytes_write(subscribeMemBuff,164,REACTIVE_IGNORE);
      if !@evm_call(@evm_gas(), serviceRef, 0, subscribeMemBuff.ptr,subscribeMemBuff.length,subscribeMemBuff.ptr+%subscribeMemBuff.length,0) {
	     	// cast sig "ExecFrameFailedToSubscribe()"
	   	@mstore4(subscribeMemBuff.ptr,0xa2cb2a3e);
     }
      let windowLen :WindowLen = socketCfgInit.windowLen;
      InitializeWindowOnRegion(windowLen, storage);

    let execFrameRuntimeRetMemBuff: membytes = membytes_new(@runtime_length()+%socketCfgInitMemLen());
    @evm_codecopy(execFrameRuntimeRetMemBuff.ptr, @runtime_start_offset(), @runtime_length());
    membytes_write(execFrameRuntimeRetMemBuff,@runtime_length(),socketCfgInit);
    @evm_return(execFrameRuntimeRetMemBuff.ptr, execFrameRuntimeRetMemBuff.length);
}

const EventId = u256;

const listening = fn() bool { WindowDelta(WindowFromRegion(storage)) != 0 };

const ReturnListening = fn () never {
      let returnListeningMemBuff: membytes = membytes_new(32);
      membytes_write(returnListeningMemBuff,0,@bool_to_u256(listening()));
      @evm_return(returnListeningMemBuff.ptr, returnListeningMemBuff.length);
};

const execFrameCallbackDst = fn () CallbackDst {
      let mut resExFrameCallbackDst: CallbackDst = UnsetCallbackDst();
      resExFrameCallbackDst = @set_field(resExFrameCallbackDst, "callbackChainId", execFrameCallbackChainId());
      resExFrameCallbackDst= @set_field(resExFrameCallbackDst, "toCall", execFrameCallbackToCall());
      resExFrameCallbackDst
};

const execFrameCallbackChainId = fn() ChainId {
      let execFrameCallbackChainIdMemBuff: membytes = membytes_new(32);
      @evm_codecopy(execFrameCallbackChainIdMemBuff.ptr,@evm_sub(@evm_codesize(),32),32);
      unwrap(membytes_read_u256(execFrameCallbackChainIdMemBuff,0))
};
const execFrameCallbackToCall = fn() u256 {
      let execFrameCallbackToCallIdMemBuff: membytes = membytes_new(32);
      @evm_codecopy(execFrameCallbackToCallIdMemBuff.ptr,@evm_sub(@evm_codesize(),@field_count(SocketCfgInit)-%@field_index(SocketCfgInit, "sys")),32);
      unwrap(membytes_read_u256(execFrameCallbackToCallIdMemBuff,0))
};

const execFrameService = fn() u256 {
     let execFrameServiceMemBuff: membytes = membytes_new(32);
     @evm_codecopy(execFrameServiceMemBuff.ptr,@evm_sub(@evm_codesize(),@field_count(SocketCfgInit)-%@field_index(SocketCfgInit, "service")),32);
     unwrap(membytes_read_u256(execFrameServiceMemBuff,0))
};

run {

    ServiceDisbursement(reactive, ServiceOn(code,32));
    let selector = @evm_shr(224,@evm_calldataload(0));
    
    if selector == LISTENING_SELECTOR { ReturnListening(); }
    else if selector == REMAINING_STATE_UPDATES_TO_LISTEN_SELECTOR {
    	 let remainingStateUpdatesMemBuff: membytes = membytes_new(32);
    	 let remainingStateUpdatesCount: u256 = WindowDelta(WindowFromRegion(storage));
	 membytes_write(remainingStateUpdatesMemBuff,0,remainingStateUpdatesCount);
	 @evm_return(remainingStateUpdatesMemBuff.ptr,remainingStateUpdatesMemBuff.length);
    }
    
    else if selector == REACT_SELECTOR {
        let subscribedEventId : EventId = @evm_calldataload(100);
        // if subscribedEventId == BLACKLIST_CONTRACT_TOPIC0 {}

	if subscribedEventId == SWAP_TOPIC {
	   let lastWindowTimestamp: WindowTimestamp = WindowTimestampOn(storage);
	   UpdateWindowOnRegion(storage);
	   let windowDeltaTimeData : WindowDeltaTimeData = WindowDeltaTimeDataFromLastTimestampOnRegion(storage, lastWindowTimestamp);
	   let callbackCalldata: membytes = CallbackCalldata(WINDOW_TIMESTAMP_PACK_SELECTOR,windowDeltaTimeData);
	   let requestCallbackV_1_0CalldataMemBuff :membytes = RequestCallbackV_1_0Calldata(execFrameCallbackDst(), callbackCalldata);

	   if !@evm_call(@evm_gas(), execFrameService(), NO_VALUE, requestCallbackV_1_0CalldataMemBuff.ptr, requestCallbackV_1_0CalldataMemBuff.length,0,0)
	   {
		// cast sig "FailedOnCallback()"
		@mstore4(requestCallbackV_1_0CalldataMemBuff.ptr, 0xe306f6a2);
		@evm_revert(requestCallbackV_1_0CalldataMemBuff.ptr,4);
	   }

	}
	
    }
    
    @evm_return(@malloc_zeroed(32),32);
}