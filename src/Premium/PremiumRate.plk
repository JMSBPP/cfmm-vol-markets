use std::core::uint::{
    u16, try_cast_uint
};
use std::option::{unwrap, is_some};
use std::regions::calldata;
use custom_utils::moreRegions::storage;
use custom_utils::protocol_integrations::UniswapV4Consumer::{
    EXTSLOAD_SELECTOR, POOLS_SLOT, POOL_MANAGER_SLOT
};
use Asset::Asset::AssetMemory;

// uniswap is a struct { ref : POOL_MANAGER} type
const uniswap = struct { ref: u256 };

// cast keccak VolMarkets.PremiumRate

const PREMIUM_RATE_SLOT = 0x8282207cddb7dec248797bd40ba3d2a32ae0064c024d6111c59444eb63520853;

// cast sig "setPremiumRate(uint24)"
const SET_PREMIUM_RATE_SELECTOR = 0x39556ec8;

// cast sig "readPremiumRate()"
// readPremiumRate is to be placed on Main and do ReturnPremiumRate (PremiumRateOnProtocol (uniswap, loadAssetMemory (storage)))
const READ_PREMIUM_RATE_SELECTOR = 0xdce69e18;

const PremiumRate = u16;

// Algebra Constants.MAX_DEFAULT_FEE
const MAX_FEE_RATE = 50000;

// Uniswap v4 Slot0: lpFee at bit 208
const LP_FEE_OFFSET = 208;
const LP_FEE_MASK = 0xffffff;

const OverFlowPremiumRate = struct {};
const UpdatePremiumRate = struct {};

const PremiumRateWord = fn (premiumRate :PremiumRate) u256 {
    unwrap(try_cast_uint(premiumRate, u256))
};

const NullPremiumRate = fn () PremiumRate {
    unwrap(try_cast_uint(0, u16))
};

const MinPremiumRate = fn () PremiumRate {
    unwrap(try_cast_uint(0, u16))
};

const MaxPremiumRate = fn () PremiumRate {
      unwrap(try_cast_uint(MAX_FEE_RATE, u16))
};

const LogPremiumRate = fn (val: PremiumRate, log: type) void {
      let logMemPtr: u256 = @malloc_uninit(32);
      if log == OverFlowPremiumRate {
      	 @mstore32(logMemPtr, PremiumRateWord(val));
      	 @evm_log1(logMemPtr, 32, @keccak256_cbytes("OverFlowPremiumRate(uint16)"));
      	 LogPremiumRate(MaxPremiumRate(), UpdatePremiumRate);
      }
      else if log == UpdatePremiumRate {
      	 @mstore32(logMemPtr, PremiumRateWord(val));
      	 @evm_log1(logMemPtr, 32, @keccak256_cbytes("UpdatePremiumRate(uint16)"));
      }
};

const PremiumRateFromWord = fn(premiumRateWord :u256) PremiumRate {
    let maxRate = MaxPremiumRate();
    if premiumRateWord > PremiumRateWord(maxRate) {
      	 let castOpt = try_cast_uint(premiumRateWord, u16);
      	 let mut overflowVal = unwrap(try_cast_uint(0xffff, u16));
      	 if is_some(u16, castOpt) {
      	     overflowVal = unwrap(castOpt);
      	 }
      	 LogPremiumRate(overflowVal, OverFlowPremiumRate);
      	 maxRate
    }
    else {
      	 unwrap(try_cast_uint(premiumRateWord, u16))
    }
};

const StoredPremiumRateOn = fn (on: type, from: type) PremiumRate {
      let mut toStorePremiumRate : PremiumRate = NullPremiumRate ();
      if on == storage {
      	 if from == calldata {
	    toStorePremiumRate = PremiumRateFromWord(@evm_calldataload(4));	    	 
	    @evm_sstore(PREMIUM_RATE_SLOT, PremiumRateWord(toStorePremiumRate));
	 }

	 else if from == storage {
	      toStorePremiumRate = PremiumRateFromWord(@evm_sload(PREMIUM_RATE_SLOT));
	 }
      }
      toStorePremiumRate
};

const NoReturnPremiumRate = fn (self: PremiumRate) never {
      @evm_return(@malloc_uninit(0), 0);
};

const ReturnPremiumRate = fn (self: PremiumRate) never {
      let ret: u256 = @malloc_uninit(32);
      @mstore32(ret, PremiumRateWord(self));
      @evm_return(ret, 32);
};

// protocol is type; branch if protocol == uniswap
const PremiumRateOnProtocol = fn (protocol: type, assetMemory: AssetMemory) PremiumRate {
      if protocol == uniswap {
      	 let packed: u256 = @malloc_uninit(64);
      	 @mstore32(packed, @evm_keccak256(assetMemory.ptr, 160));
      	 @mstore32(packed +% 32, POOLS_SLOT);
      	 let cd: u256 = @malloc_uninit(36);
      	 @mstore4(cd, EXTSLOAD_SELECTOR);
      	 @mstore32(cd +% 4, @evm_keccak256(packed, 64));
      	 let retBuff: u256 = @malloc_uninit(32);
      	 if !@evm_staticcall(@evm_gas(), @evm_sload(POOL_MANAGER_SLOT), cd, 36, retBuff, 32) {
      	      // cast sig "FailedOnReadSlot0()"
      	      @mstore4(cd, 0x295cbff3);
      	      @evm_revert(cd, 4);
      	 }
      	 let lpFee = @evm_and(@evm_shr(LP_FEE_OFFSET, @mload32(retBuff)), LP_FEE_MASK);
      	 PremiumRateFromWord(lpFee)
      }
      else {
      	 @compile_error("PremiumRateOnProtocol: only uniswap");
      }
};
