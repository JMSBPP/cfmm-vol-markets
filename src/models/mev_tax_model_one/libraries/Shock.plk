import std::regions::*;
import v3::util::revert_empty;

// Flag bits (canonical component order). A shock's tagged hookData is:
//   flags(uint8) || [tickDiff(int24)] || [txlVolmNormRate(uint24)] || [txlVolmDecay(uint24)]
// present components only, 3 bytes each, big-endian, tightly packed. See the design spec.
const FLAG_TICK_DIFF = 0x01;
const FLAG_NORM_RATE = 0x02;
const FLAG_DECAY     = 0x04;
const FLAGS_MASK     = 0x07;
const MASK_U24       = 0xffffff;

// Shock(R): a validated view over packed hookData living in region R (memory | calldata).
const Shock = fn (comptime R: type) type {
    return struct {
        data: bytes(R),
        flags: u256,
    };
};

// Region-generic 32-byte load: the one place that branches on where the bytes live.
const shock_load_word = fn (comptime R: type, ptr: region_ptr_type(R)) u256 {
    if R == memory { return @mload32(ptr); }
    if R == calldata { return @evm_calldataload(ptr); }
    @compile_error("Shock: unsupported region (expected memory or calldata)");
};

// Build packed hookData in memory. Present fields are masked to 24 bits (two's-complement for
// tick_diff) and OR'd into one big-endian word; length is set to 1 + 3*k so reads touch only the
// payload prefix. A field at byte offset o sits at bits [255-8o : 232-8o] -> shift left 232 - 8o.
const shock_encode = fn (tick_diff: u256, norm_rate: u256, decay: u256, flags: u256) bytes(memory) {
    let f = flags & FLAGS_MASK;
    let mut off = 1;
    let mut packed = @evm_shl(248, f);                       // flags in the most-significant byte
    if (f & FLAG_TICK_DIFF) != 0 {
        packed = packed | @evm_shl(232 -% (off *% 8), tick_diff & MASK_U24);
        off = off +% 3;
    }
    if (f & FLAG_NORM_RATE) != 0 {
        packed = packed | @evm_shl(232 -% (off *% 8), norm_rate & MASK_U24);
        off = off +% 3;
    }
    if (f & FLAG_DECAY) != 0 {
        packed = packed | @evm_shl(232 -% (off *% 8), decay & MASK_U24);
        off = off +% 3;
    }
    let ptr = @malloc_uninit(32);                            // full-word scratch; top `off` bytes are payload
    @mstore32(ptr, packed);
    bytes(memory) { ptr: ptr, length: off }
};

// Decode = read the flags byte, validate reserved bits and length, wrap as a view. No copy.
const shock_decode = fn (comptime R: type, buf: bytes(R)) Shock(R) {
    let flags = @evm_shr(248, shock_load_word(R, buf.ptr));  // leading byte
    if flags > FLAGS_MASK { revert_empty(); }                // reserved high bits set -> malformed
    let k = (flags & 0x01) +% (@evm_shr(1, flags) & 0x01) +% (@evm_shr(2, flags) & 0x01);
    if buf.length != 1 +% (3 *% k) { revert_empty(); }       // length must be derived from flags
    Shock(R) { data: buf, flags: flags }
};

// Accessors: 0 if the bit is unset, else the 3-byte field at its computed offset.
const shock_tick_diff = fn (comptime R: type, s: Shock(R)) u256 {
    if (s.flags & FLAG_TICK_DIFF) == 0 { return 0; }
    let raw = @evm_shr(232, shock_load_word(R, s.data.ptr +% 1)) & MASK_U24;
    @evm_signextend(2, raw)                                  // signed int24
};

const shock_txl_volm_norm_rate = fn (comptime R: type, s: Shock(R)) u256 {
    if (s.flags & FLAG_NORM_RATE) == 0 { return 0; }
    let mut off = 1;
    if (s.flags & FLAG_TICK_DIFF) != 0 { off = off +% 3; }
    @evm_shr(232, shock_load_word(R, s.data.ptr +% off)) & MASK_U24
};

const shock_txl_volm_decay = fn (comptime R: type, s: Shock(R)) u256 {
    if (s.flags & FLAG_DECAY) == 0 { return 0; }
    let mut off = 1;
    if (s.flags & FLAG_TICK_DIFF) != 0 { off = off +% 3; }
    if (s.flags & FLAG_NORM_RATE) != 0 { off = off +% 3; }
    @evm_shr(232, shock_load_word(R, s.data.ptr +% off)) & MASK_U24
};
