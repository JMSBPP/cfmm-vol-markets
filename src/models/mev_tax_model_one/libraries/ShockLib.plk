import model_libraries::Shock::*;

// Behavior layer over the Shock type (Shock.plk holds the type + packed codec). Emits the shock
// event; the pool is an indexed topic so the off-chain subgraph/GAMS bridge can key by pool.
//
// keccak256("Shock(address,int24,uint24,uint24)"); pool is topic1 (indexed).
const SHOCK_EVENT_TOPIC0 = 0x21b0e4f81f5ef89be4325ca74966f2fb8f57a217e284dd3e0a276fff55987d64;

// Emit Shock(pool indexed, tickDiff, txlVolmNormRate, txlVolmDecay). Data words come straight from
// the accessors, already canonicalized (tickDiff sign-extended, rates zero-padded) per the
// VolEventsLib signed-field rule.
const shock_emit = fn (comptime R: type, pool: u256, s: Shock(R)) void {
    let buf = @malloc_uninit(96);
    @mstore32(buf,       shock_tick_diff(R, s));
    @mstore32(buf +% 32, shock_txl_volm_norm_rate(R, s));
    @mstore32(buf +% 64, shock_txl_volm_decay(R, s));
    @evm_log2(buf, 96, SHOCK_EVENT_TOPIC0, pool);
};
