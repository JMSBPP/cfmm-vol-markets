import model_libraries::Shock::*;
import model_libraries::ShockLib::*;
import std::constructor::return_runtime;
import std::regions::*;
import v3::util::revert_empty;

// CHAIN-01 (#26): the deployable Shock emitter. A thin, driveable contract whose one entrypoint
// mines a single canonical Shock(address indexed pool, int24 tickDiff, uint24 txlVolmNormRate,
// uint24 txlVolmDecay) so the rpc_api live loop (offchain/rig/capture-loop.sh) has a Shock to poll.
// The writer's beforeSwap emits the same event but only when a pool swaps (swap-driven); this
// contract another process drives directly, in one mined transaction, with no pool required.
//
// Interface matches capture-loop.sh's DRIVE step with the one correction it invited (pool is an
// ADDRESS, not the bytes32 poolId): cast send $EMITTER 'shock(address,int24,uint24,uint24)' ...
//
// cast sig "shock(address,int24,uint24,uint24)"
const SELECTOR_SHOCK = 0x5342da2b;

// Flags are internal, not a caller argument: the emitter always encodes all three fields present
// (tick | norm | decay = 0b111) so the event carries all three data words. A live shock is a full
// shock; field-absence is a hookData-codec concern (Shock.plk), not the emitter's.
const FLAGS_ALL = 0x07;

init { return_runtime(); }

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    if selector == SELECTOR_SHOCK {
        // ABI heads: address / int24 / uint24 / uint24, each one 32-byte slot, sign-/zero-extended
        // by the encoder. pool is the full word (address zero-padded high) -> topic1 as-is.
        let pool      = @evm_calldataload(4);
        let tick_diff = @evm_calldataload(36);
        let norm_rate = @evm_calldataload(68);
        let decay     = @evm_calldataload(100);

        let buf = shock_encode(tick_diff, norm_rate, decay, FLAGS_ALL);
        let s   = shock_decode(memory, buf);
        shock_emit(memory, pool, s);
        @evm_stop();
    }
    revert_empty();
}
