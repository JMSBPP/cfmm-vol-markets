
// mint(address,address,int24,int24,uint128,bytes)
const SELECTOR_ADD_LIQUIDITY = 0xaafe29c0;

//algebraMintCallback(uint256,uint256,bytes)
const SELECTOR_ADD_LIQUIDITY_CALLBACK = 0x3dd657c5;

//algebraSwapCallback(int256,int256,bytes)
const SELECTOR_SWAP_CALLBACK = 0x2c8958f6;

// setPluginConfig(uint8)
const SELECTOR_SET_PLUGIN_CONFIG = 0xbca57f81;

// Algebra plugin hook flags (Plugins.sol). The writer sets BEFORE_SWAP | DYNAMIC_FEE so the pool
// calls beforeSwap with the swap hookData AND honors beforeSwap's feeOverride (that's how fee-0 is
// enforced). BEFORE_SWAP_FLAG=1, DYNAMIC_FEE=1<<7=0x80 -> config = 0x81.
const BEFORE_SWAP_FLAG = 0x01;
const DYNAMIC_FEE_FLAG = 0x80;
const MEV_TAX_PLUGIN_CONFIG = 0x81;