/// Tick demo: setTick/readTick against EIP-1153 transient storage; emits SetTick.
use std::prelude::*;
use std::slice::{new,len};
use std::core::uint::{try_cast_uint,u24};
use custom_utils::moreRegions::{storage,transient_storage};
use TickMoments::Window::*;
use TickMoments::TickAverage::*;
use TickMoments::Tick::*;	   
use TickMoments::TickSpacing::*;
use TickMoments::TickRealizedVolatility::*;



use Asset::Asset::{AssetCalldata, storeAsset, AssetMemory, loadAssetMemory};


use LiquidityKernel::AlignTick::*;

// TODO: This is to be put on it's own module

// cast keccak VolMarkets.Controller
const CONTROLLER_SLOT = 0x504cec47c00ecd92195dd23334a7de6ebb4a41496b4d3e248edc0727a2ce20b0;

// cast keccak VolMarkets.Fee
const FEE_SLOT = 0xdbb1cc11be04a69fc56e7bbccbd8e9075d3eeb52d1db97a6e9e2f0726a30b6ba;

const SET_TICK_TOPIC = 0x2833a7bdc4e30391adeb052e4232401f54ff1a34cd8db2c61c32b3199b3907c2;

init {
    return_runtime();
}

run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    if selector == READ_TICK_SELECTOR {
       tickReturnEVM();
    }

    else if selector == READ_TICK_AVERAGE_SELECTOR {
      tickAverageReturnEVM();
    }
    // cast sig "setPair(address,address,bool)"
    else if selector == 0xa782d794 {
    	 let asstIdx: u256 = @evm_calldataload(68);
	 // TODO: The above can upadte tokenId
    	 let assetCalldata: AssetCalldata = (@evm_calldataload(4),@evm_calldataload(36), if asstIdx == 0 {false} else {true});
	 storeAsset(assetCalldata,storage);
	 let retBuff: u256 = @malloc_zeroed(32);
	 @evm_return(retBuff,32);
    }
    else if selector == READ_TICK_REALIZED_VOLATILITY_SELECTOR {
      tickRealizedVolatilityReturnEVM();      
    }

    else if selector == READ_TICK_SPACING_SELECTOR {
        tickSpacingReturnEVM();  
    }

    else if selector == SET_WINDOW_SELECTOR {
       let windowCalldata: WindowCalldata = (
           @evm_calldataload(4),
           state_to_word(WindowNotInitialized)
       );
       let window: Window(WindowNotInitialized) = build_window(windowCalldata);
       store_window(window,WindowNotInitialized,storage);
       @evm_return(@malloc_uninit(0), 0);
    }


    else if selector == SET_TICK_SELECTOR {
	tickSpacingRevertEVMDueTo(storage);	     
	let tickCalldata: TickCalldata = (@evm_calldataload(4),tickSpacingWord(tickSpacingOn(storage)));
	let tick :Tick = build_tick(tickCalldata);
	
	let updatedTickAvg : TickAverage(WindowInitialized) = update_average(storage,tick);
	let updatedTickRealizedVol: TickRealizedVol(WindowInitialized) = update_realized_volatility(storage, tick);
	
	let mut alignTickCalldata : AlignCalldata = partialAlignTickCalldata(tickOn(storage));
	store_tick(tick,storage);
	alignTickCalldata = completeAlignTickCalldata(alignTickCalldata, tick);

	requestTickAlignment(alignTickCalldata);
			
	store_tickAverage(updatedTickAvg,storage);
	store_tickRealizedVolatility(updatedTickRealizedVol,storage);

	
	@evm_return(@malloc_uninit(0), 0);
    }

    else if selector == SET_TICK_SPACING_SELECTOR {
      	 let tickSpacingCalldata: TickSpacingCalldata = (tickSpacingVal(@evm_calldataload(4)),);
	 let tickSpacing: TickSpacing = build_tickSpacing(tickSpacingCalldata);
	 store_tickSpacing(tickSpacing,storage);
	 @evm_return(@malloc_uninit(0), 0);
    }
    // cast sig "setController(address)"
    else if selector == 0x92eefe9b {
    	 @evm_sstore(CONTROLLER_SLOT, @evm_calldataload(4));
	 let retBuff: u256 = @malloc_zeroed(32);
	 @evm_return(retBuff,32);

    }
    // cast sig "setTickAligner(address)"

    else if selector == 0x1e5c861f {
    	 @evm_sstore(ALIGNER_SLOT, @evm_calldataload(4));    	 
    	 let retBuff: u256 = @malloc_zeroed(32);
	 @evm_return(retBuff,32);
    }
    
    // cast sig "set_fee(uint24)"
    else if selector == 0x84e99813 {
    	 @evm_sstore(FEE_SLOT,@evm_calldataload(4));
	 let retBuff: u256 = @malloc_zeroed(32);
	 @evm_return(retBuff,32);

    }
    // cast sig "getMarketKey()"
    else if selector == 0xe6b12e1e {
    	 let assetMemory: AssetMemory = loadAssetMemory(storage);
	 let payloadLen: u256 = len(assetMemory) * 32;
	 let ret: u256 = @malloc_uninit(64 + payloadLen);
	 @mstore32(ret, 0x20);
	 @mstore32(ret +% 32, payloadLen);
	 @mcopy(ret +% 64, assetMemory.ptr, payloadLen);
    	 @evm_return(ret, 64 + payloadLen);
    }
    else {
      @evm_revert(@malloc_uninit(0), 0);
    }
}    
