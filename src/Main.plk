
/// Tick demo: setTick/readTick against EIP-1153 transient storage; emits SetTick.
use std::prelude::*;
use std::slice::new;
use std::core::uint::{try_cast_uint,u24};
use custom_utils::moreRegions::{storage,transient_storage};
use TickMoments::Window::*;
use TickMoments::TickAverage::*;
use TickMoments::Tick::*;	   
use TickMoments::TickSpacing::*;


const READ_TICK_SELECTOR = 0x23f6079d;
const SET_TICK_TOPIC = 0x2833a7bdc4e30391adeb052e4232401f54ff1a34cd8db2c61c32b3199b3907c2;

init {
    return_runtime();
}


run {
    let selector = @evm_shr(224, @evm_calldataload(0));
    if selector == SET_WINDOW_SELECTOR {
       let windowCalldata: WindowCalldata = (
           @evm_calldataload(4),
           state_to_word(WindowNotInitialized)
       );
       let windowMemory: WindowFromCalldataToMemory = new(memory, windowCalldata);
       set_window(windowMemory,storage);
    } else if selector == SET_TICK_SELECTOR {
      	
	tickSpacingRevertEVMDueTo(storage);	     
	
        
	let tickCalldata: TickCalldata = (@evm_calldataload(4),tickSpacingOn(storage)); //
	
	
	let tickMemory: TickFromCalldataToMemory = new(memory,tickCalldata);	       //
	
	// todo: We need support for transient storage
	set_tick(tickMemory, storage);	  //
	
	/////////////////////////////////////////////////////////////////////////////
	// let updatedTickAvg : TickAverage = update_average(tickCalldata);	   //
	/////////////////////////////////////////////////////////////////////////////
	let ptr = @malloc_uninit(0);
	@evm_return(ptr, 0);
    } else if selector == SET_TICK_SPACING_SELECTOR {
      	 let tickSpacingCalldata: TickSpacingCalldata = (tickSpacingVal(@evm_calldataload(4)),);
	 let tickSpacingMemory: TickSpacingFromCalldataToMemory = new(memory, tickSpacingCalldata);
	 set_tick_spacing(tickSpacingMemory,storage);
    } else {
      @evm_revert(@malloc_uninit(0), 0);
    }
}    
    ////////////////////////////////////////////////////////////////////////////////////////////////////////
    // if selector == SET_TICK_SELECTOR {								  //
    //     let tick: Tick = fetch_tick(calldata);							  //
    // 	let avg: TickAverage = updated_average(transient_storage, tick, window_state(storage));		  //
    // 	store_tick(calldata,transient_storage);								  //
    // 	store_tick_average(memory,transient_storage,avg);						  //
    //     @evm_stop();											  //
    // }												  //
    // 													  //
    // if selector == READ_TICK_SELECTOR {								  //
    //     fetch_tick(transient_storage);								  //
    // }												  //
    // 													  //
    // if selector == READ_TICK_AVERAGE_SELECTOR {							  //
    //   	fetch_tick_average(transient_storage);   						  //
    //     @evm_revert(@malloc_uninit(0), 0);								  //
    // }												  //
    ////////////////////////////////////////////////////////////////////////////////////////////////////////
// }
