
/// Tick demo: setTick/readTick against EIP-1153 transient storage; emits SetTick.
use std::prelude::*;
use custom_utils::moreRegions::{storage,transient_storage};
use TickMoments::Window::*;
//////////////////////////////////////
// use TickMoments::TickAverage::*; //


use TickMoments::Tick::{TICK_SLOT};	   

const SET_TICK_SELECTOR = 0xfb972e51;
const READ_TICK_SELECTOR = 0x23f6079d;
const SET_WINDOW_SELECTOR = 0x63eade47;
const READ_TICK_AVERAGE_SELECTOR = 0x2b8bf580;

const SET_TICK_TOPIC = 0x2833a7bdc4e30391adeb052e4232401f54ff1a34cd8db2c61c32b3199b3907c2;



init {
    return_runtime();
}

const set_tick = fn (value: u256) void { @evm_tstore(TICK_SLOT, value); log_tick(value); };

const log_tick = fn(value: u256) void {
      let buf = @malloc_uninit(32);
      @mstore32(buf, value);
      @evm_log1(buf,32, SET_TICK_TOPIC);
};


const read_tick = fn () never {
    let value = @evm_tload(TICK_SLOT);
    let buf = @malloc_uninit(32);
    @mstore32(buf, value);
    @evm_return(buf, 32);
};



run {
    let selector = @evm_calldataload(0) >> 224;
    if selector == SET_WINDOW_SELECTOR {
       let window: Window = fetch_window(calldata);
       store_window(calldata,storage);
       @evm_stop();
    }
    @evm_stop();
}    
