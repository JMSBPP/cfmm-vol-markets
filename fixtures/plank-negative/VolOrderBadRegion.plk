// NEGATIVE fixture (Phase 2, VORD-01, assessment §4a): VolOrder(T) for a T that is not a region
// MUST NOT compile. There is no local `none` tag to guard it -- the rejection comes from std:
// Extra(T) holds `data: bytes(T)`, and std/regions.plk's `bytes` calls `region_ptr_type`, which
// ends in @compile_error("unrecognized region").
//
// Lives outside src/ and test/ so `make compile-plank` (which scans those two roots for entrypoints)
// never builds it; test/types/pos_spec/VolOrderType.t.sol builds it via vm.tryFfi and asserts a
// non-zero exit.
import std::constructor::return_runtime;
import pos_spec::VolOrder::*;

const bad = fn (vo: VolOrder(u256)) u256 { vo.rangeWidth.width };

init { return_runtime(); }
run { @evm_stop(); }
