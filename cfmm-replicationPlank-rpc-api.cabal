    -- Modules exported by the library.
    exposed-modules:  VolOrder.Types
                    , VolOrder.Encoding
                    , VolOrder.Decode
                    , VolOrder.Report
                    , VolOrder.Rpc
                    , PriceSetter.Encoding
                    , PriceSetter.Decode
                    , PriceSetter.Report
                    , PriceSetter.Rpc
                    , StochasticPriceGen.Types
                    , StochasticPriceGen.Simulate
                    , StochasticPriceGen.Report
                    , StochasticPriceGen.Rpc
                    , StochasticOrderGen.Types
                    , StochasticOrderGen.Simulate
                    , StochasticOrderGen.Report
                    , StochasticOrderGen.Rpc
                    , Rig.Manifest
                    , RealizedVol.Decode
                    , CheatSwap.Types
                    , CheatSwap.Encoding
                    , CheatSwap.Rpc
                    , Driver.Seed
                    , Driver.Capture
                    , Store.Types
                    , Store.Config
                    , Store.Class
                    , Store.Json
                    , Store.Memory
                    , Store.Laws
                    , Store.Schema
                    -- Phase 25's content key. +0 PACKAGES, and CONFIRMED rather than estimated at
                    -- 25-01: `cabal build --enable-tests -j all` printed no `Downloading` line and
                    -- the resolved plan was 166 units with this line and 166 without it, measured
                    -- by running --dry-run against both texts of this file and counting
                    -- plan.json's install-plan. (166 = 132 global + 28 pre-installed boot
                    -- packages + 6 components of this package. The "158" recorded at 23-01 counts
                    -- a tree with fewer executables and is NOT the same quantity; it was
                    -- re-measured here rather than inherited.) bytestring supplies the builder the
                    -- netstring framer emits, filepath supplies takeFileName/isAbsolute for the
                    -- relativisation, crypton arrives through Store.Types.sha256_hex, and every
                    -- one of the three was already a dependency of this stanza.
                    , Store.Key
                    -- Phase 25's solver seam. +0 PACKAGES and nothing to weigh: it declares one
                    -- record and re-exports the outcome sum from Gams.Run, so it imports only
                    -- modules of this same stanza. CONFIRMED rather than estimated at 25-02:
                    -- `cabal build --enable-tests -j all` printed no `Downloading` line with this
                    -- module on disk.
                    , Store.Solver
                    -- STORE-01's decision function. +0 PACKAGES for the same reason its seam is:
                    -- it imports Store.Class, Store.Key, Store.Types, Store.Solver, Gams.Argv,
                    -- Gams.Artifact and Gams.Version and nothing outside this stanza. CONFIRMED
                    -- at 25-02: `cabal build --enable-tests -j all` printed no `Downloading` line
                    -- with this module on disk.
                    , Store.Cache
                    , Store.Postgres
                    -- The GAMS layer resolves at +0 PACKAGES. `process` (subprocess spawn and
                    -- pipe draining), `directory` (the exclusive run directory), `bytestring`
                    -- (reading the log and the artifact without a locale decoder) and `crypton`
                    -- (sha256) are all already library dependencies of this stanza, so nothing
                    -- new enters the build plan. CONFIRMED, not estimated: at the commit that
                    -- added the first three modules, `cabal build --enable-tests -j all` printed
                    -- no `Downloading` line and the resolved plan was unchanged. RE-CONFIRMED the
                    -- same way at 24-02, with Argv, Env and Artifact added: `Downloading` = 0.
                    -- Gams.Artifact imports Store.Json and NOTHING that parses JSON, which is why
                    -- the artifact path costs no package either.
                    , Gams.Config
                    , Gams.Version
                    , Gams.Exit
                    , Gams.Argv
                    , Gams.Env
                    , Gams.Artifact
                    -- Gams.Run is the ONE module in the layer that spawns a process. It resolves
                    -- at +0 packages too, and that was CONFIRMED at 24-03 the same way: process,
                    -- directory, bytestring, filepath and crypton were all already here, and
                    -- Data.Unique / System.Timeout / System.IO.Error are base. `time` is NOT
                    -- added: getModificationTime's result is compared inside the function that
                    -- takes it and never named in a signature, so no module of that package is
                    -- imported.
                    , Gams.Run
                    -- Gams.Invoke is the module that NAMES the real prover: it resolves a live
                    -- binary and a live model out of Gams.Config and composes them with
                    -- Gams.Run.run_prover. It is exposed so ONE consumer can import it -- the
                    -- gams-conformance executable below -- and the test-suite stanza's own
                    -- structural check (the_suite_never_names_the_real_solver) forbids
                    -- offchain/test/Main.hs from naming it at all. +0 packages again: directory
                    -- supplies findExecutable/makeAbsolute, filepath supplies isPathSeparator, and
                    -- process, bytestring and crypton were already here. CONFIRMED at 24-05 the
                    -- same way as its four predecessors: `cabal build --enable-tests -j all`
                    -- printed no `Downloading` line.
                    , Gams.Invoke
                    -- Phase 26's fee splitter, arithmetic core. +0 PACKAGES, and CONFIRMED rather
                    -- than estimated at 26-01: with this module on disk,
                    -- `cabal build --enable-tests -j all` printed no `Downloading` line. It has
                    -- exactly ONE import -- Data.Word, for the seed field's Word32 -- and
                    -- Data.Word is base, which was in the build plan before this stanza had any
                    -- other line in it. Nothing here parses, spawns, hashes or does IO: every
                    -- function is Integer arithmetic over values it was handed.
                    , Fee.Split
                    -- Phase 26's Shock event decoder. +0 PACKAGES, and CONFIRMED rather than
                    -- estimated at 26-02: with this module on disk,
                    -- `cabal build --enable-tests -j all` printed no `Downloading` line. Its five
                    -- imports are bytestring (the payload length), memory-hexstring (toBytes),
                    -- web3-solidity (toHexString, for the emitting address the topic cannot
                    -- authenticate), web3-ethereum (the Change record) and two modules of this
                    -- same stanza. All four packages were already dependencies here -- three of
                    -- them are what RealizedVol.Decode is built from -- so nothing new enters the
                    -- build plan. Nothing here does IO, spawns, hashes or parses: it is a total
                    -- function from a log to an Either.
                    , Chain.Shock
                    -- Phase 27's endpoint resolver. +0 PACKAGES, and CONFIRMED rather than
                    -- estimated at 27-01: with this module on disk,
                    -- `cabal build --enable-tests -j all` printed no `Downloading` line. It has
                    -- exactly ONE import -- System.Environment, for lookupEnv -- and that is
                    -- base, which was in the build plan before this stanza had any other line in
                    -- it. It opens no socket and reaches no chain: it returns a String, and every
                    -- consumer already reports its own RPC failure.
                    , Chain.Endpoint

    -- Modules included in this library but not exported.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base ^>=4.20.2.0,
                      web3-ethereum,
                      web3-solidity,
                      web3-provider,
                      memory-hexstring,
                      process,
                      bytestring,
                      jsonrpc-tinyclient,
                      aeson,
                      mwc-random,
                      web3-crypto,
                      containers,
                      text,
                      -- Driver.Capture's atomic artifact write (renameFile/removeFile). A GHC boot
                      -- package that the test-suite stanza already depends on, so it was in the
                      -- build plan before this line existed and no new package is resolved.
                      directory,
                      -- Gams.Run's `</>`, `takeFileName` and `isAbsolute`. The run directory is
                      -- built from a temp root and the job name is the model's basename, and
                      -- hand-rolling either is the "don't hand-roll" row this phase's research
                      -- writes down. NOT a new package: filepath-1.5.4.0 is a GHC boot package
                      -- that the test-suite stanza already depends on and that directory pulls in
                      -- regardless, so it was in the build plan before this line existed -- it was
                      -- merely HIDDEN from the library stanza, which is how the build failed at
                      -- 24-03 with "It is a member of the hidden package". MEASURED at that
                      -- commit: `cabal build --enable-tests -j all` printed no `Downloading`.
                      filepath,
                      -- Driver.Seed's `initialize (V.singleton w)`. NOT a new package: mwc-random
                      -- already depends on it, so 0.13.2.0 was in the build plan before this line
                      -- existed. MEASURED at this commit: `cabal build --enable-tests -j all`
                      -- printed no `Downloading`, and the resolved id is still 0.13.2.0.
                      vector,
                      -- Store.Postgres' client, resolved at 0.7.0.1. NEW: +4 packages --
                      -- MEASURED by plan.json set-diff at 23-01, not estimated: the install plan
                      -- goes 152 -> 158 units and the four it gains here are Only-0.1,
                      -- postgresql-libpq-0.11.0.0, postgresql-libpq-configure-0.11 and
                      -- postgresql-simple itself. Chosen over hasql (+18) and persistent (+43)
                      -- on footprint; see .planning/research/STACK.md.
                      postgresql-simple,
                      -- The migration runner, resolved at 0.2.1.8. NEW: +2 over the client
                      -- (itself and cryptohash-md5-0.11.101.0) -- same set-diff, same commit.
                      -- MEASURED wart, and the reason Store.Postgres will wrap it: it returns
                      -- MigrationError "Checksum mismatch" and the PROCESS STILL EXITS 0. It also
                      -- has no advisory lock at 0.2.1.8 (source-read), so mutual exclusion is the
                      -- caller's pg_advisory_lock, not the library's.
                      postgresql-migration,
                      -- SHA256 over the artifact and the adversarial corpus, resolved at 1.0.6.
                      -- NOT a new package, and this was CONFIRMED rather than assumed: crypton-1.0.6
                      -- appears in the 152-unit plan.json set taken BEFORE this line existed as well
                      -- as the 158-unit set after, because web3-crypto already pins crypton <1.1.
                      -- The +6 above is therefore entirely the two postgresql stanzas. cryptonite is
                      -- deprecated (last upload 2022-03-13) and must not be used.
                      crypton

    -- Directories containing source files.
    hs-source-dirs:   offchain/lib/

    -- Base language which the package is written in.
    default-language: Haskell2010

executable cfmm-replicationPlank-rpc-api
