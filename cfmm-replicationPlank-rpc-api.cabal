    -- enters the build plan.
    build-depends:
        base ^>=4.20.2.0,
        cfmm-replicationPlank-rpc-api,
        web3-solidity,
        web3-provider,
        mwc-random,
        bytestring,
        memory-hexstring,
        text,
        web3-ethereum,
        process
    hs-source-dirs:   offchain/app
    default-language: Haskell2010

