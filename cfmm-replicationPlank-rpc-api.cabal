cabal-version:      3.12
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'cfmm-replicationPlank-rpc-api' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               cfmm-replicationPlank-rpc-api

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             JMSBPP

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         juan.serranotmf@gmail.com

-- A copyright notice.
-- copyright:
category:           Data
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    -- Import common warning flags.
    import:           warnings

    -- Modules exported by the library.
    exposed-modules:  VolOrder.Types
                    , VolOrder.Encoding
                    , VolOrder.Decode
                    , VolOrder.Report
                    , VolOrder.Rpc
                    , PriceSetter.Encoding
                    , PriceSetter.Decode
                    , PriceSetter.Report
                    , PriceSetter.Rpc
                    , StochasticPriceGen.Types
                    , StochasticPriceGen.Simulate
                    , StochasticPriceGen.Report
                    , StochasticPriceGen.Rpc
                    , StochasticOrderGen.Types
                    , StochasticOrderGen.Simulate
                    , StochasticOrderGen.Report
                    , StochasticOrderGen.Rpc
                    , Rig.Manifest
                    , RealizedVol.Decode
                    , CheatSwap.Types
                    , CheatSwap.Encoding
                    , CheatSwap.Rpc
                    , Driver.Seed
                    , Driver.Capture

    -- Modules included in this library but not exported.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base ^>=4.20.2.0,
                      web3-ethereum,
                      web3-solidity,
                      web3-provider,
                      memory-hexstring,
                      process,
                      bytestring,
                      jsonrpc-tinyclient,
                      aeson,
                      mwc-random,
                      web3-crypto,
                      containers,
                      text,
                      -- Driver.Seed's `initialize (V.singleton w)`. NOT a new package: mwc-random
                      -- already depends on it, so 0.13.2.0 was in the build plan before this line
                      -- existed. MEASURED at this commit: `cabal build --enable-tests -j all`
                      -- printed no `Downloading`, and the resolved id is still 0.13.2.0.
                      vector

    -- Directories containing source files.
    hs-source-dirs:   offchain/lib/

    -- Base language which the package is written in.
    default-language: Haskell2010

executable cfmm-replicationPlank-rpc-api
    import:           warnings
    main-is:          Main.hs
    other-modules:    Sample
    -- The last five arrived with 22-05's capture wiring: bytestring + memory-hexstring to render
    -- the recorded tx hashes and slot0 words as hex, text for the manifest's Text fields,
    -- web3-ethereum for the receipt Quantity, and process for the `date` call that stamps the
    -- artifact (the same move capture-batch-return.sh and CheatSwapProof.hs both make, chosen over
    -- a new `time` dependency). All five are already library dependencies, so no new package
    -- enters the build plan.
    build-depends:
        base ^>=4.20.2.0,
        cfmm-replicationPlank-rpc-api,
        web3-solidity,
        web3-provider,
        mwc-random,
        bytestring,
        memory-hexstring,
        text,
        web3-ethereum,
        process
    hs-source-dirs:   offchain/app
    default-language: Haskell2010

-- The cheat-swap capture tool. A SEPARATE executable rather than a flag inside the demo driver's
-- Main.hs, for two reasons: plan 22-05 rewires that Main.hs substantially and an env-flag branch
-- there would collide, and this belongs to the same family as offchain/rig/capture-batch-return.sh
-- -- a thing you run once against a live rig to produce a committed artifact -- not to the driver.
executable cheat-swap-proof
    import:           warnings
    main-is:          CheatSwapProof.hs
    build-depends:
        base ^>=4.20.2.0,
        cfmm-replicationPlank-rpc-api,
        aeson,
        bytestring,
        text,
        process,
        memory-hexstring,
        web3-ethereum,
        web3-provider
    hs-source-dirs:   offchain/app
    default-language: Haskell2010

test-suite cfmm-replicationPlank-rpc-api-test
    -- Import common warning flags.
    import:           warnings

    -- Base language which the package is written in.
    default-language: Haskell2010

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   offchain/test

    -- The entrypoint to the test suite.
    main-is:          Main.hs

    -- Test dependencies.
    --
    -- The last four exist so the suite can exercise the LIBRARY's own wire types rather than a
    -- transcription of them: memory-hexstring for the HexString the encoder returns,
    -- web3-ethereum for Quantity and Change (the Phase 21 event re-pin builds synthetic logs),
    -- web3-solidity for the Address that Change's non-optional changeAddress field demands, and
    -- mwc-random for the fixed-seed GenIO the drawn-order checks need. All four are already
    -- project dependencies of the library, so no new package enters the build plan.
    build-depends:
        base ^>=4.20.2.0,
        cfmm-replicationPlank-rpc-api,
        web3-crypto,
        aeson,
        bytestring,
        text,
        containers,
        process,
        directory,
        filepath,
        memory-hexstring,
        web3-ethereum,
        web3-solidity,
        mwc-random
