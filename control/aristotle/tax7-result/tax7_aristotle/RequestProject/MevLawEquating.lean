import Mathlib
import RequestProject.MevGateDerivative
import RequestProject.MevTransactionalOptimum

set_option maxHeartbeats 1000000
set_option relaxedAutoImplicit false
set_option autoImplicit false

/-!
# M41 — equating the corrected law and the top-up law (Theorem 53)

Two `τ*` objects sit in the corpus:

* **`SRC` Proposition 13** — the *corrected law*, an implicit stationarity
  condition of the pre-extension model,
  `τ*_law = 1 + (1-φ_X)/((∂φ_X/∂ν)(∂ν/∂τ_MEV))`, formalized as
  `MevTaxProgram.Proposition16_corrected_law`.  **Its slot is the BARE gate
  derivative** (`MevTaxProgram.hasDerivAt_phiTot`, ban 4): the monoid Jacobian
  `(1-φ_M)(1-τ_MEV)` is carried separately by `MevTaxProgram.pathGate`.
* **`SRC` Theorem 39** — the *top-up law*, the explicit solution of the extended
  transactional model, `τ*_topup = (φ* - φ_M⊗_φφ_X)/(1 - φ_M⊗_φφ_X)`,
  formalized as `MevTaxTransactional.Theorem50c_top_up_law`.

This module answers M41.  The headline verdicts:

* **(a)** the author's algebraic reduction is **confirmed**, in both the
  `(1-τ*)` and the `(1-φ*)` form, and it **is** `MevLVRCancellation`'s bracket
  zero restated — but only in the **composed** slot
  (`MevTaxLVR.bracketLiteral_composed_eq_bracketTrue`); read with the bare slot
  the literal bracket is *not* the FOC core
  (`Theorem53a_bare_slot_is_not_the_bracket`).
* **(b)** the answer depends, and only depends, on the `ν`-reading of (d):
  - if `∂ν/∂τ_MEV` is an unconstrained datum (the typed reading of
    `MevTaxProgram.totalDeriv`), the equality is **(ii) a codimension-one
    constraint**: exactly one slope value per parameter point
    (`Theorem53b_locus_is_codimension_one`), with a point on it
    (`Theorem53b_point_on_the_locus`) and a point off it
    (`Theorem53b_point_off_the_locus`) at a genuine interior optimum of the
    extended model (`Theorem53b_witness_is_an_interior_optimum`);
  - if `ν` is generated by the composed fee — Rule 13's gate argument driven by
    `SRC` Theorem 36's shock response, which is the corpus's own model — the
    equality is **(iii) impossible**: the FOC core is *strictly positive* at
    every tax (`Theorem53b_generically_false`), so the corrected law has no root
    to equate.  This is `SRC` Theorem 37's feedback identity, and it is the same
    identity that preserves the guard sign in
    `MevTaxGate.Theorem54c_sign_survives_the_loop`.
* **(c)** the calibration pinning holds *conditionally* on (a), with the gate
  derivative of `MevTaxGate.Theorem54a_gate_derivative_closed_form` in the
  denominator; under the loop reading its hypothesis is unsatisfiable and the
  pinning is **vacuous** (`Theorem53c_pinning_is_vacuous_under_the_loop`).
* **(d)** the flag is **load-bearing, and a further author ruling is required**:
  `Theorem53d_readings_disagree` exhibits a root under a block-type-weighted
  `ν` with an exogenous transactional leg at parameters where the arb-only
  reading has none.  This module does **not** rule.
-/

namespace MevTaxEquating

open MevTaxProgram MevTaxTransactional

/-! ## Theorem 53(a) — the algebraic reduction -/

/-- **Theorem 53(a) [M41] — the reduction, verified.**  At any tax `τ ≠ 1` and
nonzero slope product `S = (∂φ_X/∂ν)(∂ν/∂τ_MEV)`:

`τ = τ*_law  ⟺  S = -(1-φ_X)/(1-τ)`,

and on the monoid carrier `1-φ* = (1-φ_M)(1-φ_X)(1-τ)` the right-hand side is
`-(1-φ_M)(1-φ_X)(1-φ_X)/(1-φ*)`.  The author's hand-derivation is **confirmed**. -/
theorem Theorem53a_algebraic_reduction (phiM phiXv tau S phistar : ℝ)
    (htau : tau ≠ 1) (hS : S ≠ 0)
    (hmonoid : 1 - phistar = (1 - phiM) * (1 - phiXv) * (1 - tau))
    (hphistar : phistar ≠ 1) :
    (tau = 1 + (1 - phiXv) / S ↔ S = -(1 - phiXv) / (1 - tau))
      ∧ -(1 - phiXv) / (1 - tau)
        = -((1 - phiM) * (1 - phiXv) * (1 - phiXv)) / (1 - phistar) := by
  have ht : (1 : ℝ) - tau ≠ 0 := sub_ne_zero.mpr (Ne.symm htau)
  have hp : (1 : ℝ) - phistar ≠ 0 := sub_ne_zero.mpr (Ne.symm hphistar)
  have hM : (1 : ℝ) - phiM ≠ 0 := by
    intro h0
    apply hp
    rw [hmonoid, h0]; ring
  have hXne : (1 : ℝ) - phiXv ≠ 0 := by
    intro h0
    apply hp
    rw [hmonoid, h0]; ring
  constructor
  · constructor
    · intro h
      field_simp at h ⊢
      nlinarith [h]
    · intro h
      have hkey : (1 - phiXv) / (-(1 - phiXv) / (1 - tau)) = -(1 - tau) := by
        field_simp
      rw [h, hkey]; ring
  · rw [hmonoid]
    field_simp

/-- **Theorem 53(a) [M41] — equating the two laws.**  Write `φ_base = φ_M⊗_φφ_X`
and `τ*_topup = (φ* - φ_base)/(1 - φ_base)` (`Theorem50c_top_up_law`).  With
`φ_base < 1` and `φ* ≠ 1`, the corrected law is satisfied **at** the top-up tax
iff the slope product takes the single value

`S = -(1-φ_X)/(1-τ*_topup) = -(1-φ_M)(1-φ_X)(1-φ_X)/(1-φ*)`. -/
theorem Theorem53a_equating_the_two_laws (phiM phiXv phistar S : ℝ)
    (hM : phiM < 1) (hX : phiXv < 1) (hstar : phistar ≠ 1) (hS : S ≠ 0) :
    ((phistar - (1 - (1 - phiM) * (1 - phiXv))) / (1 - (1 - (1 - phiM) * (1 - phiXv)))
          = 1 + (1 - phiXv) / S
        ↔ S = -((1 - phiM) * (1 - phiXv) * (1 - phiXv)) / (1 - phistar)) := by
  set phibase : ℝ := 1 - (1 - phiM) * (1 - phiXv) with hbase
  have hMp : (0:ℝ) < 1 - phiM := by linarith
  have hXp : (0:ℝ) < 1 - phiXv := by linarith
  have hb1 : (0:ℝ) < 1 - phibase := by rw [hbase]; simpa using mul_pos hMp hXp
  have hp : (1 : ℝ) - phistar ≠ 0 := sub_ne_zero.mpr (Ne.symm hstar)
  have htau : 1 - (phistar - phibase) / (1 - phibase) = (1 - phistar) / (1 - phibase) := by
    field_simp
    ring
  have hne : (phistar - phibase) / (1 - phibase) ≠ 1 := by
    rw [ne_eq, ← sub_eq_zero, ← neg_eq_zero]
    have : -((phistar - phibase) / (1 - phibase) - 1) = (1 - phistar) / (1 - phibase) := by
      rw [← htau]; ring
    rw [this]
    exact div_ne_zero hp (ne_of_gt hb1)
  have hmon : 1 - phistar
      = (1 - phiM) * (1 - phiXv) * (1 - (phistar - phibase) / (1 - phibase)) := by
    rw [htau, hbase]
    field_simp
    ring
  have h := (Theorem53a_algebraic_reduction phiM phiXv ((phistar - phibase) / (1 - phibase))
      S phistar hne hS hmon hstar)
  rw [h.1, h.2]

/-- **Theorem 53(a) [M41] — the reduction IS bracket zero, in the COMPOSED
slot.**  `MevLVRCancellation`'s bracket
`(1-φ_M)(1-φ_X) + (∂φ/∂ν)(∂ν/∂τ_MEV)` with `∂φ/∂ν` read as `SRC` Convention 9's
composed derivative `(1-φ_M)(1-τ_MEV)(∂φ_X/∂ν)` equals `(1-φ_M)` times the FOC
core, so for `φ_M ≠ 1` bracket zero, FOC core zero, and the corrected law are
the same statement.  Nothing of `MevTaxLVR` is re-derived: this composes
`MevTaxLVR.bracketLiteral_composed_eq_bracketTrue`,
`MevTaxLVR.bracketTrue_eq_focCore` and
`MevTaxProgram.Proposition16_corrected_law`. -/
theorem Theorem53a_is_bracket_zero_restated (phiM phiXv tau dphiXdnu dnudtau : ℝ)
    (hM : phiM ≠ 1) (hg : dphiXdnu * dnudtau ≠ 0) :
    (MevTaxLVR.bracketLiteral phiM phiXv ((1 - phiM) * (1 - tau) * dphiXdnu) dnudtau = 0
        ↔ focCore tau phiXv dphiXdnu dnudtau = 0)
      ∧ (focCore tau phiXv dphiXdnu dnudtau = 0
        ↔ tau = 1 + (1 - phiXv) / (dphiXdnu * dnudtau)) := by
  constructor
  · rw [MevTaxLVR.bracketLiteral_composed_eq_bracketTrue,
      MevTaxLVR.bracketTrue_eq_focCore]
    exact mul_left_eq_zero_iff' _ _ (sub_ne_zero.mpr (Ne.symm hM))
  · simpa only [focCore] using focCore_eq_zero_iff tau phiXv (dphiXdnu * dnudtau) hg

/-- **Ban 4, made quantitative.**  Read with the **bare** slot, the literal
bracket is *not* the FOC core: the two differ by
`(1 - (1-φ_M)(1-τ_MEV))·(∂φ_X/∂ν)(∂ν/∂τ_MEV)` on the gate term, and they agree
for every state exactly when the monoid Jacobian is `1`, i.e. at the degenerate
point `φ_M = 0`, `τ_MEV = 0`.  Every equation in this module therefore states
which slot it uses. -/
theorem Theorem53a_bare_slot_is_not_the_bracket (phiM phiXv tau dphiXdnu dnudtau : ℝ) :
    MevTaxLVR.bracketLiteral phiM phiXv dphiXdnu dnudtau
        - (1 - phiM) * focCore tau phiXv dphiXdnu dnudtau
        = (1 - (1 - phiM) * (1 - tau)) * (dphiXdnu * dnudtau)
      ∧ ((∀ g : ℝ, MevTaxLVR.bracketLiteral phiM phiXv g g
            = (1 - phiM) * focCore tau phiXv g g)
          ↔ (1 - phiM) * (1 - tau) = 1) := by
  constructor
  · unfold MevTaxLVR.bracketLiteral focCore; ring
  · constructor
    · intro h
      have h1 := h 1
      unfold MevTaxLVR.bracketLiteral focCore at h1
      nlinarith [h1]
    · intro h g
      unfold MevTaxLVR.bracketLiteral focCore
      nlinarith [h]

/-! ## Theorem 53(b) — the status of the equality in the extended model

### The witness: a genuine interior optimum of the extended model

`Δt = 2` (so `c = √(2/Δt) = 1`), `σ = 1/3` (so `Lvr = σ²Δt/8 = 1/36`),
`α_transactional = 1`, `f_LP·δ_transactional = e^{1/2}/9` — all of them free
typed parameters, instantiated by a **witness**, never estimated ((A-input)).
At these values `φ* = 1/2` is an interior stationary point of the extended
objective with `q(φ*) > 0`, hence a strict local maximiser by
`MevTaxTransactional.Theorem52_strict_local_max`. -/

/-- `K_w = f_LP·δ_transactional = e^{1/2}/9` — the witness's LP-accrued fee
constant under (A-route). -/
noncomputable def Kw : ℝ := Real.exp (1/2) / 9

/-- **The witness is an interior optimum of the extended model.**  `φ* = 1/2` is
a stationary point of the extended (transactional-channel) objective with
`q(φ*) = 5/4 > 0`, so by `Theorem52_second_order` / `Theorem52_strict_local_max`
it is a strict local maximiser — and by `Theorem50b_carrier_analogue_noroute_tail`
it satisfies the carrier bound `αφ* > ℙ_{Δ_ARB}(φ*)`. -/
theorem Theorem53b_witness_is_an_interior_optimum :
    focTail Kw 1 (1/2) (1/3) 1 (1/36) = 0
      ∧ 0 < qPoly 1 (1/3) 1 (1/2)
      ∧ cRate 2 = 1 ∧ lvrCoef (1/3) 2 = 1/36 := by
  refine ⟨?_, ?_, cRate_two, lvrCoef_witness⟩
  · rw [focTail_eq, hazTail, Kw]
    have h : -(1 * (1/2 : ℝ)) = -(1/2) := by norm_num
    rw [h, Real.exp_neg]
    have hne : Real.exp (1/2 : ℝ) ≠ 0 := Real.exp_ne_zero _
    field_simp
    ring
  · rw [qPoly]; norm_num

/-- **Theorem 53(b)(ii) — the locus is codimension one.**  With the bare gate
derivative `∂φ_X/∂ν ≠ 0` fixed and the tax at the top-up value `τ ≠ 1`, the
equality of the two laws holds for **exactly one** behavioral slope
`∂ν/∂τ_MEV`, namely `-(1-φ_X)/((1-τ)·∂φ_X/∂ν)`; and the defining function
`∂ν/∂τ_MEV ↦ focCore` is affine with **nonzero** derivative `(1-τ)∂φ_X/∂ν` in
that coordinate.  The locus is therefore a regular level set — a
codimension-one condition on the parameter tuple, not an identity. -/
theorem Theorem53b_locus_is_codimension_one (phiXv tau dphiXdnu : ℝ)
    (htau : tau ≠ 1) (hd : dphiXdnu ≠ 0) :
    (∃! dnudtau : ℝ, focCore tau phiXv dphiXdnu dnudtau = 0)
      ∧ focCore tau phiXv dphiXdnu (-(1 - phiXv) / ((1 - tau) * dphiXdnu)) = 0
      ∧ (∀ x : ℝ, HasDerivAt (fun d => focCore tau phiXv dphiXdnu d)
            ((1 - tau) * dphiXdnu) x)
      ∧ (1 - tau) * dphiXdnu ≠ 0 := by
  have ht : (1 : ℝ) - tau ≠ 0 := sub_ne_zero.mpr (Ne.symm htau)
  have hne : (1 - tau) * dphiXdnu ≠ 0 := mul_ne_zero ht hd
  have hroot : focCore tau phiXv dphiXdnu (-(1 - phiXv) / ((1 - tau) * dphiXdnu)) = 0 := by
    unfold focCore
    field_simp
    ring
  refine ⟨⟨-(1 - phiXv) / ((1 - tau) * dphiXdnu), hroot, ?_⟩, hroot, ?_, hne⟩
  · intro y hy
    unfold focCore at hy
    rw [eq_div_iff hne]
    linear_combination hy
  · intro x
    have h1 : HasDerivAt (fun d : ℝ => (1 - tau) * (dphiXdnu * d)) ((1 - tau) * dphiXdnu) x := by
      have : HasDerivAt (fun d : ℝ => dphiXdnu * d) dphiXdnu x := by
        simpa using (hasDerivAt_id x).const_mul dphiXdnu
      simpa [mul_assoc] using this.const_mul (1 - tau)
    simpa [focCore] using h1.const_add (1 - phiXv)

/-- **Theorem 53(b)(ii) — a point ON the locus.**  At the witness optimum
(`φ* = 1/2`), with legs `φ_M = 0`, `φ_X = 1/4` (so `φ_base = 1/4` and
`τ*_topup = 1/3`), the slope data `∂φ_X/∂ν = 9/8 > 0`, `∂ν/∂τ_MEV = -1 < 0`
— both signs as `SRC` Proposition 13's guard demands, the first one now a
theorem (`MevTaxGate.Theorem54b_first_guard_conjunct`) — puts the corrected law
exactly at the top-up tax. -/
theorem Theorem53b_point_on_the_locus :
    (1/2 - (1 - (1 - (0:ℝ)) * (1 - 1/4))) / (1 - (1 - (1 - (0:ℝ)) * (1 - 1/4))) = 1/3
      ∧ (0:ℝ) < 9/8 ∧ (-1:ℝ) < 0
      ∧ (1:ℝ)/3 = 1 + (1 - 1/4) / ((9/8) * (-1))
      ∧ focCore (1/3 : ℝ) (1/4) (9/8) (-1) = 0 := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num, ?_⟩
  rw [focCore]; norm_num

/-- **Theorem 53(b)(ii) — a point OFF the locus.**  The same witness optimum and
the same legs, with the equally admissible slope data `∂φ_X/∂ν = 1 > 0`,
`∂ν/∂τ_MEV = -1 < 0`: the corrected law returns `τ*_law = 1/4`, the top-up law
returns `τ*_topup = 1/3`, and the FOC core is nonzero at the top-up tax.  So the
equality is **not an identity** of the extended model — reading (i) is refuted. -/
theorem Theorem53b_point_off_the_locus :
    (0:ℝ) < 1 ∧ (-1:ℝ) < 0
      ∧ (1:ℝ)/4 = 1 + (1 - 1/4) / ((1:ℝ) * (-1))
      ∧ (1/2 - (1 - (1 - (0:ℝ)) * (1 - 1/4))) / (1 - (1 - (1 - (0:ℝ)) * (1 - 1/4))) = 1/3
      ∧ ((1:ℝ)/4 ≠ 1/3)
      ∧ focCore (1/3 : ℝ) (1/4) 1 (-1) ≠ 0 := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num, ?_⟩
  rw [focCore]; norm_num

/-! ### The loop reading: verdict (iii) -/

/-- **Theorem 53(b)(iii) — under the corpus's own `ν`, the two laws NEVER meet.**
If the utilization is generated by the composed fee — Rule 13's gate argument
`ν(t)` driven through `SRC` Theorem 36's shock response, so that
`∂ν/∂τ_MEV = (∂ν/∂φ)·dφ/dτ_MEV` with the *same* total `dφ/dτ_MEV` that the gate
feeds back into — then with the two guard signs (`∂φ_X/∂ν > 0`,
`∂ν/∂φ < 0`, both theorems now: `MevTaxGate.Theorem54b_first_guard_conjunct`,
`MevTaxGate.Theorem54c_dnu_dphi_neg`) the FOC core is **strictly positive**:

`focCore = (1-φ_X)/ℱ_{φ→ν→φ}`,   `ℱ_{φ→ν→φ} > 1`.

Hence the corrected law has **no root at any tax**, in particular not at the
top-up tax: the equating of M41 is impossible under this reading.  This is
`SRC` Theorem 37's identity, and it is exactly why
`MevTaxShock.Theorem47_shared_driver_leaves_no_root` holds. -/
theorem Theorem53b_generically_false
    (phiM phiXv tau dnudphi dphiXdnu dnudtau dphidtau : ℝ)
    (hM : phiM < 1) (hX : phiXv < 1) (htau : tau < 1)
    (hnu : dnudphi < 0) (hgate : 0 < dphiXdnu)
    (hloop : dnudtau = dnudphi * dphidtau)
    (hself : dphidtau = (1 - phiM) * ((1 - phiXv) + (1 - tau) * (dphiXdnu * dnudtau))) :
    0 < focCore tau phiXv dphiXdnu dnudtau
      ∧ focCore tau phiXv dphiXdnu dnudtau
        = (1 - phiXv) / MevTaxGate.feedback phiM tau dnudphi dphiXdnu
      ∧ tau ≠ 1 + (1 - phiXv) / (dphiXdnu * dnudtau) := by
  subst hloop
  have hMp : (0:ℝ) < 1 - phiM := by linarith
  have hMne : (1:ℝ) - phiM ≠ 0 := ne_of_gt hMp
  obtain ⟨hF, hval, hpos, -⟩ :=
    MevTaxGate.Theorem54c_sign_survives_the_loop phiM phiXv tau dnudphi dphiXdnu dphidtau
      hM hX htau hnu hgate hself
  have hFne : MevTaxGate.feedback phiM tau dnudphi dphiXdnu ≠ 0 := by linarith
  have hcore : dphidtau
      = (1 - phiM) * focCore tau phiXv dphiXdnu (dnudphi * dphidtau) := by
    rw [focCore]; linear_combination hself
  have hcpos : 0 < focCore tau phiXv dphiXdnu (dnudphi * dphidtau) := by
    nlinarith [hpos, hcore]
  refine ⟨hcpos, ?_, ?_⟩
  · have h1 : (1 - phiM) * (focCore tau phiXv dphiXdnu (dnudphi * dphidtau) *
        MevTaxGate.feedback phiM tau dnudphi dphiXdnu)
        = (1 - phiM) * (1 - phiXv) := by
      have h2 : dphidtau * MevTaxGate.feedback phiM tau dnudphi dphiXdnu
          = (1 - phiM) * (1 - phiXv) := by
        rw [hval, div_mul_cancel₀ _ hFne]
      linear_combination h2 - MevTaxGate.feedback phiM tau dnudphi dphiXdnu * hcore
    have h3 := mul_left_cancel₀ hMne h1
    rw [eq_div_iff hFne]
    exact h3
  · intro hcon
    have hgne : dphiXdnu * (dnudphi * dphidtau) ≠ 0 :=
      ne_of_lt (mul_neg_of_pos_of_neg hgate (mul_neg_of_neg_of_pos hnu hpos))
    have hz := (focCore_eq_zero_iff tau phiXv (dphiXdnu * (dnudphi * dphidtau)) hgne).mpr hcon
    rw [focCore] at hcpos
    linarith

/-- **Theorem 53(b)(iii), the consequence for the equating.**  Under the loop
reading the *total* derivative of the pre-extension objective never vanishes, so
there is no `τ*_law` at all — a fortiori none equal to `τ*_topup`. -/
theorem Theorem53b_no_tau_star_law_under_the_loop
    (A phiM phiXv tau dnudphi dphiXdnu dnudtau dphidtau : ℝ)
    (hA : A ≠ 0) (hM : phiM < 1) (hX : phiXv < 1) (htau : tau < 1)
    (hnu : dnudphi < 0) (hgate : 0 < dphiXdnu)
    (hloop : dnudtau = dnudphi * dphidtau)
    (hself : dphidtau = (1 - phiM) * ((1 - phiXv) + (1 - tau) * (dphiXdnu * dnudtau))) :
    totalDeriv A phiM tau phiXv dphiXdnu dnudtau ≠ 0 := by
  have h := (Theorem53b_generically_false phiM phiXv tau dnudphi dphiXdnu dnudtau dphidtau
    hM hX htau hnu hgate hloop hself).1
  rw [ne_eq, totalDeriv_eq_zero_iff A phiM tau phiXv dphiXdnu dnudtau hA
    (by linarith : phiM ≠ 1)]
  intro h0
  linarith [h, h0.ge]

/-! ## Theorem 53(c) — the calibration reading, conditional -/

/-- **Theorem 53(c) [M41] — the conditional pinning.**  *If* the corrected law
holds at `τ*` (equivalently, if the parameter point lies on the locus of (b)),
then with `MevTaxGate.Theorem54a_gate_derivative_closed_form`'s explicit gate
derivative the behavioral slope is **pinned**:

`∂ν/∂τ_MEV|_{τ*} = -(1-φ_X)/((1-τ*)·γ_R(φ_X-φ̄)(1-u/α_R))`,

every quantity on the right protocol-known (`Θ_φ`, `γ_R`, `α_R`) or on-chain
observable (`φ_X`, the gate value `u` of `DOC` Theorem 1, `τ*`). -/
theorem Theorem53c_conditional_pinning (n : ℕ) (γ β α : ℕ → ℝ)
    (phibar σ alphaR gammaR betaR nu tau dnudtau : ℝ)
    (hR : 0 < alphaR) (hg : 0 < gammaR) (htau : tau ≠ 1)
    (hphi : phibar < feeLevel n γ β α phibar σ alphaR gammaR betaR nu)
    (hlaw : tau = 1 + (1 - feeLevel n γ β α phibar σ alphaR gammaR betaR nu) /
      (dphidnuBoxed n γ β α σ alphaR gammaR betaR nu * dnudtau)) :
    dnudtau = -(1 - feeLevel n γ β α phibar σ alphaR gammaR betaR nu) /
      ((1 - tau) * (gammaR * (feeLevel n γ β α phibar σ alphaR gammaR betaR nu - phibar)
        * (1 - gateFactor alphaR gammaR betaR nu / alphaR))) := by
  set phiX := feeLevel n γ β α phibar σ alphaR gammaR betaR nu with hphiX
  have hd : 0 < dphidnuBoxed n γ β α σ alphaR gammaR betaR nu :=
    (MevTaxGate.Theorem54b_first_guard_conjunct n γ β α phibar σ alphaR gammaR betaR nu
      hR hg).1.mpr ⟨hphi, MevTaxGate.gateFactor_lt_alphaR _ _ _ _ hR⟩
  have hclosed : dphidnuBoxed n γ β α σ alphaR gammaR betaR nu
      = gammaR * (phiX - phibar) * (1 - gateFactor alphaR gammaR betaR nu / alphaR) :=
    (MevTaxGate.Theorem54a_gate_derivative_closed_form n γ β α phibar σ alphaR gammaR betaR nu
      hR.ne').2.1
  have ht : (1:ℝ) - tau ≠ 0 := sub_ne_zero.mpr (Ne.symm htau)
  by_cases hdn : dnudtau = 0
  · rw [hdn] at hlaw
    simp at hlaw
    exact absurd hlaw htau
  · have hgne : dphidnuBoxed n γ β α σ alphaR gammaR betaR nu * dnudtau ≠ 0 :=
      mul_ne_zero hd.ne' hdn
    have hcore : (1 - phiX) + (1 - tau) *
        (dphidnuBoxed n γ β α σ alphaR gammaR betaR nu * dnudtau) = 0 :=
      (focCore_eq_zero_iff tau phiX
        (dphidnuBoxed n γ β α σ alphaR gammaR betaR nu * dnudtau) hgne).mpr hlaw
    rw [← hclosed]
    field_simp
    nlinarith [hcore]

/-- **Theorem 53(c) [M41] — and what dies under (iii).**  Under the loop reading
of (b) the pinning's hypothesis is **unsatisfiable**: there is no `τ` at which
the corrected law holds, so the pinned expression calibrates nothing.  The
pinning is a conditional whose antecedent is empty — it is *vacuous*, and this
module says so rather than reporting a calibration. -/
theorem Theorem53c_pinning_is_vacuous_under_the_loop
    (phiM phiXv : ℝ) (dnudphi dphiXdnu dphidtau : ℝ → ℝ)
    (hM : phiM < 1) (hX : phiXv < 1)
    (hnu : ∀ t, dnudphi t < 0) (hgate : ∀ t, 0 < dphiXdnu t)
    (hself : ∀ t, dphidtau t
      = (1 - phiM) * ((1 - phiXv) + (1 - t) * (dphiXdnu t * (dnudphi t * dphidtau t)))) :
    ∀ t < 1, t ≠ 1 + (1 - phiXv) / (dphiXdnu t * (dnudphi t * dphidtau t)) := by
  intro t ht
  exact (Theorem53b_generically_false phiM phiXv t (dnudphi t) (dphiXdnu t)
    (dnudphi t * dphidtau t) (dphidtau t) hM hX ht (hnu t) (hgate t) rfl (hself t)).2.2

/-! ## Theorem 53(d) — the ν-decomposition flag.  NOT RULED HERE. -/

/-- The **realized** per-event utilization as a block-type-weighted mixture of
`SRC` Theorem 36's arb response and a transactional leg (the complement event of
`MevTaxTransactional.Theorem48a_partition`, carrying `δ_transactional`):
`ν = w·ν_arb + (1-w)·ν_trans`. -/
noncomputable def nuRealized (w nuArb nuTrans : ℝ) : ℝ := w * nuArb + (1 - w) * nuTrans

/-- The realized slope of the mixture in the tax. -/
noncomputable def dnuRealizedDtau (w dnuArb dnuTrans : ℝ) : ℝ :=
  w * dnuArb + (1 - w) * dnuTrans

/-- **Theorem 53(d) [M41] — the flag is LOAD-BEARING; a further author ruling is
required.**  The three claims split as follows.

1. *(a) is insensitive to the reading.*  Its statement quantifies over the slope
   product `S` and mentions no `ν` at all.
2. *(b) and (c) are NOT insensitive.*  Under the arb-only reading (`w = 1`, `ν`
   loop-generated by the composed fee) the FOC core is strictly positive and
   there is no root — `Theorem53b_generically_false`.  Under a block-type
   weighted reading with an **exogenous** transactional leg (`w < 1`,
   `∂ν_trans/∂τ_MEV` supplied by the transactional channel and not by the fee
   loop) a root exists: at `φ_M = 0`, `φ_X = 1/2`, `τ = 1/3`, `∂φ_X/∂ν = 1`,
   `w = 1/2`, `∂ν/∂φ = -1`, `∂ν_trans/∂τ_MEV = -3/2`, the self-consistency
   equation *and* the FOC hold simultaneously.

So the verdict of (b) — (ii) versus (iii) — is decided by the `ν`-decomposition
and by nothing else.  **This module does not rule.**  The ruling required is:
does Rule 13's gate argument `ν(t)` read the arb leg only (`SRC` Theorem 36), or
the realized block-type-weighted utilization of the extended model?  Until it is
made, (b) has two answers and (c) is vacuous under one of them. -/
theorem Theorem53d_readings_disagree :
    (∀ phiXv tau S : ℝ, tau ≠ 1 → S ≠ 0 →
        (tau = 1 + (1 - phiXv) / S ↔ S = -(1 - phiXv) / (1 - tau)))
      ∧ (∃ (phiM phiXv tau dphiXdnu w dnudphi dnuTrans dphidtau : ℝ),
          phiM < 1 ∧ phiXv < 1 ∧ tau < 1 ∧ 0 < dphiXdnu ∧ dnudphi < 0 ∧
            0 < w ∧ w < 1 ∧ dnuTrans < 0 ∧
            dphidtau = (1 - phiM) * ((1 - phiXv) + (1 - tau) *
                (dphiXdnu * dnuRealizedDtau w (dnudphi * dphidtau) dnuTrans)) ∧
            focCore tau phiXv dphiXdnu
              (dnuRealizedDtau w (dnudphi * dphidtau) dnuTrans) = 0) := by
  constructor
  · intro phiXv tau S htau hS
    have ht : (1:ℝ) - tau ≠ 0 := sub_ne_zero.mpr (Ne.symm htau)
    constructor
    · intro h; field_simp at h ⊢; nlinarith [h]
    · intro h
      have hXne : (1:ℝ) - phiXv ≠ 0 := by
        intro h0
        apply hS
        rw [h, h0]; simp
      have hkey : (1 - phiXv) / (-(1 - phiXv) / (1 - tau)) = -(1 - tau) := by
        field_simp
      rw [h, hkey]; ring
  · refine ⟨0, 1/2, 1/3, 1, 1/2, -1, -3/2, 0, by norm_num, by norm_num, by norm_num,
      by norm_num, by norm_num, by norm_num, by norm_num, by norm_num, ?_, ?_⟩
    · rw [dnuRealizedDtau]; norm_num
    · rw [focCore, dnuRealizedDtau]; norm_num

end MevTaxEquating
