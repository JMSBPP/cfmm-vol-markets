# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs (ignore everything except the superpowers spec/plan subtree)
docs/*
!docs/superpowers/

# Dotenv file
.env

# GAMS generated artifacts under model/ (listings, save/work files, scratch)
model/**/*.lst
model/**/*.g00
model/**/*.lxi
model/**/*.gdx
model/225*/
model/build/

# Plank compiled bytecode (make compile-plank)
/build/plank/

# Node / embedded reference apps
node_modules/

# Untracked NON-submodule lib/ trees — unpublished IP, never publish.
# The 8 real submodules in .gitmodules are unaffected by these path-anchored ignores.
/lib/mochi-yield/
/lib/shizo/
/lib/unistrata/
/lib/v4-core/

# Python caches
__pycache__/
*.pyc

# gamsdiff: transient all-symbols GDX from the price-impact driver run
model/price_impact_all.gdx

scratch/

model/**/build/

# forge script deploy artifacts (local anvil runs)
broadcast/

# Phase 20 rig: per-deploy addresses, regenerated by offchain/rig/deploy-rig.sh
offchain/rig/rig-manifest.json

# Haskell build output -- created by the `cabal build` / `cabal test` steps that
# offchain/rig/README.md documents, so it must never be left untracked for a reader
# following that sequence to accidentally commit.
dist-newstyle/
.stack-work/

# Local Claude Code settings (per-user, not repo config)
.agents/settings.local.json
.spec/
